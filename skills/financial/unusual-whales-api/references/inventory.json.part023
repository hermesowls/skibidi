      "operation": {
        "callbacks": {},
        "description": "Returns all annual disclosure file records for politicians.\nCan be filtered by politician_id and/or limited to latest per politician.\n\nThis is an enterprise only endpoint. Contact dev@unusualwhales.com for details about accessing this data.\n",
        "operationId": "PublicApi.PoliticianPortfoliosController.disclosures",
        "parameters": [
          {
            "description": "Filter by politician ID",
            "in": "query",
            "name": "politician_id",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "If true, returns only the most recent disclosure per politician",
            "in": "query",
            "name": "latest_only",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Filter by disclosure year",
            "in": "query",
            "name": "year",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "data": [
                      {
                        "chamber": "house",
                        "disclosure_year": 2024,
                        "filing_date": "2024-05-15",
                        "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                        "name": "Warren Davidson",
                        "politician_id": "e138f347-ae92-4cfb-8f41-7036ff09a213",
                        "politician_name": "Warren Davidson",
                        "url": "https://disclosures-clerk.house.gov/public_disc/financial-pdfs/2024/10067467.pdf",
                        "version": 1
                      }
                    ]
                  },
                  "properties": {
                    "data": {
                      "items": {
                        "properties": {
                          "chamber": {
                            "description": "The chamber (house, senate, executive).",
                            "enum": [
                              "house",
                              "senate",
                              "executive"
                            ],
                            "type": "string"
                          },
                          "disclosure_year": {
                            "description": "The year covered by the disclosure.",
                            "type": "integer"
                          },
                          "filing_date": {
                            "description": "The date the disclosure was filed.",
                            "format": "date",
                            "type": "string"
                          },
                          "id": {
                            "description": "The file record ID.",
                            "format": "uuid",
                            "type": "string"
                          },
                          "name": {
                            "description": "The filer name as it appears on the disclosure.",
                            "type": "string"
                          },
                          "politician_id": {
                            "description": "The politician's ID.",
                            "format": "uuid",
                            "type": "string"
                          },
                          "politician_name": {
                            "description": "The politician's name.",
                            "type": "string"
                          },
                          "url": {
                            "description": "The URL to the disclosure PDF.",
                            "type": "string"
                          },
                          "version": {
                            "description": "The version number of the disclosure.",
                            "type": "integer"
                          }
                        },
                        "title": "Annual Disclosure",
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "title": "Annual Disclosures List",
                  "type": "object"
                }
              }
            },
            "description": "Annual Disclosures"
          },
