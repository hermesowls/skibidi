      "operation": {
        "callbacks": {},
        "description": "Returns the current universe of underlying symbols that have listed options (sourced from the Nasdaq\noption-root locators), sorted alphabetically. Query this daily to track new listings and delistings.\n\nPass `?ticker=SYMBOL` to check a single company instead — the response then reports whether that\nsymbol currently has listed options.\n\nNOTICE: Access to this endpoint is only included in the Advanced API subscription.\n",
        "operationId": "PublicApi.OptionTradeController.optionable_tickers",
        "parameters": [
          {
            "description": "Optional: check a single symbol instead of listing the whole universe.",
            "in": "query",
            "name": "ticker",
            "required": false,
            "schema": {
              "description": "A comma separated list of tickers. To exclude certain tickers prefix the first ticker with a `-`.",
              "example": "AAPL,INTC",
              "title": "Ticker",
              "type": "string"
            }
          }
        ],
        "responses": {
