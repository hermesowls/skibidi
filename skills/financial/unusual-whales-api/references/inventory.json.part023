              "application/json": {
                "schema": {
                  "description": "Without a `ticker` query param, `data` is an alphabetically sorted array of every underlying symbol\nthat currently has listed options.\n\nWith `?ticker=SYMBOL`, `data` is instead an object `{ \"ticker\": ..., \"has_options\": true|false }`\nreporting whether that one symbol has listed options.\n",
                  "example": {
                    "data": [
