T /api/option-trades/multi-leg/{id}/legs",
      "method": "GET",
      "path": "/api/option-trades/multi-leg/{id}/legs",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the individual option legs that make up a single multi-leg strategy, aggregated by contract with\nsize-weighted greeks and prices. Pass the strategy `id` returned by the Multi-Leg Option Trades feed.\n",
        "operationId": "PublicApi.MultiLegController.legs",
        "parameters": [
          {
            "description": "The multi-leg strategy id (UUID) from the trades feed.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "description": "A single leg of a multi-leg strategy, aggregated by option contract. Greeks and prices are size-weighted averages; decimals are returned as strings.",
                        "properties": {
                          "delta": {
                            "description": "Size-weighted delta.",
                            "nullable": true,
                            "type": "string"
                          },
                          "expiry": {
                            "description": "Expiration date (YYYY-MM-DD).",
                            "type": "string"
                          },
                          "gamma": {
                            "description": "Size-weighted gamma.",
                            "nullable": true,
                            "type": "string"
                          },
                          "implied_volatility": {
                            "description": "Size-weighted implied volatility across the constituent fills.",
                            "nullable": true,
                            "type": "string"
                          },
                          "nbbo_ask": {
                            "description": "Size-weighted NBBO ask.",
                            "nullable": true,
                            "type": "string"
                          },
                          "nbbo_bid": {
                            "description": "Size-weighted NBBO bid.",
                            "nullable": true,
                            "type": "string"
                          },
                          "open_interest": {
                            "description": "Contract open interest.",
                            "nullable": true,
                            "type": "integer"
                          },
                          "option_symbol": {
                            "description": "OCC option symbol.",
                            "example": "AAPL260918C00250000",
                            "type": "string"
                          },
                          "option_symbol_id": {
                            "description": "Internal option symbol id.",
                            "type": "integer"
                          },
                          "premium": {
                            "description": "Total premium for this leg.",
                            "nullable": true,
                            "type": "string"
                          },
                          "price": {
                            "description": "Size-weighted fill price.",
                            "nullable": true,
                            "type": "string"
                          },
                          "side": {
                            "description": "Dominant aggressor side for this leg: bid or ask.",
                            "type": "string"
                          },
                          "size": {
                            "description": "Total contracts for this leg.",
                            "type": "integer"
                          },
                          "strike": {
                            "description": "Strike price.",
                            "type": "string"
                          },
                          "theta": {
                            "description": "Size-weighted theta.",
                            "nullable": true,
                            "type": "string"
                          },
                          "type": {
                            "description": "call or put.",
                            "type": "string"
                          },
                          "vega": {
                            "description": "Size-weighted vega.",
                            "nullable": true,
                            "type": "string"
                          },
                          "volume": {
                            "description": "Contract day volume.",
                            "nullable": true,
                            "type": "integer"
                          }
                        },
                        "title": "Multi-Leg Leg",
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "title": "Multi-Leg Legs Response",
                  "type": "object"
                }
              }
            },
            "description": "Multi-Leg Legs"
          },
