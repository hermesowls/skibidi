    {
      "key": "GET /api/option-trades/exchange-breakdown/{date}",
      "method": "GET",
      "path": "/api/option-trades/exchange-breakdown/{date}",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Aggregates the option tape for one or more tickers on a single trading date, grouped by the\n**options exchange** the prints executed on (e.g. `AMXO`, `ARCO`, `BATO`).\n\nFor each ticker × exchange you get the trade count, total contracts, total premium\n(`sum(price × size × 100)`) and the call/put trade split. Set `by_trade_code=true` to additionally\nbreak each row down by the upstream trade condition code (`upstream_condition_detail`, e.g. `auto`,\n`mlat`, `slan`).\n\nUse `min_premium` to drop smaller prints before aggregating.\n\n**Whole-universe mode:** omit `ticker[]` to get the breakdown across the entire option universe.\nIn that mode tickers are ranked by total contracts traded that day (descending) and the response is\npaged by ticker via `limit` (tickers per page) and `page` — so you receive the top names first. When\n`ticker[]` is supplied this paging is ignored and exactly those tickers are returned.\n\nNOTICE: Access to this endpoint is only included in the Advanced API subscription. Data is available\nfor trading days after 2022-01-01.\n",
        "operationId": "PublicApi.OptionTradeController.exchange_breakdown",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "date",
            "required": true,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\n",
              "example": "2024-01-18",
              "format": "date",
              "title": "Market Date",
              "type": "string"
            }
          },
          {
            "description": "One or more underlying symbols to aggregate, e.g. `ticker[]=AAPL&ticker[]=NVDA`. Omit for whole-universe mode (top names by volume).",
            "in": "query",
            "name": "ticker[]",
            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "Whether to additionally group each row by the upstream trade condition code.",
            "example": true,
            "in": "query",
            "name": "by_trade_code",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Only include individual prints whose premium (price × size × 100) is at least this value, before aggregating. Use to filter out smaller trades.",
            "example": "10000",
            "in": "query",
            "name": "min_premium",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Whole-universe mode only: tickers per page (ranked by volume). Default 100, max 500.",
            "example": 100,
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Whole-universe mode only: 1-based page of tickers. Default 1.",
