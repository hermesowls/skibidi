                     "properties": {
                          "ask_vol": {
                            "description": "The amount of volume that happened on the ask side.\n\nAsk side is defined as (ask + bid) / 2 < fill price.\n",
                            "example": 119403,
                            "title": "Option Contract Ask Volume",
                            "type": "integer"
                          },
                          "bid_vol": {
                            "description": "The amount of volume that happened on the bid side.\n\nBid side is defined as (ask + bid) / 2 > fill price.\n",
                            "example": 122789,
                            "title": "Option Contract Bid Volume",
                            "type": "integer"
                          },
                          "canceled": {
                            "description": "Whether the option trade was canceled.",
                            "example": false,
                            "title": "Canceled",
                            "type": "boolean"
                          },
                          "delta": {
                            "description": "The delta of the option trade.",
                            "example": "0.610546281537814",
                            "title": "Delta",
                            "type": "string"
                          },
                          "er_time": {
                            "description": "The time when the earnings will be released.",
                            "enum": [
                              "unknown",
                              "afterhours",
                              "premarket"
                            ],
                            "example": "premarket",
                            "title": "Stock Earnings time",
                            "type": "string"
                          },
                          "ewma_nbbo_ask": {
                            "description": "The exponentially weighted moving average of the National Best Bid and Offer ask side.",
                            "example": "21.60",
                            "title": "EWMA NBBO Ask",
                            "type": "string"
                          },
                          "ewma_nbbo_bid": {
                            "description": "The exponentially weighted moving average of the National Best Bid and Offer bid side.",
                            "example": "21.45",
                            "title": "EWMA NBBO Bid",
                            "type": "string"
                          },
                          "exchange": {
                            "description": "The exchange the option trade was executed on.",
                            "example": "MXOP",
                            "title": "Exchange",
                            "type": "string"
                          },
                          "executed_at": {
                            "description": "The option trade execution time as an ISO 8601 UTC timestamp. The WebSocket `option_trades` channel represents this field as Unix epoch milliseconds instead.",
                            "example": "2024-08-21 13:50:52.278302+00:00",
                            "format": "date-time",
                            "title": "Executed At",
                            "type": "string"
                          },
                          "expiry": {
                            "description": "The contract expiry date in ISO format.",
                            "example": "2023-12-22",
                            "title": "Option Contract Expiry",
                            "type": "string"
                          },
                          "flow_alert_id": {
                            "description": "The flow alert ID of the option trade.\n\nIf the flow alert ID is null, it means that there is no flow alert associated with the option trade.\n",
                            "title": "Flow Alert ID",
                            "type": "string"
                          },
                          "full_name": {
                            "description": "Full name of the ticker.",
                            "example": "APPLE",
                            "title": "Stock Full Name",
                            "type": "string"
                          },
                          "gamma": {
                            "description": "The gamma of the option trade.",
                            "example": "0.00775013889662635",
                            "title": "Gamma",
                            "type": "string"
                          },
                          "id": {
                            "description": "The ID of the option trade.",
                            "example": "8ef90a2d-d881-41de-98c9-c1de4318dcb5",
                            "title": "Option Trade ID",
                            "type": "string"
                          },
                          "implied_volatility": {
                            "description": "The implied volatility of the option trade.",
                            "example": "0.604347250962543",
                            "title": "Implied Volatility",
                            "type": "string"
                          },
                          "industry_type": {
                            "description": "The industry type of the ticker.",
                            "example": "Semiconductors",
                            "title": "Stock Industry Type",
                            "type": "string"
                          },
                          "is_agg": {
                            "description": "Whether this response item combines related option transactions executed at the same time into a single transaction.",
                            "example": true,
                            "type": "boolean"
                          },
                          "issue_type": {
                            "example": "Common Stock",
                            "nullable": true,
                            "type": "string"
                          },
                          "marketcap": {
                            "description": "The marketcap of the underlying ticker. If the issue type of the ticker is ETF then the marketcap represents the AUM.",
                            "example": "2965813810400",
                            "title": "Stock Marketcap AUM",
                            "type": "string"
                          },
                          "mid_vol": {
                            "description": "The amount of volume that happened in the middle of the ask and bid.\n\nMid is defined as (ask + bid) / 2 == fill price.\n",
                            "example": 22707,
                            "title": "Option Contract Mid Volume",
                            "type": "integer"
                          },
                          "multi_vol": {
