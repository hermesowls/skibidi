          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "A single ticker × exchange (× trade code, when `by_trade_code=true`) aggregation of the option\ntape for a trading date.\n",
                  "example": {
                    "data": [
                      {
                        "call_trades": 3370,
                        "contracts": 38633,
                        "exchange": "AMXO",
                        "premium": 5454330,
                        "put_trades": 3434,
                        "trade_code": "slan",
                        "trade_count": 6804,
                        "underlying_symbol": "AAPL"
                      }
                    ]
                  },
                  "properties": {
                    "call_trades": {
                      "description": "The number of call prints in this group.",
                      "example": 3370,
                      "type": "integer"
                    },
                    "contracts": {
                      "description": "The total number of contracts traded in this group.",
                      "example": 38633,
                      "type": "integer"
                    },
                    "exchange": {
                      "description": "The exchange the option trade was executed on.",
                      "example": "MXOP",
                      "title": "Exchange",
                      "type": "string"
                    },
                    "premium": {
                      "description": "The total premium of this group, computed as sum(price × size × 100).",
                      "example": 5454330,
                      "type": "number"
                    },
                    "put_trades": {
                      "description": "The number of put prints in this group.",
                      "example": 3434,
                      "type": "integer"
                    },
                    "trade_code": {
                      "description": "The upstream condition detail/trade code of the option trade.",
                      "example": "auto",
                      "title": "Upstream Condition Detail",
                      "type": "string"
                    },
                    "trade_count": {
                      "description": "The number of option prints in this group.",
                      "example": 6804,
                      "type": "integer"
                    },
                    "underlying_symbol": {
                      "description": "The underlying symbol of the contract.",
                      "example": "AAPL",
                      "title": "Option Contract Underlying Symbol",
                      "type": "string"
                    }
                  },
                  "title": "Option Trade Exchange Breakdown",
                  "type": "object"
                }
              }
            },
            "description": ""
