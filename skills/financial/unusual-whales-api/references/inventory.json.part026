    {
      "key": "GET /api/potus/schedule",
      "method": "GET",
      "path": "/api/potus/schedule",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the President's public schedule for a given date, newest first by start time.\n\nIf no `date` is provided, returns entries for the most recent scheduled date.\nSupports pagination via `limit` and `page` (page is 0-indexed).\n",
        "operationId": "PublicApi.PotusController.schedule",
        "parameters": [
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A date in the format of YYYY-MM-DD.\nThis is optional and by default returns the most recent scheduled date.\n",
              "example": "2026-07-09",
              "title": "Optional POTUS Schedule Date",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 200,
              "description": "How many items to return. Default: 200. Max: 200. Min: 1.",
              "example": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Default 200 Max 200 Min 1",
              "type": "integer"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "description": "Page number (use with limit). Starts on page 0.",
              "example": 1,
              "title": "Page",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "An entry from the President's public schedule.",
                  "example": {
                    "data": [
                      {
                        "coverage": "Closed Press",
                        "date": "2026-07-09",
                        "details": "The President participates in a Policy Meeting",
                        "location": "Oval Office",
                        "time": "2026-07-09 21:00:00+00:00",
                        "type": "President Schedule",
                        "url": null,
                        "video_url": null
                      }
                    ]
                  },
                  "properties": {
                    "coverage": {
                      "description": "The press coverage designation for the event.",
                      "example": "Closed Press",
                      "nullable": true,
                      "type": "string"
                    },
                    "date": {
                      "description": "The calendar date of the entry in YYYY-MM-DD format.",
                      "example": "2026-07-09",
                      "type": "string"
                    },
                    "details": {
                      "description": "A human-readable description of the event.",
                      "example": "The President participates in a Policy Meeting",
                      "nullable": true,
                      "type": "string"
                    },
                    "location": {
                      "description": "Where the event takes place.",
                      "example": "Oval Office",
                      "nullable": true,
                      "type": "string"
                    },
                    "time": {
                      "description": "The start time of the entry as an ISO 8601 UTC timestamp.",
                      "example": "2026-07-09 21:00:00+00:00",
                      "nullable": true,
                      "type": "string"
                    },
                    "type": {
                      "description": "The kind of schedule entry.",
                      "example": "President Schedule",
                      "type": "string"
