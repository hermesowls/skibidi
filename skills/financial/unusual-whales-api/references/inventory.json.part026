                "transaction_date",
                "low_value",
                "mid_value",
                "high_value"
              ],
              "example": "transaction_date",
              "title": "Congress trade order by field",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "order_direction",
            "required": false,
            "schema": {
              "default": "desc",
              "description": "Whether to sort descending or ascending. Descending by default.",
              "enum": [
                "desc",
                "asc"
              ],
              "example": "asc",
              "title": "OrderDirection",
              "type": "string"
            }
          }
        ],
