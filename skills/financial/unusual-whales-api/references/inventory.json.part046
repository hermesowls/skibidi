 usual candidate profile.\n",
        "operationId": "PublicApi.OptionContractController.option_stance",
        "parameters": [
          {
            "description": "Ticker symbol, e.g. RBLX.",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Trade stance to rank by.",
            "in": "query",
            "name": "stance",
            "required": true,
            "schema": {
              "enum": [
                "sell_premium",
                "sell_vega",
                "directional",
                "leaps",
                "cheapies"
              ],
              "type": "string"
            }
          },
          {
            "description": "Max contracts to return. Default 25, max 100.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Restrict to Calls or Puts.",
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "enum": [
                "Calls",
                "Puts"
              ],
              "type": "string"
            }
          },
          {
            "description": "Score a single specific contract (OCC option symbol, e.g. NVDA270115P00275000) instead of ranking the chain. `data` returns just that one scored contract.",
            "in": "query",
            "name": "option_symbol",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Optional historical date (YYYY-MM-DD).",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Descriptive, ranked contracts that fit a chosen trade stance. Not investment advice — see `disclaimer`.",
                  "properties": {
                    "as_of_date": {
                      "example": "2026-07-14",
                      "format": "date",
                      "type": "string"
                    },
                    "context": {
                      "properties": {
                        "iv_30d": {
                          "type": "number"
                        },
                        "iv_percentile": {
                          "description": "1-year IV percentile, 0–100.",
                          "type": "number"
                        },
                        "iv_rank": {
                          "description": "1-year IV rank, 0–100.",
                          "type": "number"
                        },
                        "stock_price": {
                          "type": "number"
                        }
                      },
                      "type": "object"
                    },
                    "data": {
                      "items": {
                        "properties": {
                          "avg_price": {
                            "type": "number"
                          },
                          "components": {
                            "description": "Named 0–1 sub-scores behind fit_score.",
                            "properties": {
                              "dte_fit": {
                                "type": "number"
                              },
                              "earnings_timing": {
                                "type": "number"
                              },
                              "greeks_fit": {
                                "type": "number"
                              },
                              "iv_regime": {
                                "type": "number"
                              },
                              "liquidity": {
                                "type": "number"
                              }
                            },
                            "type": "object"
                          },
                          "delta": {
                            "type": "number"
                          },
                          "dte": {
                            "type": "integer"
                          },
                          "earnings_before_expiry": {
                            "type": "boolean"
                          },
                          "expires": {
                            "format": "date",
                            "type": "string"
                          },
                          "explanation": {
                            "description": "Plain-language mechanics behind the fit — descriptive only.",
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "fit_score": {
                            "description": "Stance fit, 0–5. Descriptive, not a rating.",
                            "type": "number"
                          },
                          "gamma": {
                            "type": "number"
                          },
                          "iv": {
                            "type": "number"
                          },
                          "next_earnings_date": {
                            "format": "date",
                            "nullable": true,
                            "type": "string"
                          },
                          "open_interest": {
                            "type": "integer"
                          },
                          "option_symbol": {
                            "example": "RBLX260815C00070000",
                            "type": "string"
                          },
                          "option_type": {
                            "enum": [
                              "call",
                              "put"
                            ],
                            "type": "string"
                          },
                          "pop": {
                            "description": "Theoretical probability of finishing OTM ≈ 1−|Δ|.",
                            "type": "number"
                          },
                          "premium": {
                            "type": "number"
                          },
                          "rank_metric": {
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "value": {
                                "type": "number"
                              }
                            },
                            "type": "object"
                          },
                          "roc": {
                            "description": "Return on capital, when available.",
                            "type": "number"
                          },
                          "strike": {
                            "type": "number"
                          },
                          "theta": {
                            "type": "number"
                          },
                          "vega": {
                            "type": "number"
                          },
                          "volume": {
                            "type": "integer"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "disclaimer": {
                      "type": "string"
                    },
                    "stance": {
                      "example": "sell_premium",
                      "type": "string"
                    },
                    "ticker": {
                      "example": "RBLX",
                      "type": "string"
                    }
                  },
                  "title": "Option Trade-Stance Ranking response.",
                  "type": "object"
                }
              }
            },
            "description": ""
          },
