    {
      "key": "GET /api/stock/{ticker}/options-volume",
      "method": "GET",
      "path": "/api/stock/{ticker}/options-volume",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the options volume & premium for all trade executions\nthat happened on a given trading date for the given ticker.\n\n----\nThis can be used to build a ticker options overview such as:\n\n![Table](https://i.imgur.com/7FHyuqc.png)\n\n----\n\n![Line](https://i.imgur.com/UnVryDK.png)\n",
        "operationId": "PublicApi.TickerController.options_volume",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 1,
              "description": "How many items to return. Default: 1. Max: 500. Min: 1.",
              "example": 10,
              "maximum": 500,
              "minimum": 1,
              "title": "Default 1 Max 500 Min 1",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "",
