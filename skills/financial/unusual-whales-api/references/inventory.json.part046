      "operation": {
        "callbacks": {},
        "description": "Returns the total volume and open interest per expiry for the given ticker.\n",
        "operationId": "PublicApi.TickerController.vol_oi_per_expiry",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
