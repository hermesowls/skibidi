  {
    "description": "",
    "in": "query",
    "name": "limit",
    "required": false,
    "schema": {
      "default": 100,
      "description": "The limit of results. Default: 100. Max: 500. Min: 0.",
      "example": 125,
      "maximum": 500,
      "minimum": 0,
      "type": "integer"
    }
  },
  {
    "description": "",
    "in": "query",
    "name": "offset",
    "required": false,
    "schema": {
      "default": 0,
      "description": "The offset of results. Default: 0. Min: 0.",
      "example": 100,
      "minimum": 0,
      "type": "integer"
    }
  },
  {
    "description": "",
    "in": "query",
    "name": "min_market_date",
    "required": false,
    "schema": {
      "description": "A trading date in the format of YYYY-MM-DD.\n",
      "example": "2024-01-18",
      "format": "date",
