    "description": "",
    "in": "query",
    "name": "date",
    "required": false,
    "schema": {
      "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
      "example": "2024-01-18",
      "title": "Optional Market Date",
      "type": "string"
    }
  },
  {
    "description": "Max rows (default 50, max 500).",
    "in": "query",
    "name": "limit",
    "required": false,
    "schema": {
      "type": "integer"
    }
  }
]

```

