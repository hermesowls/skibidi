        ebitda:
          nullable: true
          type: number
        eps:
          nullable: true
          type: number
        exchange:
          nullable: true
          type: string
        industry:
          nullable: true
          type: string
        market_cap:
          nullable: true
          type: number
        name:
          example: Apple Inc
          type: string
        pe_ratio:
          nullable: true
          type: number
        peg_ratio:
          nullable: true
