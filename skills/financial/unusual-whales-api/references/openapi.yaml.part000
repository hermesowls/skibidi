    Configration_IDs:
      description: A list of alert ids to filter by.
      example:
        - ded2bee3-68fe-4aff-8316-f6ddbcf7ea67
        - c170e1cb-38c8-4cc9-91a0-e9b249ef7e00
      items:
        type: string
      title: Configration IDs
      type: array
    Congress_Member:
      default: Nancy Pelosi
      description: |
        The full name of a congress member. Cannot contain digits/numbers.
        Spaces and characters may need to be URI encoded, e.g. Adam Kinzinger -> Adam%20Kinzinger.
      example: Adam Kinzinger
      title: Congress Member
      type: string
    Congress_trade_order_by_field:
      default: filed_at_date
      description: The field to order the congress trades by. Defaults to filed_at_date.
      enum:
        - filed_at_date
        - transaction_date
        - low_value
        - mid_value
        - high_value
      example: transaction_date
      title: Congress trade order by field
      type: string
    Continent:
      description: ''
      example: North America
      title: Continent
      type: string
    Correlation:
      description: |
        A list of correlations
      example:
        data:
          - correlation: 0.27936797861890483
            fst: AAPL
            max_date: 2024-07-11
            min_date: 2023-07-11
            rows: 253
            snd: SPY
          - correlation: 0.279367978618901
            fst: SPY
            max_date: 2024-07-11
            min_date: 2023-07-11
            rows: 253
            snd: AAPL
      properties:
        correlation:
          $ref: '#/components/schemas/Correlation'
        fst:
          $ref: '#/components/schemas/Stock_Ticker'
        max_date:
          $ref: '#/components/schemas/General_ISO_Date'
        min_date:
          $ref: '#/components/schemas/General_ISO_Date'
        rows:
          $ref: '#/components/schemas/Count_of_data_points'
        snd:
          $ref: '#/components/schemas/Stock_Ticker'
      title: Correlation
      type: object
    Correlation_End_Date:
      description: |
        A date in the format of YYYY-MM-DD to end the correlation calculation.
        This is optional and defaults to the current date when start_date is provided.
        Works alongside start_date to define a specific time range.
        Can be used as an alternative to the interval parameter.
      example: 2023-12-31
      format: date
      title: Correlation End Date
      type: string
    Correlation_Start_Date:
      description: |
        A date in the format of YYYY-MM-DD to start the correlation calculation from.
        This is optional and works alongside end_date to define a specific time range.
        Can be used as an alternative to the interval parameter.
      example: 2023-01-01
      format: date
      title: Correlation Start Date
      type: string
    Count_of_data_points:
      description: The amount of data points considered.
      example: '100'
      title: Count of data points
      type: integer
    Country_Code:
      description: ''
      example: US
      title: Country Code
      type: string
    Country_Name:
      description: ''
      example: UNITED STATES
      title: Country Name
      type: string
    Country_and_Sector_exposure:
      description: ''
      example:
        country:
          - country: Ireland
            weight: '0.0164'
          - country: Other
