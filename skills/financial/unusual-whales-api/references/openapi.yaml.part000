    Create_alert_config_request:
      description: |
        Creates a new alert configuration, or updates an existing one when `id` is given.

        The alert filters can be given in one of two ways, but never both:
        - `config`: a structured filter object for the given `noti_type`. Fetch the available filter fields per alert type from `GET /api/alerts/filters`.
        - `input`: a DSL expression such as `add @energy where calls and volume > 100`. Fetch the DSL grammar from `GET /api/alerts/query/grammar`. The `noti_type` field is required for DSL expressions.
      example:
        input: add @energy where calls and volume > 100
        name: Energy call sweeps
        noti_type: flow_alerts
      oneOf:
        - required:
            - name
            - noti_type
            - config
        - required:
            - name
            - noti_type
            - input
      properties:
        config:
          $ref: '#/components/schemas/The_configuration_of_an_alert.'
        id:
          description: When given, updates the existing alert configuration with this id instead of creating a new one.
          format: uuid
          type: string
        input:
          description: A DSL expression describing the alert filters. Use instead of `config` for complex filter expressions. See the DSL grammar endpoint for the syntax.
          example: where calls and volume > 100 and premium > 10000
          type: string
        name:
          $ref: '#/components/schemas/The_name_of_the_alert'
        noti_type:
          $ref: '#/components/schemas/The_type_of_the_alert'
        status:
          $ref: '#/components/schemas/The_status_of_the_alert'
      title: Create alert config request
      type: object
    Created_alert_config:
      description: The created or updated alert configuration
      example:
        data:
          config:
            expression:
              op: and
              terms:
                - sectors:
                    - Energy
                - op: and
                  terms:
                    - is_call: true
                    - compare:
                        lhs:
                          field: volume
                        op: gt
                        rhs:
                          literal: '100'
            symbols: all
          created_at: 2025-07-01T14:00:00Z
          dsl: '@Energy where calls and volume > 100'
          id: ebe24953-a0bf-4b4d-98be-14f721a1199a
          name: Energy call sweeps
          noti_type: flow_alerts
          status: active
      properties:
        data:
          properties:
            config:
              $ref: '#/components/schemas/The_configuration_of_an_alert.'
            created_at:
              $ref: '#/components/schemas/The_creation_timestamp'
            dsl:
              description: The canonical DSL representation when the configuration was created or updated using `input`.
              type: string
            id:
              $ref: '#/components/schemas/The_alert_id'
            name:
              $ref: '#/components/schemas/The_name_of_the_alert'
            noti_type:
              $ref: '#/components/schemas/The_type_of_the_alert'
            status:
              $ref: '#/components/schemas/The_status_of_the_alert'
          type: object
      required:
        - data
      title: Created alert config
      type: object
