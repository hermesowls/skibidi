    Charm:
      description: ''
      example: '9.2'
      title: Charm
      type: string
    Company_Market_Cap:
      description: The company's market capitalization in USD
      example: '1000000000'
      nullable: true
      title: Company Market Cap
      type: string
    Company_Politics_Candidates:
      additionalProperties: true
      description: Federal candidates ranked by company-linked money received in a cycle. company_linked_total covers only contributions attributed to public companies, not the candidate's overall receipts.
      example:
        cycle: 2026
        data:
          - candidate_id: 18342
            company_count: 47
            company_linked_total: '412500.00'
            district: '09'
            employee_total_estimated: '14500.00'
            fec_candidate_id: H8MI09068
            incumbent_challenge: incumbent
            name: DOE, JANE A.
            office: house
            pac_total: '398000.00'
            party: REP
            politician_id: 1ccb3a38-6243-4c2f-bbcb-5986db785122
            politician_slug: jane-doe
            state: MI
        limit: 50
        page: 1
      title: Company Politics Candidates
      type: object
    Company_Politics_Companies:
      additionalProperties: true
      description: Public companies with tracked political activity for a cycle. PAC-tier totals come from confirmed corporate PAC mappings; employee-tier totals are estimates from self-reported donor employers and are kept separate.
      example:
        cycle: 2026
        data:
          - company_name: HONEYWELL INTERNATIONAL INC
            cycle: 2026
            employee_contribution_count: 12
            employee_dem_total: '3280.00'
            employee_rep_total: '0.00'
            employee_total_estimated: '3280.00'
            lobbying_total: '5230000.00'
            other_total: '7000.00'
            pac_contribution_count: 915
            pac_count: 1
            pac_dem_total: '821220.00'
            pac_rep_total: '953280.00'
            pac_total: '1781500.00'
            ticker: HON
        limit: 50
        page: 1
      title: Company Politics Companies
      type: object
    Company_Politics_Contribution_Rows:
      additionalProperties: true
      description: 'The aggregated=false response shape: individual contributions for one tier. Pass next_cursor back as cursor to fetch the following page; next_cursor is null on the final page.'
      example:
        aggregated: false
        data:
          - amount: '2500.00'
            candidate_id: 18342
            candidate_name: DOE, JANE A.
            committee_name: THE HOME DEPOT, INC. POLITICAL ACTION COMMITTEE
            company_name: HOME DEPOT INC
            contribution_id: 218764531
            date: 2026-06-02
            party: REP
            pdf_url: https://docquery.fec.gov/cgi-bin/fecimg/?202607159876543210
            report_year: 2026
            ticker: HD
            tier: pac
        limit: 50
        next_cursor: MjAyNjoyMTg3NjQ1MzE
        tier: pac
      title: Company Politics Contribution Rows
      type: object
    Company_Politics_Contributions:
      additionalProperties: true
      description: With aggregated=true (default), rows are company x candidate x cycle x tier with offset paging. With aggregated=false, rows are individual contributions for one tier, keyset-paginated via next_cursor.
      example:
        aggregated: true
        data:
          - candidate_id: 18342
            candidate_name: DOE, JANE A.
            company_name: HOME DEPOT INC
            contribution_count: 4
            cycle: 2026
            first_date: 2025-03-14
            last_date: 2026-06-02
            office: house
            party: REP
            politician_id: 1ccb3a38-6243-4c2f-bbcb-5986db785122
            politician_slug: jane-doe
            state: MI
            ticker: HD
            tier: pac
            total: '12500.00'
        limit: 50
        page: 1
        totals:
          contribution_count: 513
          employee_total_estimated: '0'
          pac_total: '1611500.00'
          total: '1611500.00'
      title: Company Politics Contributions
      type: object
    Company_Politics_Lobbying:
      additionalProperties: true
      description: Quarterly lobbying spend from Senate LDA filings. in_house_expenses are self-reported totals from the company's own filings; outside_income is what hired lobbying firms reported earning from the company - two separate series, not summable without double counting.
      example:
        company_name: HOME DEPOT INC
        filings:
          - client_name: THE HOME DEPOT
            dt_posted: 2026-07-20T18:04:11Z
            expenses: '1140000.00'
            filing_period: second_quarter
            filing_type: Q2
            filing_uuid: f3a1c9d2-7b44-4e0e-9a1c-2f5d8b6e4a10
            filing_year: 2026
            income:
            registrant_name: THE HOME DEPOT
        limit: 50
        page: 1
        periods:
          - filings_count: 9
            in_house_expenses: '1140000.00'
            outside_income: '380000.00'
            quarter: 2
            top_issue_codes:
              - TAX
              - TRD
              - LBR
              - CPT
              - HCR
            year: 2026
          - filings_count: 8
            in_house_expenses: '1080000.00'
            outside_income: '350000.00'
            quarter: 1
            top_issue_codes:
              - TAX
              - TRD
              - LBR
            year: 2026
        ticker: HD
      title: Company Politics Lobbying
      type: object
    Company_Politics_People:
      additionalProperties: true
      description: 'The people around a public company: candidates funded by its PAC and employees, politicians who traded the stock, and company insiders.'
      example:
        candidates_funded:
          - candidate_id: 18342
            employee_total_estimated: '0'
            name: DOE, JANE A.
            office: house
            pac_total: '12500.00'
            party: REP
            politician_id: 1ccb3a38-6243-4c2f-bbcb-5986db785122
            politician_slug: jane-doe
            state: MI
            total: '12500.00'
        company_name: HOME DEPOT INC
        cycle: 2026
        insiders:
          - insider_id: 10343
            is_person: true
            name: DECKER EDWARD P
            slug: decker-edward-p
        politician_traders:
          - chamber: house
            last_filing_date: 2026-07-18
            name: John Smith
            party: Democrat
            politician_id: 8b1f6c1e-93cf-4f52-a2b0-06c83f11d1a1
            slug: john-smith
            trade_count: 14
        ticker: HD
      title: Company Politics People
      type: object
