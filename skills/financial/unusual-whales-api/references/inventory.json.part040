    {
      "key": "GET /api/stock/{ticker}/gex-levels",
      "method": "GET",
      "path": "/api/stock/{ticker}/gex-levels",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "The key gamma-exposure (GEX) price levels for a ticker on a given market date, derived from\nper-strike net gamma exposure evaluated relative to spot:\n\n- `call_wall`: strike above spot with the largest positive net gamma (resistance)\n- `put_wall`: strike below spot with the largest positive net gamma (support)\n- `gamma_magnet`: strike with the largest-magnitude net gamma (the strongest pin)\n- `gamma_flip`: interpolated price where net dealer gamma crosses zero (between the two\n  strikes).\n\nThe levels are built from **directionalized volume** by default. This is the exposure dealers took on from\nthe day's ask/bid sided flow, updated through the session. Pass `source` to derive them from another\nbasis instead:\n\n- `vol`: directionalized volume (default)\n- `oi`: open interest\n\n`nearby_flips` lists every zero-gamma crossing near spot, ordered by distance from it and capped at\nfive, with `gamma_flip` as its first entry. On chains with many strikes the crossings often cluster\nwithin a dollar or two, which means no single level is decisive. The list makes that visible.\n\nThe response echoes the `source` used, along with `date`, the market date the levels describe, and\n`time`, when the exposure snapshot behind them was calculated.\n\nAny level may be `null` when there is no data for the date (or, for `gamma_flip`, when net gamma\ndoes not change sign across the strike range).\n\nTo determine the gamma regime, use the sign of net gamma from\n`/api/stock/{ticker}/greek-exposure` (`call_gamma + put_gamma`). Positive net gamma means price is\nabove the flip and hedging tends to dampen volatility. Negative net gamma means price is below the flip\nand hedging tends to amplify volatility. `gamma_flip` is a cumulative zero-crossing that can be `null`\nor far from spot, so do not use it for regime detection.\n",
        "operationId": "PublicApi.TickerController.gex_levels",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "default": "vol",
              "description": "Which exposure basis to derive the levels from. `vol` is directionalized volume — the exposure dealers took on from the day's ask/bid sided flow. `oi` is open interest.",
              "enum": [
                "vol",
                "oi"
              ],
              "example": "vol",
              "title": "GEX Source",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Key gamma-exposure price levels for a market date, derived from directionalized volume by default.\nEach level is a price as a decimal string, or null when unavailable for the date.\n",
                  "example": {
                    "data": {
                      "call_wall": "600",
                      "date": "2026-08-20",
                      "gamma_flip": "560",
                      "gamma_magnet": "575",
                      "nearby_flips": [
                        "560",
                        "561.5",
                        "572"
                      ],
                      "put_wall": "550",
                      "source": "vol",
                      "time": "2026-08-20 13:35:11.482000+00:00"
                    }
                  },
                  "properties": {
                    "call_wall": {
                      "description": "Strike above spot with the largest positive net gamma exposure (resistance).",
                      "example": "600",
                      "nullable": true,
                      "title": "Call Wall",
                      "type": "string"
                    },
                    "date": {
                      "description": "A trading date in ISO format.\n",
                      "example": "2023-09-08",
                      "title": "Market General Trading day",
                      "type": "string"
                    },
                    "gamma_flip": {
                      "description": "Price where net dealer gamma crosses zero, nearest to spot — the zero-gamma level.",
                      "example": "560",
                      "nullable": true,
                      "title": "Gamma Flip",
                      "type": "string"
                    },
                    "gamma_magnet": {
                      "description": "Strike with the largest-magnitude net gamma (the strongest pin).",
                      "example": "575",
                      "nullable": true,
                      "title": "Gamma Magnet",
                      "type": "string"
                    },
                    "nearby_flips": {
                      "description": "Every zero-gamma crossing near spot, ordered by distance from it and capped at five.",
                      "example": [
                        "560",
                        "561.5",
                        "572"
                      ],
                      "items": {
                        "example": "560",
                        "type": "string"
                      },
                      "title": "Nearby Gamma Flips",
                      "type": "array"
                    },
                    "put_wall": {
                      "description": "Strike below spot with the largest positive net gamma exposure (support).",
                      "example": "550",
                      "nullable": true,
                      "title": "Put Wall",
                      "type": "string"
                    },
                    "source": {
                      "default": "vol",
                      "description": "Which exposure basis to derive the levels from. `vol` is directionalized volume — the exposure dealers took on from the day's ask/bid sided flow. `oi` is open interest.",
                      "enum": [
                        "vol",
                        "oi"
                      ],
                      "example": "vol",
                      "title": "GEX Source",
                      "type": "string"
                    },
                    "time": {
                      "description": "The UTC timestamp of the calculation",
                      "example": "2023-12-13 05:00:41.481000+00:00",
                      "title": "Gex Calculation Time",
                      "type": "string"
                    }
                  },
                  "title": "GEX Levels",
                  "type": "object"
                }
              }
            },
            "description": ""
          },
          "401": {
