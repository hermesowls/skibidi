    {
      "key": "GET /api/stock/{ticker}/fundamental-breakdown",
      "method": "GET",
      "path": "/api/stock/{ticker}/fundamental-breakdown",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the fundamental financial data for the given ticker, including earnings per share,\nrevenue, dividends, share counts, RSU data, and revenue breakdowns by product and geography.\n",
        "operationId": "PublicApi.FundamentalController.show",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "properties": {
                        "annual_only": {
                          "description": "True when every report in `general` is an annual filing.",
                          "example": true,
                          "type": "boolean"
                        },
                        "general": {
                          "items": {
                            "description": "One financial report / period. Monetary and per-share figures are numeric strings, null when not reported.",
