              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "order_direction",
            "required": false,
            "schema": {
              "default": "desc",
              "description": "Whether to sort descending or ascending. Descending by default.",
              "enum": [
                "desc",
                "asc"
              ],
              "example": "asc",
              "title": "OrderDirection",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 500,
              "description": "How many items to return. Default: 500. Max: 500. Min: 1.",
              "example": 10,
              "maximum": 500,
              "minimum": 1,
              "title": "Default 500 Max 500 Min 1",
              "type": "integer"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "description": "Page number (use with limit). Starts on page 0.",
              "example": 1,
              "title": "Page",
              "type": "integer"
            }
          }
        ],
