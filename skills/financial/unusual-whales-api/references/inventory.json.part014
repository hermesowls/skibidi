    {
      "key": "GET /api/institution/{ticker}/ownership",
      "method": "GET",
      "path": "/api/institution/{ticker}/ownership",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "The institutional ownership of a given ticker.\n\nIf you are looking to build a database of insitutional positions use https://unusualwhales.com/skills/institutional.md\n",
        "operationId": "PublicApi.InstitutionController.ownership",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A comma separated list of tickers. To exclude certain tickers prefix the first ticker with a `-`.",
              "example": "AAPL,INTC",
              "title": "Ticker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "The report date in the format of YYYY-MM-DD.\n",
              "example": "2024-01-18",
              "format": "date",
              "title": "Report Date",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "start_date",
            "required": false,
            "schema": {
              "description": "A date in the format of YYYY-MM-DD, only institutional holdings with `report_date` values on or after this date will be returned.\n",
              "example": "2023-01-01",
              "format": "date",
              "title": "Institutional Report Start Date",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "end_date",
            "required": false,
            "schema": {
              "description": "A date in the format of YYYY-MM-DD, only institutional holdings with `report_date` values on or before this date will be returned.\n",
              "example": "2023-03-31",
              "format": "date",
              "title": "Institutional Report End Date",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "tags[]",
            "required": false,
            "schema": {
              "description": "An array of institution tags",
              "example": [
                "activist"
              ],
              "items": {
                "description": "",
                "enum": [
                  "advisor",
                  "value_investor",
                  "brokerage",
                  "hedge_fund",
                  "private_fund",
                  "biotech",
                  "activist",
                  "top_fund",
                  "tiger_club",
                  "esg",
                  "credit",
                  "13d_activist",
                  "energy",
                  "small_cap",
                  "event",
                  "real_estate",
                  "technology",
                  "all",
                  "public_companies",
                  "known"
                ],
                "example": "activist",
                "title": "Institution Tag",
                "type": "string"
              },
              "title": "Institution Tags",
              "type": "array"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "description": "Optional columns to order the result by",
              "enum": [
                "name",
                "short_name",
                "filing_date",
                "first_buy",
                "units",
                "units_change",
                "units_changed",
                "value",
                "avg_price",
                "perc_outstanding",
                "perc_units_changed",
                "activity",
                "perc_inst_value",
                "perc_share_value"
              ],
              "example": "name",
              "title": "Institutional Ownership Order By",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "order_direction",
            "required": false,
            "schema": {
              "default": "desc",
              "description": "Whether to sort descending or ascending. Descending by default.",
              "enum": [
                "desc",
                "asc"
              ],
              "example": "asc",
              "title": "OrderDirection",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 500,
              "description": "How many items to return. Default: 500. Max: 500. Min: 1.",
              "example": 10,
              "maximum": 500,
              "minimum": 1,
              "title": "Default 500 Max 500 Min 1",
              "type": "integer"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "description": "Page number (use with limit). Starts on page 0.",
              "example": 1,
              "title": "Page",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "The institutional ownership of a given ticker.",
                  "example": {
                    "data": [
                      {
                        "avg_price": "432.31",
                        "filing_date": "2024-12-23",
                        "first_buy": "2021-02-25",
                        "historical_units": [
                          4103,
                          4423
                        ],
                        "inst_share_value": "582093953.0",
                        "inst_value": "1095205923.0",
                        "name": "VANGUARD GROUP INC",
                        "people": [
                          "John Doe"
                        ],
                        "report_date": "2024-09-30",
                        "shares_outstanding": "148239423.0",
                        "short_name": "Vanguard",
                        "tags": [
                          "value_investor"
                        ],
                        "units": 5000,
                        "units_change": -500,
                        "value": "2934823.0"
                      }
                    ]
                  },
                  "properties": {
                    "avg_price": {
                      "description": "",
                      "example": "23.49",
                      "title": "Avg Price",
                      "type": "string"
                    },
                    "filing_date": {
                      "description": "An ISO date.",
                      "example": "2024-01-09",
                      "title": "General ISO Date",
                      "type": "string"
                    },
                    "first_buy": {
                      "description": "An ISO date.",
                      "example": "2024-01-09",
                      "title": "General ISO Date",
                      "type": "string"
                    },
                    "historical_units": {
                      "description": "Historical unit counts. Maximum length = 8.",
                      "example": [
                        4103,
                        4423
                      ],
                      "items": {
                        "type": "integer"
                      },
                      "title": "Historical Units",
                      "type": "array"
                    },
                    "inst_share_value": {
                      "description": "The rounded total share value in the institution's portfolio.",
                      "example": "2394292.0",
                      "title": "Share Value",
                      "type": "string"
                    },
                    "inst_value": {
                      "description": "The rounded total value of the institution's portfolio.",
                      "example": "2394292.0",
                      "title": "Total Value",
                      "type": "string"
                    },
                    "name": {
                      "description": "The institution's name.",
                      "example": "VANGUARD GROUP INC",
                      "title": "Name",
                      "type": "string"
                    },
                    "people": {
                      "description": "Persons of interest in the institution.",
                      "example": [
                        "Paul Singer"
                      ],
                      "items": {
                        "type": "string"
                      },
                      "title": "People",
                      "type": "array"
                    },
                    "report_date": {
                      "description": "An ISO date.",
                      "example": "2024-01-09",
                      "title": "General ISO Date",
                      "type": "string"
                    },
                    "shares_outstanding": {
                      "description": "Total outstanding shares for the ticker.",
                      "example": "424295343.0",
                      "title": "Shares Outstanding",
                      "type": "string"
                    },
                    "short_name": {
                      "description": "The institution's short name.",
                      "example": "Vanguard",
                      "title": "Short Name",
                      "type": "string"
                    },
                    "tags": {
                      "description": "Tags related to the institution.",
                      "example": [
                        "activist",
                        "value_investor"
                      ],
                      "items": {
                        "type": "string"
                      },
                      "title": "Tags"
                    },
                    "units": {
                      "description": "",
                      "example": 4103,
                      "title": "Units",
                      "type": "integer"
                    },
                    "units_change": {
                      "description": "The change in units",
                      "example": -320,
                      "title": "Units Change",
                      "type": "integer"
                    },
                    "value": {
                      "description": "The rounded total value on the reporting date.",
                      "example": 2429329,
                      "title": "Value",
                      "type": "integer"
                    }
                  },
                  "title": "Institutional Ownership",
                  "type": "object"
                }
              }
            },
            "description": ""
          },
