    {
      "key": "GET /api/stock/{ticker}/ohlc/{candle_size}",
      "method": "GET",
      "path": "/api/stock/{ticker}/ohlc/{candle_size}",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the Open High Low Close (OHLC) candle data for a given ticker.\n\nResults are limited to 2,500 elements even if there are more available.\n\nRow order depends on `candle_size`: intraday candles are newest first, while daily candles are oldest\nfirst. The most recent intraday candle is still forming, and its `start_time` is the start of the current\nbucket. Select the latest bar by the maximum `start_time`, not by array position.\n\nNote: If you select 1d or 1w as a candle_size then the candles won't have a start & end time. For 1w, the `date` field is the Monday of the ISO week.\n\nNote: Suppose you enter end_date value 2024-11-25 which was a Monday. Your response will include 1-2 hours of data from Tuesday 2024-11-26 due to UTC date rollover.\nRest-assured, the response data covers the full trading day (based on Eastern time) according to your entered end_date.\n",
        "operationId": "PublicApi.TickerController.ohlc",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "path",
            "name": "candle_size",
            "required": true,
            "schema": {
              "enum": [
                "1m",
                "5m",
                "10m",
                "15m",
                "30m",
                "1h",
                "4h",
                "1d",
                "1w"
              ],
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "timeframe",
            "required": false,
            "schema": {
              "default": "1Y",
              "description": "The timeframe of the data to return.\nCan be one of the following formats:\n- YTD\n- 1D, 2D, etc.\n- 1W, 2W, etc.\n- 1M, 2M, etc.\n- 1Y, 2Y, etc.\n",
              "example": "2M",
              "title": "Time frame",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "end_date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\n\nThis is the end date for the given timeframe. If you set the timeframe to 1 minute ticks and have an end_date of 2024-01-18 then it\nwould start searching backwards from 2024-01-18\n",
              "example": "2024-01-18",
              "format": "date",
              "title": "OHLC End Date",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\n",
              "example": "2024-01-18",
              "format": "date",
              "title": "Market Date",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "description": "How many items to return. Max: 2500. Min: 1.",
              "example": 10,
              "maximum": 2500,
              "minimum": 1,
              "title": "Max 2500 Min 1",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "The candle data for the requested timeframe.",
                  "example": {
                    "data": [
                      {
                        "close": "56.79",
                        "end_time": "2023-09-07 20:11:00+00:00",
                        "high": "56.79",
                        "low": "56.79",
                        "market_time": "po",
                        "open": "56.79",
                        "start_time": "2023-09-07 20:10:00+00:00",
                        "total_volume": 13774488,
                        "volume": 29812
                      },
                      {
                        "close": "56.79",
                        "end_time": "2023-09-07 20:07:00+00:00",
                        "high": "56.79",
                        "low": "56.79",
                        "market_time": "po",
                        "open": "56.79",
                        "start_time": "2023-09-07 20:06:00+00:00",
                        "total_volume": 13744676,
                        "volume": 10699
                      }
                    ]
                  },
                  "properties": {
                    "close": {
                      "description": "The closing price of the candle.",
                      "example": "56.79",
                      "title": "Candle Close",
                      "type": "string"
                    },
                    "end_time": {
                      "description": "The end time of the candle as UTC timestamp.",
                      "example": "2023-09-07 20:07:00+00:00",
                      "title": "Candle End time",
                      "type": "string"
                    },
                    "high": {
                      "description": "The highest price of the candle.",
                      "example": "58.12",
                      "title": "Candle High",
                      "type": "string"
                    },
                    "low": {
                      "description": "The lowest price of the candle.",
                      "example": "51.90",
                      "title": "Candle Low",
                      "type": "string"
                    },
                    "market_time": {
                      "description": "The market time:\n- pr = premarket\n- r  = regular\n- po = postmarket\n",
                      "enum": [
                        "r",
                        "po",
                        "pr"
                      ],
                      "example": "pr",
                      "title": "Market General Market Time",
                      "type": "string"
                    },
                    "open": {
                      "description": "The opening price of the candle.",
                      "example": "54.29",
                      "title": "Candle Open",
                      "type": "string"
                    },
                    "start_time": {
                      "description": "The start time of the candle as UTC timestamp.",
                      "example": "2023-09-07 20:06:00+00:00",
                      "title": "Candle Start time",
                      "type": "string"
                    },
                    "total_volume": {
                      "description": "The total volume of the ticker for the full trading till now.",
                      "example": 13744676,
                      "title": "Candle Total volume",
                      "type": "integer"
                    },
                    "volume": {
                      "description": "The volume of the candle.",
                      "example": 10699,
                      "title": "Candle Volume",
                      "type": "integer"
                    }
                  },
                  "title": "Candle data",
                  "type": "object"
                }
              }
            },
            "description": "OHLC Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Returned with HTTP 401 when a request carries no API token, or carries one the API cannot use. The response also carries a `WWW-Authenticate` header with the `Bearer` challenge. Branch on `reason` rather than on `message`, whose wording can change.",
