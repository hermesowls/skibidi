    {
      "key": "GET /api/stock/{ticker}/net-prem-ticks",
      "method": "GET",
      "path": "/api/stock/{ticker}/net-prem-ticks",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the net premium ticks for a given ticker which can be used to build the following chart:\n![Net Prem chart](https://i.imgur.com/Rom1kcB.png)\n\n----\nEach tick is resembling the data for a single minute tick. To build a daily chart\nyou would have to add the previous data to the current tick:\n```javascript\nconst url =\n  'https://api.unusualwhales.com/api/stock/AAPL/net-prem-ticks';\nconst options = {\n  method: 'GET',\n  headers: {\n    Accept: 'application/json',\n    Authorization: 'Bearer YOUR_TOKEN'\n  }\n};\n\nfetch(url, options)\n.then(r => r.json())\n.then(r => {\n  const {data} = r.data;\n  const fieldsToSum = [\n    \"net_call_premium\",\n    \"net_call_volume\",\n    \"net_put_premium\",\n    \"net_put_volume\"\n  ];\n\n  let result = [];\n  data.forEach((e, idx) => {\n    e.net_call_premium = parseFloat(e.net_call_premium);\n    e.net_put_premium = parseFloat(e.net_put_premium);\n    if (idx !== 0) {\n      fieldsToSum.forEach((field) => {\n        e[field] = e[field] + result[idx-1][field];\n      })\n    }\n    result.push(e);\n  })\n\n  return result;\n});\n\n```\n",
        "operationId": "PublicApi.TickerController.net_prem_ticks",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "The net premium for each trading minute.",
                  "example": {
                    "data": [
                      {
                        "call_volume": 1145,
                        "call_volume_ask_side": 822,
                        "call_volume_bid_side": 182,
                        "date": "2025-03-21",
                        "net_call_premium": "2234.00",
                        "net_call_volume": 640,
                        "net_delta": "26294.85817964231814400",
                        "net_put_premium": "-11106.00",
                        "net_put_volume": -137,
                        "put_volume": 241,
                        "put_volume_ask_side": 49,
                        "put_volume_bid_side": 186,
                        "tape_time": "2025-03-21 19:58:00+00:00"
                      },
                      {
                        "call_volume": 1255,
                        "call_volume_ask_side": 912,
                        "call_volume_bid_side": 192,
                        "date": "2025-03-21",
                        "net_call_premium": "3234.00",
                        "net_call_volume": 720,
                        "net_delta": "28294.85817964231814400",
                        "net_put_premium": "-9106.00",
                        "net_put_volume": -127,
                        "put_volume": 231,
                        "put_volume_ask_side": 59,
                        "put_volume_bid_side": 166,
                        "tape_time": "2025-03-21 19:59:00+00:00"
                      }
                    ]
                  },
                  "properties": {
                    "call_volume": {
                      "description": "The sum of the size of all the call transactions that executed.",
                      "example": 990943,
                      "title": "Market General Call Volume",
                      "type": "integer"
                    },
                    "call_volume_ask_side": {
                      "description": "The sum of the size of all the call transactions that executed on the ask side.",
                      "example": 417251,
                      "title": "Market General Call Volume Ask Side",
                      "type": "integer"
                    },
                    "call_volume_bid_side": {
                      "description": "The sum of the size of all the call transactions that executed on the bid side.",
                      "example": 498271,
                      "title": "Market General Call Volume Bid Side",
                      "type": "integer"
                    },
                    "date": {
                      "description": "A trading date in ISO format.\n",
                      "example": "2023-09-08",
                      "title": "Market General Trading day",
                      "type": "string"
                    },
                    "net_call_premium": {
                      "description": "Defined as (call premium ask side) - (call premium bid side).",
                      "example": "-29138464",
                      "title": "Market General Net Call Premium",
                      "type": "string"
                    },
                    "net_call_volume": {
                      "description": "Defined as (call volume ask side) - (call volume bid side).",
                      "example": 1049,
                      "title": "Market General Net Call Volume",
                      "type": "integer"
                    },
                    "net_delta": {
                      "description": "Net delta",
                      "example": "26294.85",
                      "type": "string"
                    },
                    "net_put_premium": {
                      "description": "Defined as (put premium ask side) - (put premium bid side).",
                      "example": "23924325",
                      "title": "Market General Net Put Premium",
                      "type": "string"
                    },
                    "net_put_volume": {
                      "description": "Defined as (put volume ask side) - (put volume bid side).",
                      "example": 1313,
                      "title": "Market General Net Put Volume",
                      "type": "integer"
                    },
                    "put_volume": {
                      "description": "The sum of the size of all the put transactions that executed.",
                      "example": 808326,
                      "title": "Market General Put Volume",
                      "type": "integer"
                    },
                    "put_volume_ask_side": {
                      "description": "The sum of the size of all the put transactions that executed on the ask side.",
                      "example": 431791,
                      "title": "Market General Put Volume Ask Side",
                      "type": "integer"
                    },
                    "put_volume_bid_side": {
                      "description": "The sum of the size of all the put transactions that executed on the bid side.",
                      "example": 314160,
                      "title": "Market General Put Volume Bid Side",
                      "type": "integer"
                    },
                    "tape_time": {
                      "description": "The start time of the tick as a timestamp with timezone.",
                      "example": "2023-09-07 09:30:00-04:00",
                      "title": "General Tick time",
                      "type": "string"
                    }
                  },
                  "title": "Net Prem Tick response.",
                  "type": "object"
                }
              }
            },
            "description": ""
          },
