    {
      "key": "GET /api/stock/{ticker}/oi-change",
      "method": "GET",
      "path": "/api/stock/{ticker}/oi-change",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the tickers contracts' OI change data ordered by absolute OI change (default: descending).\nDate must be the current or a past date. If no date is given, returns data for the current/last market day.\n",
        "operationId": "PublicApi.TickerController.oi_change",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "description": "How many items to return. If no limit is given, returns all matching data. Min: 1.",
              "example": 10,
              "minimum": 1,
              "title": "Min Limit 1",
              "type": "integer"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "description": "Page number (use with limit). Starts on page 0.",
              "example": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "default": "desc",
              "description": "Whether to sort descending or ascending. Descending by default.",
              "enum": [
                "desc",
                "asc"
              ],
              "example": "asc",
              "title": "OrderDirection",
              "type": "string"
            }
          }
        ],
