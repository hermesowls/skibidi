    {
      "key": "GET /api/stock/{ticker}/nope",
      "method": "GET",
      "path": "/api/stock/{ticker}/nope",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the tickers NOPE for the given market day broken down per minute.\n\nNOPE is the Net Options Pricing Effect, which tracks the intraday net delta of any ticker, but most research has been done on indexes.\nIt functions under 2 assumptions:\n1) MM's take short side of any call or put traded during the day\n2) MM's try to minimize risk by dynamically hedging their delta-gamma exposure, and do so by buying/shorting the underlying stock in proportion to the total net delta being tradedBased on these assumptions, options trading in large amounts (re: very liquid tickers) can potentially drive the price of the underlying, to a certain extent. Large movements might exacerbate this real time hedging, and drive price movements further in respective directions.\n\nIn short, NOPE represents a best-estimate of expected number of shares to be hedged at any given time, and will show a general expected direction on the underlying\n\nThe original NOPE calculation was based on the following formula:\n`NOPE = (Call Delta - Put Delta) / Stock Volume`\nwhere call/put delta is obtained by multiplying each chains volume with its latest delta and then summing those values up.\n\n`NOPE fill` on the other hand is based on the delta at the time of the transaction\n\nDate must be the current or a past date. If no date is given, returns data for the current/last market day.\n",
        "operationId": "PublicApi.TickerController.nope",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "",
                  "example": {
                    "data": [
                      {
                        "call_delta": "-21257.36",
                        "call_fill_delta": "-28564.02",
                        "call_vol": 23421,
                        "nope": "-0.000648",
                        "nope_fill": "-0.000434",
                        "put_delta": "-43593.96",
                        "put_fill_delta": "-14947.51",
                        "put_vol": 23421,
                        "stock_vol": 100000,
                        "timestamp": "2024-10-28 18:46:00+00:00"
                      }
                    ]
                  },
                  "properties": {
                    "call_delta": {
                      "description": "The total call delta obtained by multiplying the volume of all call options with their latest delta.\n",
                      "example": "-21257.36",
                      "title": "Call Delta",
                      "type": "number"
                    },
                    "call_fill_delta": {
                      "description": "The total call delta obtained by summing up the size of each call trade multiplied by the delta at the time of the transaction.\n",
                      "example": "-21257.36",
                      "title": "Call Fill Delta",
                      "type": "number"
                    },
                    "call_vol": {
                      "description": "The cumulative total volume of call options traded.\n",
                      "example": 12348,
                      "title": "Call Volume",
                      "type": "integer"
                    },
                    "nope": {
                      "description": "The NOPE value based on call_delta & put_delta\n",
                      "example": "-0.000648",
                      "title": "Nope score",
                      "type": "number"
                    },
                    "nope_fill": {
                      "description": "The NOPE value based on call_fill_delta & put_fill_delta\n",
                      "example": "-0.000434",
                      "title": "Nope Fill",
                      "type": "number"
                    },
                    "put_delta": {
                      "description": "The total put delta obtained by multiplying the volume of all put options with their latest delta.\n",
                      "example": "-43593.96",
                      "title": "Put Delta",
                      "type": "number"
                    },
                    "put_fill_delta": {
                      "description": "The total put delta obtained by summing up the size of each put trade multiplied by the delta at the time of the transaction.\n",
                      "example": "-43593.96",
                      "title": "Put Fill Delta",
                      "type": "number"
                    },
                    "put_vol": {
                      "description": "The cumulative total volume of put options traded.\n",
                      "example": 12348,
                      "title": "Put Volume",
                      "type": "integer"
                    },
                    "stock_vol": {
                      "description": "The cumulative total volume of the underlying stock traded.\n",
                      "example": 12348,
                      "title": "Stock Volume",
                      "type": "integer"
                    },
                    "timestamp": {
                      "description": "The (start of minute) timestamp of the data.",
                      "example": "2024-10-28 18:46:00+00:00",
                      "format": "date-time",
                      "title": "Timestamp",
                      "type": "string"
                    }
                  },
                  "title": "Nope",
                  "type": "object"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Returned with HTTP 401 when a request carries no API token, or carries one the API cannot use. The response also carries a `WWW-Authenticate` header with the `Bearer` challenge. Branch on `reason` rather than on `message`, whose wording can change.",
                  "example": {
