    {
      "key": "GET /api/shorts/{ticker}/interest-float/v2",
      "method": "GET",
      "path": "/api/shorts/{ticker}/interest-float/v2",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns short interest, float size, days-to-cover, and related percentage calculations for a given ticker.\n\nBroker-dealers report short interest to FINRA twice per month then FINRA publishes the aggregated results approximately one week after each submission window closes. Because updates arrive on this fixed schedule, data in the response from this endpoint can lag the current date by several weeks. This is a FINRA reporting constraint, not a data delivery issue or bug.\n\nThis endpoint updates twice a month and pulls data from FINRA. The update schedule can be viewed on the FINRA website [here](https://www.finra.org/filing-reporting/regulatory-filing-systems/short-interest)\n",
        "operationId": "PublicApi.ShortController.short_interest_and_float_v2",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Short interest data and float information for percentage calculations for a specific ticker.\nThis endpoint provides information about the relationship between short interest and the float,\nincluding the percentage of the float that is shorted and the days to cover metric.\n",
                  "example": {
                    "data": {
                      "days_to_cover": "2.1",
                      "fee_rate": "0.2782",
                      "market_date": "2023-04-15",
                      "rebate_rate": "3.3518",
                      "short_interest": 75000,
                      "short_shares_available": 10000000,
                      "si_float": "0.017647058",
              