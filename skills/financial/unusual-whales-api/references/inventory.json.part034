                      "type": "integer"
                    },
                    "symbol": {
                      "description": "The ticker symbol.",
                      "type": "string"
                    },
                    "total_float_returned": {
                      "description": "The float (available shares for trading).",
                      "type": "integer"
                    }
                  },
                  "title": "V1 Short Interest and Float (Deprecated)",
                  "type": "object"
                }
              }
