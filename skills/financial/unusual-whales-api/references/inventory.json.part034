    {
      "key": "GET /api/shorts/{ticker}/data",
      "method": "GET",
      "path": "/api/shorts/{ticker}/data",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns short data including rebate rate and short shares available for a ticker.\n",
        "operationId": "PublicApi.ShortController.short_data",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
