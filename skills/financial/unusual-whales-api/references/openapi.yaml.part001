    Futures_Candles:
      description: OHLCV candles for a contract over the requested interval and range.
      properties:
        data:
          items:
            additionalProperties: true
            properties:
              c:
                description: Close
                type: string
              date:
                description: Trading date
                format: date
                type: string
              end:
                format: date-time
                type: string
              h:
                description: High
                type: string
              l:
                description: Low
                type: string
              o:
                description: Open
                type: string
              start:
                format: date-time
                type: string
              v:
                description: Volume
                type: integer
            type: object
          type: array
      title: Futures Candles
      type: object
    Futures_Contracts:
      description: Active CME futures contracts with recent trading activity, most active first.
      properties:
        data:
          items:
            additionalProperties: true
            properties:
              contract_size:
                description: 'CME UnitOfMeasureQty: size in the unit of measure. Original size for variable-quantity products.'
                nullable: true
                type: string
              expiry:
                format: date
                nullable: true
                type: string
              high:
                nullable: true
                type: string
              is_spread:
                description: True for calendar/inter-commodity spread contracts.
                type: boolean
              last_trade:
                format: date-time
                nullable: true
                type: string
              low:
                nullable: true
                type: string
              multiplier:
                description: Cash per 1.0 of price movement (tick_value / tick_size). Use this for notional.
                nullable: true
                type: string
              name:
                description: Dated contract symbol, e.g. ESU6.
                example: ESU6
                type: string
              product:
                description: CME product code, e.g. ES.
                example: ES
                type: string
              security_id:
                nullable: true
                type: integer
              tick_size:
                description: Minimum price increment.
                nullable: true
                type: string
              tick_value:
                description: Cash value of one tick.
                nullable: true
                type: string
              trades:
                type: integer
              unit_of_measure:
                description: e.g. IPNT, BBL, TRYOZ.
                nullable: true
                type: string
              volume:
                nullable: true
                type: integer
            type: object
          type: array
      title: Futures Contracts
      type: object
    Futures_Display_Factor:
      description: Display factor for a single CME contract, used to convert raw integer prices to displayed decimal values.
      properties:
        data:
          allOf:
            - $ref: '#/components/schemas/Futures_Display_Factor_Item'
          nullable: true
      title: Futures Display Factor
      type: object
    Futures_Display_Factor_Item:
      additionalProperties: true
      properties:
        asset:
          description: CME asset code, e.g. ES.
          type: string
        contract_size:
          description: CME UnitOfMeasureQty (tag 1147). Original size for variable-quantity products.
          nullable: true
          type: string
        display_factor:
          description: Multiplier to convert raw integer price to displayed decimal value.
          type: string
        exchange:
          description: Exchange MIC, e.g. XCME.
          type: string
        multiplier:
          description: Cash per 1.0 of price movement (tick_value / tick_size). Use this for notional.
          nullable: true
          type: string
        security_group:
          description: CME security group.
          nullable: true
          type: string
        security_id:
          description: CME numeric security ID.
          type: integer
        subtype:
          description: Contract subtype.
          nullable: true
          type: string
        symbol:
          description: Dated contract symbol, e.g. ESU6.
          type: string
        tick_size:
          description: Minimum price increment.
          nullable: true
          type: string
        tick_value:
          description: Cash value of one tick.
          nullable: true
          type: string
        unit_of_measure:
          description: e.g. IPNT, BBL, TRYOZ.
          nullable: true
          type: string
        updated_at:
          format: date-time
          type: string
      title: Futures Display Factor Item
      type: object
    Futures_Display_Factors:
      description: |
        CME per-instrument display factors, paginated by `security_id`.
        Pass the last `security_id` in the response as `after_id` to fetch the next page.
      properties:
        data:
          items:
            $ref: '#/components/schemas/Futures_Display_Factor_Item'
          type: array
      title: Futures Display Factors
      type: object
    Futures_Flow:
      description: Newest-first trade prints across all contracts, with the contract and product on each row.
      properties:
        data:
          items:
            additionalProperties: true
            properties:
              action:
                description: Block rows only.
                enum:
                  - new
                  - update
                nullable: true
                type: string
              clr_sym:
                description: Block rows only.
                nullable: true
                type: string
              crossed:
                nullable: true
                type: boolean
              executed_at:
                format: date-time
                type: string
              is_block:
                description: True for CME block trades, which carry the block-only fields below instead of size/side/nbbo.
                type: boolean
              is_spread:
                description: Calendar or inter-commodity spread.
                type: boolean
              legs:
                description: Block rows only. Legs of a multi-leg (MLEG) strategy.
                items:
                  properties:
                    leg_side:
                      nullable: true
                      type: string
                    price:
                      nullable: true
                      type: string
                    qty:
                      nullable: true
                      type: string
                    ratio_qty:
                      nullable: true
                      type: string
                    sec_type:
                      nullable: true
                      type: string
                    sym:
                      nullable: true
                      type: string
                  type: object
                nullable: true
                type: array
              nbbo_ask:
                nullable: true
                type: string
              nbbo_bid:
                nullable: true
                type: string
              price:
                nullable: true
                type: string
              product:
                example: ES
                type: string
              qty:
                description: Block rows only.
                nullable: true
                type: string
              reported_at:
                description: Block rows only.
                format: date-time
                nullable: true
                type: string
              sec_type:
                description: Block rows only.
                nullable: true
                type: string
              side:
                enum:
                  - buy
                  - sell
                  - none
                nullable: true
                type: string
              size:
                nullable: true
                type: integer
              strategy_link_id:
                description: Block rows only.
                nullable: true
                type: integer
              sym:
                example: ESU6
                type: string
              trade_id:
                nullable: true
                type: integer
            type: object
          type: array
      title: Futures Flow
      type: object
    Futures_Stats:
      description: 'Latest session statistics for a contract: official settlement, open interest and session volume.'
      properties:
        data:
          additionalProperties: true
          properties:
            open_interest:
              nullable: true
              type: integer
            session_high:
              description: Latest session high.
              nullable: true
              type: string
            session_low:
              description: Latest session low.
              nullable: true
              type: string
            session_volume:
              nullable: true
              type: integer
            settlement:
              description: Official settlement price (day-change reference).
              nullable: true
              type: string
            settlement_date:
              format: date
              nullable: true
              type: string
          type: object
      title: Futures Stats
      type: object
    Futures_Trades:
      description: |
        Newest-first trade prints (time & sales) for a contract.
        CME block trades are included by default alongside regular prints. Use `blocks_only=true` to return only block trades, or `skip_blocks=true` to exclude them.
        Each row carries `is_block` to distinguish regular prints from block trades.
        Block-trade rows include `reported_at`, `qty`, `sec_type`, `action`, `clr_sym`, `strategy_link_id`, and `legs`.
        Regular-print rows include `size`, `side`, `nbbo_bid`, `nbbo_ask`, and `crossed`.
      properties:
        data:
          items:
            additionalProperties: true
            properties:
              action:
                description: Block trades only.
                enum:
                  - new
                  - update
                nullable: true
                type: string
              clr_sym:
                description: Block