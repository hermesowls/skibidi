      properties:
        etf:
          $ref: '#/components/schemas/Etf_Ticker'
        full_name:
          $ref: '#/components/schemas/Etf_Full_Name'
        last_price:
          $ref: '#/components/schemas/Candle_Close'
        prev_price:
          $ref: '#/components/schemas/Stock_Prev_Close_Price'
        shares:
          $ref: '#/components/schemas/Etf_Shares'
        weight:
          $ref: '#/components/schemas/Etf_Weight'
      title: Exposure
      type: object
    FDA_Calendar:
      description: FDA calendar events with company information
      example:
        data:
          - catalyst: PDUFA Date
            description: FDA decision for Lifileucel in advanced melanoma
            drug: Lifileucel
            end_date: 2024-02-24
            has_options: true
            indication: Advanced Melanoma
            marketcap: '1000000000'
            notes: Important milestone for the company's drug pipeline
            outcome:
            outcome_brief:
            source_link: https://www.fda.gov/news-events/press-announcements/fda-example
            start_date: 2024-02-24
            status: NDA
            ticker: IOVA
      properties:
        catalyst:
          $ref: '#/components/schemas/FDA_Calendar_Catalyst'
        description:
          $ref: '#/components/schemas/FDA_Calendar_Description'
        drug:
          $ref: '#/components/schemas/FDA_Calendar_Drug'
        end_date:
          $ref: '#/components/schemas/FDA_Calendar_End_Date'
        has_options:
          $ref: '#/components/schemas/Has_Options'
        indication:
          $ref: '#/components/schemas/FDA_Calendar_Indication'
        marketcap:
          $ref: '#/components/schemas/Company_Market_Cap'
        notes:
          $ref: '#/components/schemas/FDA_Calendar_Notes'
        outcome:
          $ref: '#/components/schemas/FDA_Calendar_Outcome'
        outcome_brief:
          $ref: '#/components/schemas/FDA_Calendar_Outcome_Brief'
        source_link:
          $ref: '#/components/schemas/FDA_Calendar_Source_Link'
        start_date:
          $ref: '#/components/schemas/FDA_Calendar_Start_Date'
        status:
          $ref: '#/components/schemas/FDA_Calendar_Status'
        ticker:
          $ref: '#/components/schemas/FDA_Calendar_Ticker'
      required:
        - ticker
        - drug
        - status
        - start_date
        - end_date
      title: FDA Calendar
      type: object
    FDA_Calendar_Catalyst:
      description: The type of FDA event (e.g., PDUFA Date, Advisory Committee Meeting)
      example: PDUFA Date
      title: FDA Calendar Catalyst
      type: string
    FDA_Calendar_Description:
      description: Detailed description of the FDA event
      example: FDA decision for Lifileucel in advanced melanoma
      title: FDA Calendar Description
      type: string
    FDA_Calendar_Drug:
      description: Name of the drug under FDA review
      example: Lifileucel
      title: FDA Calendar Drug
      type: string
    FDA_Calendar_End_Date:
      description: The end date of the FDA event
      example: 2024-02-24
      format: date
      title: FDA Calendar End Date
      type: string
    FDA_Calendar_Indication:
      description: The medical condition the drug is intended to treat
      example: Advanced Melanoma
      title: FDA Calendar Indication
      type: string
    FDA_Calendar_Notes:
      description: Additional important notes about the FDA event
      example: Important milestone for the company's drug pipeline
      nullable: true
      title: FDA Calendar Notes
      type: string
    FDA_Calendar_Outcome:
      description: The outcome of the FDA event if already occurred
      example: Approved
      nullable: true
      title: FDA Calendar Outcome
      type: string
    FDA_Calendar_Outcome_Brief:
      description: Brief summary of the FDA event outcome
      example: Complete Response Letter received
      nullable: true
      title: FDA Calendar Outcome Brief
      type: string
    FDA_Calendar_Source_Link:
      description: Link to the source of the FDA event information
      example: https://www.fda.gov/news-events/press-announcements/fda-example
      nullable: true
      title: FDA Calendar Source Link
      type: string
    FDA_Calendar_Start_Date:
      description: The start date of the FDA event
      example: 2024-02-24
      format: date
      title: FDA Calendar Start Date
      type: string
    FDA_Calendar_Status:
      description: The current status of the FDA application (e.g., NDA, BLA)
      example: NDA
      title: FDA Calendar Status
      type: string
    FDA_Calendar_Ticker:
      description: The ticker of the company applying for drug admission.
      example: IOVA
      title: FDA Calendar Ticker
      type: string
    FDA_Target_Date:
      description: |
        FDA target date in one of the following formats:
        - YYYY-Q[1-4] (e.g. 2024-Q1)
        - YYYY-H[1-2] (e.g. 2024-H1)
        - YYYY-MID (e.g. 2024-MID)
        - YYYY-LATE (e.g. 2024-LATE)
        - YYYY-MM-DD
      example: 2024-Q1
      pattern: ^\d{4}-(Q[1-4]|H[1-2]|MID|LATE|\d{2}-\d{2})$
      title: FDA Target Date
      type: string
    FX_Crypto_Series:
      properties:
        bars:
          items:
            $ref: '#/components/schemas/OHLC_Bar'
          type: array
        from:
          nullable: true
          type: string
        interval:
          nullable: true
          type: string
        market:
          nullable: true
          type: string
        symbol:
          nullable: true
          type: string
        time_zone:
          nullable: true
          type: string
        to:
          nullable: true
          type: string
      title: FX/Crypto Series
      type: object
    FX_Rate_Response:
      properties:
        data:
          $ref: '#/components/schemas/FX_Spot_Rate'
      title: FX Rate Response
      type: object
    FX_Spot_Rate:
      properties:
        ask:
          nullable: true
          type: number
        bid:
          nullable: true
          type: number
        from:
          nullable: true
          type: string
        last_refreshed:
          nullable: true
          type: string
        rate:
          nullable: true
          type: number
        time_zone:
          nullable: true
          type: string
        to:
          nullable: true
          type: string
      title: FX Spot Rate
      type: object
    Failures_to_Deliver:
      description: |
        Failures to deliver data for a specific ticker.
        This endpoint provides information about the number of shares that failed to be delivered
        as part of the short selling process.
      example:
        data:
          - date: 2023-04-10
            price: '45.75'
            quantity: 1250
          - date: 2023-04-11
            price: '46.23'
            quantity: 8500
          - date: 2023-04-12
            price: '45.92'
            quantity: 4200
          - date: 2023-04-13
            price: '46.45'
            quantity: 780
          - date: 2023-04-14
            price: '46.78'
            quantity: 1500
          - date: 2023-04-17
            price: '47.12'
            quantity: 5670
          - date: 2023-04-18
            price: '47.45'
            quantity: 3200
      properties:
        date:
          description: The date for the failures to deliver.
          format: date
          type: string
        price:
          $ref: '#/components/schemas/Stock_Close_Price'
        quantity:
          description: The amount of failures to deliver for the day.
          type: string
      title: Failures to Deliver
      type: object
    Filing_Date:
      description: The latest filing date in ISO format.
      example: 2024-10-02
      title: Filing Date
      type: string
    Fill_Price:
      description: The fill price of the option trade.
      example: '21.50'
      title: Fill Price
      type: string
    Filter:
      default: NetPremium
      description: Retrieve the strikes with the highest filter parameter.
      enum:
        - NetPremium
        - Volume
        - Trades
      example: Volume
      title: Filter
      type: string
    Filter_Late_Reports_Only:
      default: false
      description: Only return trades reported more than 45 days after the transaction date.
      example: true
      title: Filter Late Reports Only
      type: boolean
    Flow_Alert:
      description: |
        Representation of a flow alert.
      example:
        data:
          - alert_rule: RepeatedHits
            all_opening_trades: false
            created_at: 2023-12-12T16:35:52.168490Z
            expiry: 2023-12-22
            expiry_count: 1
            has_floor: false
            has_multileg: false
            has_singleleg: true
            has_sweep: true
            issue_type: Common Stock
            open_interest: 7913
            option_chain: MSFT231222C00375000
            price: '4.05'
            strike: '375'
            ticker: MSFT
            total_ask_side_prem: '151875'
            total_bid_side_prem: '405'
            total_premium: '186705'
            total_size: 461
            trade_count: 32
            type: call
            underlying_price: '372.99'
            volume: 2442
            volume_oi_ratio: '0.30860609124226'
      properties:
        alert_rule:
          $ref: '#/components/schemas/Alert_Rule_Name'
        all_opening_trades:
          $ref: '#/components/schemas/Option_Contract_All_Opening_Trades'
        created_at:
          $ref: '#/components/schemas/General_UTC_Timestamp'
        delta:
          description: Size weighted delta of all transactions that make up the flow alert. Null when unavailable.
          format: double
          nullable: true
          type: number
        expiry:
          $ref: '#/components/schemas/Option_Contract_Expiry'
        expiry_count:
          $ref: '#/components/schemas/Option_Contract_Expiry_Count'
        gamma:
          description: Size weighted gamma of all transactions that make up the flow alert. Null when unavailable.
          format: double
          nullable: true
          type: number
        has_floor:
          $ref: '#/components/schemas/Option_Contract_Has_Floor'
        has_multileg:
          $ref: '#/components/schemas/Single_Trade_Has_Multileg'
        has_singleleg:
          $ref: '#/components/schemas/Single_Trade_Is_Single_Leg'
        has_sweep:
          $ref: '#/components/schemas/Single_Trade_Is_Sweep'
        issue_type:
          $ref: '#/components/schemas/Stock_Issue_Type'
        iv:
          description: Size weighted implied volatility of all transactions that make up the flow alert. Null when unavailable.
          format: double
          nullable: true
          type: number
        open_interest:
          $ref: '#/components/schemas/ToBeDone'
        option_chain:
          $ref: '#/components/schemas/Option_Contract_Symbol'
        price:
          $ref: '#/components/schemas/ToBeDone'
        rho:
          description: Size weighted rho of all transactions that make up the flow alert. Null when unavailable.
          format: double
          nullable: true
          type: number
        strike:
          $ref: '#/components/schemas/Option_Contract_Strike'
        theo:
          description: Size weighted theoretical option price of all transactions that make up the flow alert. Null when unavailable.
          format: double
          nullable: true
          type: number
        theta:
          description: Size weighted theta of all transactions that make up the flow alert. Null when unavailable.
          format: double
          nullable: true
          type: number
        ticker:
          $ref: '#/components/schemas/ToBeDone'
        total_ask_side_prem:
          $ref: '#/components/schemas/ToBeDone'
        total_bid_side_prem:
          $ref: '#/components/schemas/ToBeDone'
        total_premium:
          $ref: '#/components/schemas/ToBeDone'
        total_size:
          $ref: '#/components/schemas/ToBeDone'
        trade_count:
          $ref: '#/components/schemas/ToBeDone'
        type:
          $ref: '#/components/schemas/Option_Contract_Type'
        underlying_price:
          $ref: '#/components/schemas/ToBeDone'
        vega:
          description: Size weighted vega of all transactions that make up the flow alert. Null when unavailable.
          format: double
          nullable: true
          type: number
        volume:
          $ref: '#/components/schemas/ToBeDone'
        volume_oi_ratio:
          $ref: '#/components/schemas/ToBeDone'
      title: Flow Alert
      type: object
    Flow_Alert_Detail:
