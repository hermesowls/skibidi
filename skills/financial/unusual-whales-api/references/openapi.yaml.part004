l_trades: 3370
            contracts: 38633
            exchange: AMXO
            premium: 5454330
            put_trades: 3434
            trade_code: slan
            trade_count: 6804
            underlying_symbol: AAPL
      properties:
        call_trades:
          description: The number of call prints in this group.
          example: 3370
          type: integer
        contracts:
          description: The total number of contracts traded in this group.
          example: 38633
          type: integer
        exchange:
          $ref: '#/components/schemas/Exchange'
        premium:
          description: The total premium of this group, computed as sum(price × size × 100).
          example: 5454330
          type: number
        put_trades:
          description: The number of put prints in this group.
          example: 3434
          type: integer
        trade_code:
          $ref: '#/components/schemas/Upstream_Condition_Detail'
        trade_count:
          description: The number of option prints in this group.
          example: 6804
          type: integer
        underlying_symbol:
          $ref: '#/components/schemas/Option_Contract_Underlying_Symbol'
      title: Option Trade Exchange Breakdown
      type: object
    Option_Trade_ID:
      description: The ID of the option trade.
      example: 8ef90a2d-d881-41de-98c9-c1de4318dcb5
      title: Option Trade ID
      type: string
    Option_Trade_Size:
      description: The size of the option trade.
      example: 1
      title: Option Trade Size
      type: integer
    Option_Trade_Volume:
      description: The amount of contracts traded till this point.
      example: 33
      title: Option Trade Volume
      type: integer
    Option_Trades_Error_Response:
      properties:
        error:
          properties:
            code:
              example: historical_data_not_supported
              type: string
            message:
              example: This endpoint only returns data for the latest trading day. Use /api/option-trades/full-tape/:date to download the full market file for a historical trading day.
              type: string
          type: object
      title: Option Trades Error Response
      type: object
    Option_Trades_Response:
      example:
        data:
          - ask_vol: 2
            bid_vol: 1
            canceled: false
            delta: '0.610546281537814'
            er_time: postmarket
            ewma_nbbo_ask: '21.60'
