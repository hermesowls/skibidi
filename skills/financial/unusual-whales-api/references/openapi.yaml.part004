          description: 'First-order greek: theta.'
          example: '-0.058'
          nullable: true
          type: string
        total_premium:
          $ref: '#/components/schemas/Option_Contract_Premium'
        vega:
          description: 'First-order greek: vega.'
          example: '0.112'
          nullable: true
          type: string
        volume:
          $ref: '#/components/schemas/Option_Contract_Volume'
      title: Option contracts
      type: object
    Optionable_Tickers:
      description: |
        Without a `ticker` query param, `data` is an alphabetically sorted array of every underlying symbol
        that currently has listed options.

        With `?ticker=SYMBOL`, `data` is instead an object `{ "ticker": ..., "has_options": true|false }`
        reporting whether that one symbol has listed options.
      example:
        data:
          - A
          - AA
          - AAA
          - AAAU
          - AACB
          - AACG
          - AACT
          - AADI
          - AAL
          - AAOI
      items:
        example: AAPL
        type: string
      title: Optionable Tickers
      type: array
    OptionalTimespan:
      description: "Optional timespan parameter that can be used to specify a date range. Accepts values like '1y', '6m', '3m', '1m', '1w' or an ISO date (example: 2024-01-25)."
      example: 1y
      title: OptionalTimespan
      type: string
    Optional_Market_Date:
      description: |
        A trading date in the format of YYYY-MM-DD.
        This is optional and by default the last trading date.
      example: 2024-01-18
      title: Optional Market Date
      type: string
    Optional_POTUS_Schedule_Date:
      description: |
        A date in the format of YYYY-MM-DD.
        This is optional and by default returns the most recent scheduled date.
      example: 2026-07-09
      title: Optional POTUS Schedule Date
      type: string
    Optional_Ticker:
      description: Optional ticker symbol to filter results
      example: IOVA
      nullable: true
      title: Optional Ticker
      type: string
    OrderDirection:
      default: desc
      description: Whether to sort descending or ascending. Descending by default.
      enum:
        - desc
        - asc
      example: asc
      title: OrderDirection
      type: string
    Ownership:
      description: ''
      example:
        data:
          - cik: ''
            entity_type: other
            name: OTHER
            ownership: '0.5778598057824398968559314757'
            ownership_perc: '57.79'
            units: 1258514670
          - cik: '0001548760'
            entity_type: insider
            name: ZUCKERBERG MARK
            ownership: '0.1573567903006183552668030525'
            ownership_perc: '15.74'
            units: 342705665
          - cik: '0000102909'
            entity_type: institution
            name: VANGUARD GROUP INC
            ownership: '0.08849226346961719659402940931'
            ownership_perc: '8.85'
            units: 192726351
          - cik: '0002012383'
            entity_type: institution
            name: BLACKROCK, INC.
            ownership: '0.07690733150859746487873438344'
            ownership_perc: '7.69'
            units: 167495652
          - cik: '0000315066'
            entity_type: institution
            name: FMR LLC
            ownership: '0.05969144108951482234425757667'
            ownership_perc: '5.97'
            units: 130001349
          - cik: '0000093751'
            entity_type: institution
            name: STATE STREET CORP
            ownership: '0.03969236784921226406024410234'
            ownership_perc: '3.97'
            units: 86445582
      properties:
        cik:
          $ref: '#/components/schemas/Ownership_CIK'
        entity_type:
          $ref: '#/components/schemas/Ownership_Entity_Type'
        name:
          $ref: '#/components/schemas/Ownership_Name'
        ownership:
          $ref: '#/components/schemas/Ownership_Relative'
        ownership_perc:
          $ref: '#/components/schemas/Ownership_Percentage'
        units:
          $ref: '#/components/schemas/Ownership_Units'
      title: Ownership
      type: object
    Ownership_CIK:
      description: The cik of the institution or insider trader owning the shares. Politicians don't have a CIK, so the field is empty for those.
      example: '0001548760'
      title: Ownership CIK
      type: string
    Ownership_Entity_Type:
      description: The type of entity owning the ticker shares.
      enum:
        - institution
        - insider
        - politician
        - other
      title: Ownership Entity Type
      type: string
    Ownership_Name:
      description: The name of the institution, insider trader or politician owning the shares.
      example: MARK ZUCKERBERG
      title: Ownership Name
      type: string
    Ownership_Percentage:
      description: The percentage of ticker shares owned by the institution, insider trader or politician.
      title: Ownership Percentage
      type: string
    Ownership_Relative:
      description: The relative amount of ticker shares owned by the institution, insider trader or politician.
      title: Ownership Relative
      type: string
    Ownership_Units:
      description: The absolute amount of ticker shares owned by the institution, insider trader or politician.
      title: Ownership Units
      type: integer
    POTUS_Post:
      description: A short-form social media post from the President.
      example:
        data:
          - post: Best fireworks show, EVER! President DJT
            timestamp: 1783561144000
          - post: Tariffs are working. America First!
            timestamp: 1783550000000
      properties:
        post:
          description: The full text of the post.
          example: Best fireworks show, EVER! President DJT
          type: string
        timestamp:
          description: The post's publish time as a Unix epoch timestamp in milliseconds (UTC).
          example: 1783561144000
          type: integer
      required:
        - timestamp
        - post
      title: POTUS Post
      type: object
    POTUS_Post_Search_Term:
      description: Optional search term to filter posts by their text content.
      example: Walmart
      title: POTUS Post Search Term
      type: string
    POTUS_Schedule_Entry:
      description: An entry from the President's public schedule.
      example:
        data:
          - coverage: Closed Press
            date: 2026-07-09
            details: The President participates in a Policy Meeting
            location: Oval Office
            time: 2026-07-09T21:00:00Z
            type: President Schedule
            url:
            video_url:
      properties:
        coverage:
          description: The press coverage designation for the event.
          example: Closed Press
          nullable: true
          type: string
        date:
          description: The calendar date of the entry in YYYY-MM-DD format.
          example: 2026-07-09
          type: string
        details:
          description: A human-readable description of the event.
          example: The President participates in a Policy Meeting
          nullable: true
          type: string
        location:
          description: Where the event takes place.
          example: Oval Office
          nullable: true
          type: string
        time:
          description: The start time of the entry as an ISO 8601 UTC timestamp.
          example: 2026-07-09T21:00:00Z
          nullable: true
          type: string
        type:
          description: The kind of schedule entry.
          example: President Schedule
          type: string
        url:
          description: An optional link associated with the event.
          nullable: true
          type: string
        video_url:
          description: An optional video link associated with the event.
          nullable: true
          type: string
      required:
        - type
        - date
      title: POTUS Schedule Entry
      type: object
    Page:
      description: Page number (use with limit). Starts on page 0.
      example: 1
      title: Page
      type: integer
    People:
      description: Persons of interest in the institution.
      example:
        - Paul Singer
      items:
        type: string
      title: People
      type: array
    Perc_of_Share_Value:
      description: The percentage of the total share value of this institution that this holding represents. For example, if the sum of all the institution's holdings total $100 million and this holding has reported value $4 million, then the perc_of_share_value result will be 0.04.
      example: 0.04
      title: Perc of Share Value
      type: number
    Perc_of_Total:
      description: The percentage of the total outstanding shares owned by this institution. For example, if there are 500 million outstanding shares and this institution owns 1 million shares, then the perc_of_total result will be 0.002.
      example: 0.002
      title: Perc of Total
      type: number
    Politician:
      properties:
        id:
          description: The politician's ID.
          example: e138f347-ae92-4cfb-8f41-7036ff09a213
          format: uuid
          type: string
        name:
          description: The politician's name.
          example: Zoe Lofgren
          type: string
      title: Politician
      type: object
    Politician_ID:
      description: The Politician's ID that you'd like to filter by.
      example: 18f9fc95-4661-444e-99f5-99d3778e0c31
      title: Politician ID
      type: string
    Politician_Portfolio:
      properties:
        crypto_holdings:
          description: The portfolio crypto holdings.
          items:
            $ref: '#/components/schemas/Crypto_Holding'
          type: array
        id:
          description: The portfolio ID.
          example: 5fbe81ac-1157-4bc8-9d76-c77e6164fe25
          format: uuid
          type: string
        last_annual_disclosure:
          description: The year of this portfolio's latest annual disclosure.
          example: 2023
          type: integer
        option_holdings:
          description: The portfolio option holdings.
          items:
            $ref: '#/components/schemas/Option_Holding'
          type: array
        owner:
          description: The portfolio owner's name. Is "aggregated" when aggregate_all_portfolios is true.
          enum:
            - self
            - spouse
            - joint
            - child
            - aggregated
          example: self
          type: string
        stock_holdings:
          description: The portfolio stock and ETF holdings.
          items:
            $ref: '#/components/schemas/Stock_Holding'
          type: array
      title: Politician Portfolio
      type: object
    Politician_Portfolios:
      example:
        data:
          - crypto_holdings: []
            id: 6361b0d9-ad41-424a-9c42-afa5f3393e69
            last_annual_disclosure: 2023
            option_holdings: []
            owner: self
            stock_holdings:
              - max_amount: 15
                mid_amount: 7
                min_amount: 1
                ticker: XYZ
                type: stock
              - max_amount: 505
                mid_amount: 328
                min_amount: 151
                ticker: RHP
                type: stock
      properties:
        data:
          items:
            $ref: '#/components/schemas/Politician_Portfolio'
          type: array
      title: Politician Portfolios
      type: object
    Politician_Trades:
      additionalProperties: true
      description: Trades reported by members of congress, with the linked politician where known.
      example:
        data:
          - asset: NVIDIA Corporation - Common Stock
            asset_type: stock
            filed_at_date: 2026-07-15
            high_value: '5000000'
            id: b3f1c2d4-5e6f-4a7b-8c9d-0e1f2a3b4c5d
            is_amendment: false
            is_etf: false
            low_value: '1000001'
            mid_value: '3000000'
            name: Nancy Pelosi
            politician_id: 18f9fc95-4661-444e-99f5-99d3778e0c31
            ticker: NVDA
            transaction_date: 2026-06-20
            transaction_type: Buy
      title: Politician Trades
      type: object
    Politicians_List:
      example:
        data:
          - id: e138f347-ae92-4cfb-8f41-7036ff09a213
            name: Zoe Lofgren
      properties:
        data:
          items:
            $ref: '#/components/schemas/Politician'
          type: array
      title: Politicians List
      type: object
    Portfolio_Holder:
      properties:
        full_name:
          description: The politician's name.
          example: Zoe Lofgren
          type: string
        id:
          description: The portfolio ID.
          example: 5fbe81ac-1157-4bc8-9d76-c77e6164fe25
          format: uuid
          type: string
        max_amount:
          description: The portfolio's maximum share quantity.
          example: 143
          type: number
        mid_amount:
          description: The portfolio's midpoint share quantity.
          example: 76
          type: number
        min_amount:
          description: The portfolio's minimum share quantity.
          example: 9
          type: number
        owner:
          description: The portfolio owner's name.
          enum:
            - self
            - spouse
            - joint
            - child
          example: self
          type: string
      title: Portfolio Holder
      type: object
    Portfolio_Holders:
      example:
        data:
          - full_name: Zoe Lofgren
            id: 5fbe81ac-1157-4bc8-9d76-c77e6164fe25
            max_amount: 143
            mid_amount: 76
            min_amount: 9
            owner: self
          - full_name: Zoe Lofgren
            id: 9d28365f-7559-417b-ba26-102cefde89eb
            max_amount: 2386
            mid_amount: 1670
            min_amount: 954
            owner: spouse
      properties:
        data:
          items:
            $ref: '#/components/schemas/Portfolio_Holder'
          type: array
      title: Portfolio Holders
      type: object
    Positions:
      description: ''
      example: 5
      title: Positions
      type: integer
    Positions_Closed:
      description: ''
      example: 2
      title: Positions Closed
      type: integer
    Positions_Decreased:
      description: ''
      example: 2
      title: Positions Decreased
      type: integer
    Positions_Increased:
      description: ''
      example: 2
      title: Positions Increased
      type: integer
    Post_Earnings_Move_13Day:
      description: The 3 day % move after the earnings report.
      example: '0.08'
      title: Post Earnings Move 13Day
