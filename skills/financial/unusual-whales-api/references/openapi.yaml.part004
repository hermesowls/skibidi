        implied_volatility:
          $ref: '#/components/schemas/Option_Contract_Last_Transaction_IV'
        iv_high:
          $ref: '#/components/schemas/Option_Contract_IV_High'
        iv_low:
          $ref: '#/components/schemas/Option_Contract_IV_Low'
        last_price:
          $ref: '#/components/schemas/Option_Contract_Close'
        last_tape_time:
          $ref: '#/components/schemas/Option_Contract_Last_Transaction_Time'
        low_price:
          $ref: '#/components/schemas/Option_Contract_Low'
        mid_volume:
          $ref: '#/components/schemas/Option_Contract_Mid_Volume'
