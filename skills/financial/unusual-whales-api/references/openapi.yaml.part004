      title: Option Trades Response
      type: object
    Option_contract:
      description: ''
      example:
        chains:
          - ask_volume: 1766
            avg_price: '0.01360828625235404896'
            bid_volume: 887
            cross_volume: 0
            date: 2023-05-26
            floor_volume: 0
            high_price: '0.03'
            implied_volatility: '0.310502942482285'
            iv_high: '0.675815680048166'
            iv_low: '0.310502942482285'
