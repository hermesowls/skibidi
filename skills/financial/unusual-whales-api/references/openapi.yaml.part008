  /api/futures/contracts:
    get:
      callbacks: {}
      description: |
        Active CME futures contracts with trading activity over the last `days` CME sessions (default 3, max 30),
        most active first. Available on the Advanced API tier, or with the `futures` add-on — contact oskar@unusualwhales.com, enterprise@unusualwhales.com or nastja.petrovic@unusualwhales.com for access.
      operationId: PublicApi.FuturesController.contracts
      parameters:
        - description: Lookback in CME sessions, skipping weekends and holidays (default 3, max 30).
          in: query
          name: days
          required: false
          schema:
            type: integer
        - description: Case-insensitive substring match on contract name or product.
          in: query
          name: q
          required: false
          schema:
            type: string
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Futures_Contracts'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error_Message'
          description: Unprocessable Entity
        '500':
          content:
            text/plain:
              schema:
                $ref: '#/components/schemas/Error_Message_on_an_internal_server_error.'
          description: Internal Server Error
      summary: Futures Contracts
      tags:
        - Futures
  /api/futures/display_factors:
    get:
      callbacks: {}
      description: |
        CME per-instrument display factors, used to convert raw integer prices to their displayed decimal values.
        Filter by `asset` (e.g. HO, ES, CL) or `subtype`. Paginate with `after_id` + `limit` across the full ~158k contract table.
        Available on the Advanced API tier, or with the `futures` add-on — contact oskar@unusualwhales.com, enterprise@unusualwhales.com or nastja.petrovic@unusualwhales.com for access.
      operationId: PublicApi.FuturesController.display_factors
      parameters:
        - description: CME asset code to filter by, e.g. HO, ES, CL.
          in: query
          name: asset
          required: false
          schema:
            type: string
        - description: Contract subtype filter.
          in: query
          name: subtype
          required: false
          schema:
            type: string
        - description: 'Cursor: return rows with security_id greater than this value.'
          in: query
          name: after_id
          required: false
          schema:
            type: integer
        - description: Max rows per page (default 1000, max 5000).
          in: query
          name: limit
          required: false
          schema:
            type: integer
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Futures_Display_Factors'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error_Message'
          description: Unprocessable Entity
        '500':
          content:
            text/plain:
              schema:
                $ref: '#/components/schemas/Error_Message_on_an_internal_server_error.'
          description: Internal Server Error
      summary: Futures Display Factors
      tags:
        - Futures
  /api/futures/display_factors/{security_id}:
    get:
      callbacks: {}
      description: |
        Display factor for a single CME contract identified by its numeric `security_id`.
        Available on the Advanced API tier, or with the `futures` add-on — contact oskar@unusualwhales.com, enterprise@unusualwhales.com or nastja.petrovic@unusualwhales.com for access.
      operationId: PublicApi.FuturesController.display_factor
      parameters:
        - description: CME numeric security ID.
          in: path
          name: security_id
          required: true
          schema:
            type: integer
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Futures_Display_Factor'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error_Message'
          description: Unprocessable Entity
        '500':
          content:
            text/plain:
              schema:
                $ref: '#/components/schemas/Error_Message_on_an_internal_server_error.'
          description: Internal Server Error
      summary: Futures Display Factor
      tags:
        - Futures
  /api/futures/flow:
    get:
      callbacks: {}
      description: |
        Newest-first trade prints across ALL contracts, block trades included by default.
        Each row carries `is_block` and `is_spread`. Optional server-side filters narrow the feed.
        Available on the Advanced API tier, or with the `futures` add-on — contact oskar@unusualwhales.com, enterprise@unusualwhales.com or nastja.petrovic@unusualwhales.com for access.
      operationId: PublicApi.FuturesController.flow
      parameters:
        - description: Max rows (default 100, max 500).
          in: query
          name: limit
          required: false
          schema:
            type: integer
        - description: 'Cursor: return trades executed before this ISO8601 timestamp.'
          in: query
          name: older_than
          required: false
          schema:
            type: string
        - description: 'Cursor: return trades executed after this ISO8601 timestamp.'
          in: query
          name: newer_than
          required: false
          schema:
            type: string
        - description: Comma-separated CME product codes to include, e.g. ES,NQ.
          in: query
          name: products
          required: false
          schema:
            type: string
        - description: Filter by aggressor side. Case-sensitive.
          in: query
          name: side
          required: false
          schema:
            enum:
              - buy
              - sell
            type: string
        - description: Minimum trade size (contracts).
          in: query
          name: min_size
          required: false
          schema:
            type: integer
        - description: Maximum trade size (contracts).
          in: query
          name: max_size
          required: false
          schema:
            type: integer
        - description: Minimum trade price.
          in: query
          name: min_price
          required: false
          schema:
            type: number
        - description: Maximum trade price.
          in: query
          name: max_price
          required: false
          schema:
            type: number
        - description: Minimum notional (price x size x multiplier). Needs secdef economics.
          in: query
          name: min_notional
          required: false
          schema:
            type: number
        - description: Set to false to exclude calendar/spread contracts.
          in: query
          name: include_spreads
          required: false
          schema:
            type: boolean
        - description: Set to true to exclude CME block trades.
          in: query
          name: skip_blocks
          required: false
          schema:
            type: boolean
        - description: Set to true to return only CME block trades.
          in: query
          name: blocks_only
          required: false
          schema:
            type: boolean
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Futures_Flow'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error_Message'
          description: Unprocessable Entity
        '500':
          content:
            text/plain:
              schema:
                $ref: '#/components/schemas/Error_Message_on_an_internal_server_error.'
          description: Internal Server Error
      summary: Futures Flow
      tags:
        - Futures
  /api/futures/{contract}/candles:
    get:
      callbacks: {}
      description: |
        OHLCV candles for a contract. Available on the Advanced API tier, or with the `futures` add-on — contact oskar@unusualwhales.com, enterprise@unusualwhales.com or nastja.petrovic@unusualwhales.com for access.
      operationId: PublicApi.FuturesController.candles
      parameters:
        - description: Dated CME contract symbol, e.g. ESU6.
          example: ESU6
          in: path
          name: contract
          required: true
          schema:
            type: string
        - description: Candle interval.
          in: query
          name: interval
          required: false
          schema:
            default: 1m
            enum:
              - 1m
              - 5m
              - 1d
            type: string
        - description: History range.
          in: query
          name: range
          required: false
          schema:
            default: 1d
            enum:
              - 1d
              - 3d
              - 5d
              - 1w
              - 1m
              - 3m
              - 6m
              - 1y
              - 5y
            type: string
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Futures_Candles'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error_Message'
          description: Unprocessable Entity
        '500':
          content:
            text/plain:
              schema:
                $ref: '#/components/schemas/Error_Message_on_an_internal_server_error.'
          description: Internal Server Error
      summary: Futures Candles (OHLCV)
      tags:
        - Futures
  /api/futures/{contract}/stats:
    get:
      callbacks: {}
      description: |
        Latest session statistics for a contract: official settlement (day-change reference),
        settlement date, open interest and session volume. Available on the Advanced API tier, or with the `futures` add-on — contact oskar@unusualwhales.com, enterprise@unusualwhales.com or nastja.petrovic@unusualwhales.com for access.
      operationId: PublicApi.FuturesController.stats
      parameters:
        - description: Dated CME contract symbol, e.g. ESU6.
          example: ESU6
          in: path
          name: contract
          required: true
          schema:
            type: string
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Futures_Stats'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error_Message'
          description: Unprocessable Entity
        '500':
          content:
            text/plain:
              schema:
                $ref: '#/components/schemas/Error_Message_on_an_internal_server_error.'
          description: Internal Server Error
      summary: Futures Session Stats
      tags:
        - Futures
  /api/futures/{contract}/trades:
    get:
      callbacks: {}
      description: |
        Newest-first trade prints for a contract, cursor-paginated via `older_than`/`newer_than`.
        Response includes both regular and CME block trades by default; each row has `is_block` to distinguish them.
        Pass `blocks_only=true` to return only block trades.
        Pass `skip_blocks=true` to exclude block trades and return only regular prints.
        Available on the Advanced API tier, or with the `futures` add-on — contact oskar@unusualwhales.com, enterprise@unusualwhales.com or nastja.petrovic@unusualwhales.com for access.
      operationId: PublicApi.FuturesController.trades
      parameters:
        - description: Dated CME contract symbol, e.g. ESU6.
          example: ESU6
          in: path
          name: contract
          required: true
          schema:
            type: string
        - description: Max rows (default 100, max 500).
          in: query
          name: limit
          required: false
          schema:
            type: integer
        - description: 'Cursor: return trades executed before this ISO8601 timestamp.'
          in: query
          name: older_than
          required: false
          schema:
            type: string
        - description: 'Cursor: return trades executed after this ISO8601 timestamp.'
          in: query
          name: newer_than
          required: false
          schema:
            type: string
        - description: Set to true to exclude CME block trades and return only regular prints.
          in: query
          name: skip_blocks
          required: false
          schema:
            type: boolean
        - description: Set to true to return only CME block trades.
          in: query
          name: blocks_only
          required: false
          schema:
            type: boolean
        - description: Minimum notional (price x size x multiplier). Needs secdef economics.
          in: query
          name: min_notional
          required: false
          schema:
            type: number
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Futures_Trades'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error_Message'
          description: Unprocessable Entity
        '500':
          content:
            text/plain:
              schema:
                $ref: '#/components/schemas/Error_Message_on_an_internal_server_error.'
          description: Internal Server Error
      summary: Futures Trades (Time & Sales)
      tags:
        - Futures
  /api/group-flow/{flow_group}/greek-flow:
    get:
      callbacks: {}
      description: |
        Returns the group flow's greek flow (delta & vega flow) for the given market day broken down per minute.
        Date must be the current or a past date. If no date is given, returns data for the current/last market day.
      operationId: PublicApi.GroupFlowController.greek_flow
      parameters:
        - description: ''
          in: path
          name: flow_group
          required: true
          schema:
            $ref: '#/components/schemas/SingleFlowGroup'
        - description: ''
          in: query
          name: date
          required: false
          schema:
            $ref: '#/components/schemas/Optional_Market_Date'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Group_Flow'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
      summary: Greek flow
      tags:
        - group_flow
  /api/group-flow/{flow_group}/greek-flow/{expiry}:
    get:
      callbacks: {}
      description: |
        Returns the group flow's greek flow (delta & vega flow) for the given market day broken down per minute & expiry.
        Date must be the current or a past date. If no date is given, returns data for the current/last market day.
      operationId: PublicApi.GroupFlowController.greek_flow_expiry
      parameters:
        - description: ''
          in: path
          name: flow_group
          required: true
          schema:
            $ref: '#/components/schemas/SingleFlowGroup'
        - description: ''
          in: path
          name: expiry
          required: true
          schema:
            $ref: '#/components/schemas/Single_expiry_date'
        - description: ''
          in: query
          name: date
          required: false
          schema:
            $ref: '#/components/schemas/Optional_Market_Date'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Group_Flow_Expiry'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
      summary: Greek flow by expiry
      tags:
        - group_flow
  /api/insider/transactions:
    get:
      callbacks: {}
      description: |
        Returns the latest insider transactions.

        By default all transacations that have been filled by the same person on the same day with the same trade code are aggregated into a single row.
        Each of those aggregated rows will contain a field `ids` which contains the ids of the single transactions that were aggregated as well as the amount
        of transactions that were aggregated.

        If you want to disable this behaviour you can set the `group` parameter to false to receive the single transacations as they have been filled.
      operationId: PublicApi.InsiderController.transactions
      parameters:
        - description: ''
          in: query
          name: ticker_symbol
          required: false
          schema:
            $ref: '#/components/schemas/Ticker'
        - description: Minimum transaction value in dollars
          example: 100000
          in: query
          name: min_value
          required: false
          schema:
            type: string
        - description: Maximum transaction value in dollars
          example: 1000000
          in: query
          name: max_value
          required: false
          schema:
            type: string
        - description: Minimum stock price at the time of transaction
          example: 10.5
          in: query
          name: min_price
          required: false
          schema:
            type: string
        - description: Maximum stock price at the time of transaction
          example: 50.75
          in: query
          name: max_price
          required: false
          schema:
            type: string
        - description: Name of the insider who made the transaction
          example: John Doe
          in: query
          name: owner_name
          required: false
          schema:
            type: string
        - description: Filter by company sector(s)
          in: query
          name: sectors[]
          required: false
          schema:
            $ref: '#/components/schemas/Sectors'
        - description: Filter by company industry or industries
          in: query
          name: industries[]
          required: false
          schema:
            $ref: '#/components/schemas/Industries'
        - description: ''
          in: query
          name: min_marketcap
          required: false
          schema:
            $ref: '#/components/schemas/Min_Marketcap'
        - description: ''
          in: query
          name: max_marketcap
          required: false
          schema:
            $ref: '#/components/schemas/Max_Marketcap'
        - description: Size category of company market cap
          in: query
          name: market_cap_size
          required: false
          schema:
            $ref: '#/components/schemas/Single_market_cap_size'
        - description: ''
          in: query
          name: min_earnings_dte
          required: false
          schema:
            $ref: '#/components/schemas/Min_Earnings_DTE'
        - description: ''
          in: query
          name: max_earnings_dte
          required: false
          schema:
            $ref: '#/components/schemas/Max_Earnings_DTE'
        - description: Minimum number of shares in transaction
          example: 1000
          in: query
          name: min_amount
          required: false
          schema:
            type: string
        - description: Maximum number of shares in transaction
          example: 10000
          in: query
          name: max_amount
          required: false
          schema:
            type: string
        - description: Filter transactions by company directors
          example: true
          in: query
          name: is_director
          required: false
          schema:
            type: boolean
        - description: Filter transactions by company officers
          example: true
          in: query
          name: is_officer
          required: false
          schema:
            type: boolean
        - description: Only include S&P 500 companies
          example: true
          in: query
          name: is_s_p_500
          required: false
          schema:
            type: boolean
        - description: Filter transactions by 10% owners
          example: false
          in: query
          name: is_ten_percent_owner
          required: false
          schema:
            type: boolean
        - description: Only include common stock transactions
          example: true
          in: query
          name: common_stock_only
          required: false
          schema:
            type: boolean
        - description: Filter by transaction codes (P=Purchase, S=Sale, etc.)
          example:
            - P
            - S
          in: query
          name: transaction_codes[]
          required: false
          schema:
            type: string
        - description: 'Filter by SEC form: 3, 3/A, 4, 4/A, 5, 5/A, 144, 144/A. Form 144 is a notice of intended sale, so pass 4 (and 4/A for amendments) to get executed trades only. Default: all forms.'
          example:
            - '4'
            - 4/A
          in: query
          name: form_types[]
          required: false
          schema:
            type: string
        - description: Exact match on the reporting owner's SEC CIK. The stable identifier for one insider across companies and years; owner_name spelling varies between filings.
          example: '0001548760'
          in: query
          name: reporter_cik
          required: false
          schema:
            type: string
        - description: 'Filter by security acquisition/disposition codes: NA, ND, DA, DD, D'
          example:
            - NA
            - ND
          in: query
          name: security_ad_codes[]
          required: false
          schema:
            type: string
        - description: ''
          in: query
          name: limit
          required: false
          schema:
            $ref: '#/components/schemas/Default_500_Max_500_Min_1'
        - description: ''
          in: query
          name: page
          required: false
          schema:
            $ref: '#/components/schemas/Page'
        - description: Group insider transactions with same person and trade code on the same day into a single row
          example: true
          in: query
          name: group
          required: false
          schema:
            type: boolean
        - description: 'Filter for transaction dates occurring on or after this date (ISO format: YYYY-MM-DD)'
          example: 2026-01-01
          in: query
          name: start_date
          required: false
          schema:
            format: date
            type: string
        - description: 'Filter for transaction dates occurring on or before this date (ISO format: YYYY-MM-DD)'
          example: 2026-01-23
          in: query
          name: end_date
          required: false
          schema:
            format: date
            type: string
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Insider_Trade_Agg'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
      summary: Transactions
      tags:
        - insiders
  /api/insider/{sector}/sector-flow:
