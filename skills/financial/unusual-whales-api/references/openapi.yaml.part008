  /api/etfs/{ticker}/in-outflow:
    get:
      callbacks: {}
      description: |
        Returns an ETF's inflow and outflow.
        Defaults to the last year of data. Maximum date range is 3 years.
      operationId: PublicApi.EtfController.in_outflow
      parameters:
        - description: ''
          in: path
          name: ticker
          required: true
