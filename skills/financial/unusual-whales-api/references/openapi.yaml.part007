          description: Forbidden
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error_Message'
          description: Unprocessable Entity
        '500':
          content:
            text/plain:
              schema:
                $ref: '#/components/schemas/Error_Message_on_an_internal_server_error.'
          description: Internal Server Error
      summary: Sliding-Window Analytics
      tags:
        - intel
  /api/analytics/window:
    get:
      callbacks: {}
      description: '**Requires Advanced+ tier (Advanced, Enterprise, or Enterprise + Kafka).** Statistical analytics over a fixed window across one or more tickers. Returns mean, stddev, correlation, etc.'
      operationId: PublicApi.IntelController.analytics_window
      parameters:
        - description: Comma-separated tickers.
          in: query
          name: symbols
          required: true
          schema:
            example: AAPL,IBM,MSFT
            type: string
        - description: Either an ISO date for the start of the window (pair with the optional range_end) or a relative shorthand like '2month' or 'full'.
          in: query
          name: range
          required: true
          schema:
            example: 2month
            type: string
        - description: Optional end date when using ISO range_start.
          in: query
          name: range_end
          required: false
          schema:
            example: 2024-08-31
            type: string
        - description: ''
          in: query
          name: interval
          required: false
          schema:
            default: DAILY
            enum:
              - 1min
              - 5min
              - 15min
              - 30min
              - 60min
              - DAILY
              - WEEKLY
              - MONTHLY
            type: string
        - description: ''
          in: query
          name: ohlc
          required: false
          schema:
            default: close
            enum:
              - open
              - high
              - low
              - close
            type: string
        - description: 'Comma-separated. Supported: MIN, MAX, MEAN, MEDIAN, CUMULATIVE_RETURN, VARIANCE, STDDEV, MAX_DRAWDOWN, HISTOGRAM, AUTOCORRELATION, COVARIANCE, CORRELATION.'
          in: query
          name: calculations
          required: true
          schema:
            example: MEAN,STDDEV,CORRELATION
            type: string
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Analytics_Response'
          description: Analytics Window
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error_Message'
          description: Unprocessable Entity
        '500':
          content:
            text/plain:
              schema:
                $ref: '#/components/schemas/Error_Message_on_an_internal_server_error.'
          description: Internal Server Error
      summary: Fixed-Window Analytics
      tags:
        - intel
