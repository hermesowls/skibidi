    {
      "key": "GET /api/market/fda-calendar",
      "method": "GET",
      "path": "/api/market/fda-calendar",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns FDA calendar data with filtering options.\n\nThe FDA calendar contains information about:\n- PDUFA (Prescription Drug User Fee Act) dates\n- Advisory Committee Meetings\n- FDA Decisions\n- Clinical Trial Results\n- New Drug Applications\n- Biologics License Applications\n\n## Date Format Support\nThe target_date parameters support various FDA-specific date formats:\n- Quarters: YYYY-Q[1-4] (e.g. 2024-Q1)\n- Half years: YYYY-H[1-2] (e.g. 2024-H1)\n- Mid-year: YYYY-MID (e.g. 2024-MID)\n- Late-year: YYYY-LATE (e.g. 2024-LATE)\n- Standard dates: YYYY-MM-DD\n",
        "operationId": "PublicApi.MarketController.fda_calendar",
        "parameters": [
          {
            "description": "Minimum announced date (YYYY-MM-DD)",
            "in": "query",
            "name": "announced_date_min",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          },
          {
            "description": "Maximum announced date (YYYY-MM-DD)",
            "in": "query",
            "name": "announced_date_max",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          },
          {
            "description": "Minimum target date (supports Q1-Q4, H1-H2, MID, LATE formats)",
            "in": "query",
            "name": "target_date_min",
            "required": false,
            "schema": {
              "description": "FDA target date in one of the following formats:\n- YYYY-Q[1-4] (e.g. 2024-Q1)\n- YYYY-H[1-2] (e.g. 2024-H1)\n- YYYY-MID (e.g. 2024-MID)\n- YYYY-LATE (e.g. 2024-LATE)\n- YYYY-MM-DD\n",
              "example": "2024-Q1",
              "pattern": "^\\d{4}-(Q[1-4]|H[1-2]|MID|LATE|\\d{2}-\\d{2})$",
              "title": "FDA Target Date",
              "type": "string"
            }
          },
          {
            "description": "Maximum target date (supports Q1-Q4, H1-H2, MID, LATE formats)",
            "in": "query",
            "name": "target_date_max",
            "required": false,
            "schema": {
              "description": "FDA target date in one of the following formats:\n- YYYY-Q[1-4] (e.g. 2024-Q1)\n- YYYY-H[1-2] (e.g. 2024-H1)\n- YYYY-MID (e.g. 2024-MID)\n- YYYY-LATE (e.g. 2024-LATE)\n- YYYY-MM-DD\n",
              "example": "2024-Q1",
              "pattern": "^\\d{4}-(Q[1-4]|H[1-2]|MID|LATE|\\d{2}-\\d{2})$",
              "title": "FDA Target Date",
              "type": "string"
            }
          },
          {
            "description": "Filter by drug name (partial match)",
            "in": "query",
            "name": "drug",
            "required": false,
            "schema": {
              "description": "Drug name to filter FDA calendar entries (partial match supported)",
              "example": "Keytruda",
              "title": "Drug Name",
              "type": "string"
            }
          },
          {
            "description": "Filter by ticker symbol",
            "in": "query",
            "name": "ticker",
            "required": false,
            "schema": {
              "description": "A comma separated list of tickers. To exclude certain tickers prefix the first ticker with a `-`.",
              "example": "AAPL,INTC",
              "title": "Ticker",
              "type": "string"
            }
          },
          {
            "description": "Maximum number of results to return",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "description": "How many items to return. Default: 100. Max: 200. Min: 1.",
              "example": 10,
              "maximum": 200,
              "minimum": 1,
              "title": "Default 100 Max 200 Min 1",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "FDA calendar events with company information",
                  "example": {
                    "data": [
                      {
                        "catalyst": "PDUFA Date",
                        "description": "FDA decision for Lifileucel in advanced melanoma",
                        "drug": "Lifileucel",
                        "end_date": "2024-02-24",
                        "has_options": true,
                        "indication": "Advanced Melanoma",
                        "marketcap": "1000000000",
                        "notes": "Important milestone for the company's drug pipeline",
                        "outcome": null,
                        "outcome_brief": null,
                        "source_link": "https://www.fda.gov/news-events/press-announcements/fda-example",
                        "start_date": "2024-02-24",
                        "status": "NDA",
                        "ticker": "IOVA"
                      }
                    ]
                  },
                  "properties": {
                    "catalyst": {
                      "description": "The type of FDA event (e.g., PDUFA Date, Advisory Committee Meeting)",
                      "example": "PDUFA Date",
                      "title": "FDA Calendar Catalyst",
                      "type": "string"
                    },
                    "description": {
                      "description": "Detailed description of the FDA event",
                      "example": "FDA decision for Lifileucel in advanced melanoma",
                      "title": "FDA Calendar Description",
                      "type": "string"
                    },
                    "drug": {
                      "description": "Name of the drug under FDA review",
                      "example": "Lifileucel",
                      "title": "FDA Calendar Drug",
                      "type": "string"
                    },
                    "end_date": {
                      "description": "The end date of the FDA event",
                      "example": "2024-02-24",
                      "format": "date",
                      "title": "FDA Calendar End Date",
                      "type": "string"
                    },
                    "has_options": {
                      "description": "Whether the company has options available for trading",
                      "example": true,
                      "nullable": true,
                      "title": "Has Options",
                      "type": "boolean"
                    },
                    "indication": {
                      "description": "The medical condition the drug is intended to treat",
                      "example": "Advanced Melanoma",
                      "title": "FDA Calendar Indication",
                      "type": "string"
                    },
                    "marketcap": {
                      "description": "The company's market capitalization in USD",
                      "example": "1000000000",
                      "nullable": true,
                      "title": "Company Market Cap",
                      "type": "string"
                    },
                    "notes": {
                      "description": "Additional important notes about the FDA event",
                      "example": "Important milestone for the company's drug pipeline",
                      "nullable": true,
                      "title": "FDA Calendar Notes",
                      "type": "string"
                    },
                    "outcome": {
                      "description": "The outcome of the FDA event if already occurred",
                      "example": "Approved",
                      "nullable": true,
                      "title": "FDA Calendar Outcome",
                      "type": "string"
                    },
                    "outcome_brief": {
                      "description": "Brief summary of the FDA event outcome",
                      "example": "Complete Response Letter received",
                      "nullable": true,
                      "title": "FDA Calendar Outcome Brief",
                      "type": "string"
                    },
                    "source_link": {
                      "description": "Link to the source of the FDA event information",
                      "example": "https://www.fda.gov/news-events/press-announcements/fda-example",
                      "nullable": true,
                      "title": "FDA Calendar Source Link",
                      "type": "string"
                    },
                    "start_date": {
                      "description": "The start date of the FDA event",
                      "example": "2024-02-24",
                      "format": "date",
                      "title": "FDA Calendar Start Date",
                      "type": "string"
                    },
                    "status": {
                      "description": "The current status of the FDA application (e.g., NDA, BLA)",
                      "example": "NDA",
                      "title": "FDA Calendar Status",
                      "type": "string"
                    },
                    "ticker": {
                      "description": "The ticker of the company applying for drug admission.",
                      "example": "IOVA",
                      "title": "FDA Calendar Ticker",
                      "type": "string"
                    }
                  },
                  "required": [
                    "ticker",
                    "drug",
                    "status",
                    "start_date",
                    "end_date"
                  ],
                  "title": "FDA Calendar",
                  "type": "object"
                }
              }
            },
            "description": "FDA Calendar response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Returned with HTTP 401 when a request carries no API token, or carries one the API cannot use. The response also carries a `WWW-Authenticate` header with the `Bearer` challenge. Branch on `reason` rather than on `message`, whose wording can change.",
                  "example": {
                    "code": "authentication_required",
                    "documentation_url": "https://api.unusualwhales.com/docs",
                    "expected_format": "uuid",
                    "message": "The API token provided is not in the expected format. Unusual Whales API tokens are UUIDs, such as 123e4567-e89b-12d3-a456-426614174000.",
                    "reason": "malformed_token",
