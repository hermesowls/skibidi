                      {
                        "event": "Consumer sentiment (final)",
                        "forecast": "69.4",
                        "prev": "69.4",
                        "reported_period": "December",
                        "time": "2023-12-22 15:00:00+00:00",
                        "type": "report"
                      },
                      {
                        "event": "PCE index",
                        "forecast": null,
                        "prev": "0.0%",
