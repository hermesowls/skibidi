    {
      "key": "GET /api/market/market-tide",
      "method": "GET",
      "path": "/api/market/market-tide",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Market Tide is a proprietary tool that can be viewed from the Market Overview page. The Market Tide chart provides real time data based on a proprietary formula that examines market wide options activity and filters out 'noise'.\n\nDate must be the current or a past date. If no date is given, returns data for the current/last market day.\n\nPer default data are returned in 1 minute intervals. Use `interval_5m=true` to have this return data in 5 minute intervals instead.\n\n\nFor example:\n- $15,000 in calls transacted at the ask has the effect of increasing the daily net call premium by $15,000.\n- $10,000 in calls transacted at the bid has the effect of decreasing the daily net call premium by $10,000.\n\nThe resulting net premium from both of these trades would be $5000 (+ $15,000 - $10,000).\n\nTransactions taking place at the mid are not accounted for.\n\nIn theory:\n\nThe sentiment in the options market becomes increasingly bullish if:\n1. The aggregated CALL PREMIUM is increasing at a faster rate.\n2. The aggregated PUT PREMIUM is decreasing at a faster rate.\n\nThe sentiment in the options market becomes increasingly bearish if:\n1. The aggregated CALL PREMIUM is decreasing at a faster rate.\n2. The aggregated PUT PREMIUM is increasing at a faster rate.\n\nIf you are interested in which tickers are influencing the market tide the most\nyou can check [https://api.unusualwhales.com/docs/operations/PublicApi.MarketController.top_net_impact](https://api.unusualwhales.com/docs/operations/PublicApi.MarketController.top_net_impact).\n\nIf you are looking for a market tide but for specific sectors check out: [https://api.unusualwhales.com/docs/operations/PublicApi.MarketController.sec_indst](https://api.unusualwhales.com/docs/operations/PublicApi.MarketController.sec_indst)\n\nFor a market tide for ETF holdings check out [https://api.unusualwhales.com/docs/operations/PublicApi.MarketController.etf_tide](https://api.unusualwhales.com/docs/operations/PublicApi.MarketController.etf_tide).\n\nFor real time streaming market tide data, subscribe to the `market_tide` websocket channel, see [https://api.unusualwhales.com/docs/operations/PublicApi.SocketController.channels](https://api.unusualwhales.com/docs/operations/PublicApi.SocketController.channels).\n\n----\nThis can be used to build a market overview such as:\n\n![market tide](https://i.imgur.com/tuwTCDc.png)\n\nData goes back to 2022-09-28\n",
        "operationId": "PublicApi.MarketController.market_tide",
        "parameters": [
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "otm_only",
            "required": false,
            "schema": {
              "default": false,
              "description": "Only include out of the money transactions.",
              "example": true,
              "title": "UseOtmOnly",
              "type": "boolean"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "interval_5m",
            "required": false,
            "schema": {
              "default": true,
              "description": "Return data in 5 minutes intervals.",
              "example": false,
              "title": "Use5mCandles",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "",
                  "example": {
                    "data": [
                      {
                        "date": "2023-09-08",
                        "net_call_premium": "660338.0000",
                        "net_put_premium": "-547564.0000",
                        "net_volume": 23558,
                        "timestamp": "2023-09-08 09:30:00-04:00"
                      },
                      {
                        "date": "2023-09-08",
                        "net_call_premium": "4907138.0000",
                        "net_put_premium": "-1709539.0000",
                        "net_volume": 64312,
                        "timestamp": "2023-09-08 09:31:00-04:00"
                      },
                      {
                        "date": "2023-09-08",
                        "net_call_premium": "4839265.0000",
                        "net_put_premium": "-2731793.0000",
                        "net_volume": 80029,
                        "timestamp": "2023-09-08 09:32:00-04:00"
                      }
                    ]
                  },
                  "properties": {
                    "net_call_premium": {
                      "description": "Defined as (call premium ask side) - (call premium bid side).",
                      "example": "-29138464",
                      "title": "Market General Net Call Premium",
                      "type": "string"
                    },
                    "net_put_premium": {
                      "description": "Defined as (put premium ask side) - (put premium bid side).",
                      "example": "23924325",
                      "title": "Market General Net Put Premium",
                      "type": "string"
                    },
                    "net_volume": {
                      "description": "Defined as (call volume ask side) - (call volume bid side) - ((put volume ask side) - (put volume bid side)).",
                      "example": 64312,
                      "title": "Market General Net Volume",
                      "type": "integer"
                    },
                    "timestamp": {
                      "description": "The start time of the tick as a timestamp with timezone.",
                      "example": "2023-09-07 09:30:00-04:00",
                      "title": "General Tick time",
                      "type": "string"
                    }
                  },
                  "title": "Daily Market Tide",
                  "type": "object"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
