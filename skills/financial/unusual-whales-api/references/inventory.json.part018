    {
      "key": "GET /api/news/headlines",
      "method": "GET",
      "path": "/api/news/headlines",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the latest news headlines for financial markets.\n\nThis endpoint provides access to news headlines that may impact the markets, including company-specific\nnews, sector news, and market-wide events. Headlines can be filtered by source, content, ticker, and significance.\n\nUse the `search_term` parameter to filter by headline content, or the `ticker` parameter to filter\nby related ticker symbols. The data includes the headline text, source, related tickers, sentiment,\nand whether it's considered a major news item.\n",
        "operationId": "PublicApi.NewsController.headlines",
        "parameters": [
          {
            "description": "",
            "in": "query",
            "name": "sources",
            "required": false,
            "schema": {
              "description": "A comma-separated list of news sources to filter by (e.g., 'Reuters,Bloomberg').",
              "example": "BusinessWire,MarketNews",
              "title": "News Sources",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "search_term",
            "required": false,
            "schema": {
              "description": "A search term to filter news headlines by content.",
              "example": "earnings",
              "title": "News Search Term",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "ticker",
            "required": false,
            "schema": {
              "description": "Filter news headlines to only those mentioning the specified ticker symbol.",
              "example": "AAPL",
              "nullable": true,
              "title": "News Ticker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "major_only",
            "required": false,
            "schema": {
              "default": false,
              "description": "When set to true, only returns major/significant news.",
              "example": true,
              "title": "Major News Only",
              "type": "boolean"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "How many items to return. Default: 50. Max: 100. Min: 1.",
              "example": 10,
              "maximum": 100,
              "minimum": 1,
              "title": "Default 50 Max 100 Min 1",
              "type": "integer"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "description": "Page number (use with limit). Starts on page 0.",
              "example": 1,
              "title": "Page",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "News headlines for financial markets.\nThis endpoint provides recent news headlines that may impact the markets,\nincluding company-specific news, sector news, and market-wide events.\n",
                  "example": {
                    "data": [
                      {
                        "created_at": "2023-04-15 16:30:00+00:00",
                        "headline": "Company XYZ Reports Better Than Expected Earnings",
                        "is_major": true,
                        "meta": {},
                        "sentiment": "positive",
                        "source": "BusinessWire",
                        "tags": [
                          "earnings",
                          "tech"
                        ],
                        "tickers": [
                          "XYZ",
                          "EXMP"
                        ]
                      },
                      {
                        "created_at": "2023-04-15 14:20:00+00:00",
                        "headline": "Federal Reserve Signals Possible Rate Cut",
                        "is_major": true,
                        "meta": {},
                        "sentiment": "neutral",
                        "source": "MarketNews",
                        "tags": [
                          "federal-reserve",
                          "interest-rates"
                        ],
                        "tickers": []
                      }
                    ]
                  },
                  "properties": {
                    "created_at": {
                      "description": "Timestamp when the news headline was created or published.",
                      "format": "date_time",
                      "type": "string"
                    },
                    "headline": {
                      "description": "The actual news headline text.",
                      "type": "string"
                    },
                    "is_major": {
                      "description": "Indicates whether the news is considered major or significant.",
                      "type": "boolean"
                    },
                    "meta": {
                      "description": "Additional metadata related to the headline.",
                      "type": "object"
                    },
                    "sentiment": {
                      "description": "Sentiment analysis of the headline (e.g., positive, negative, neutral).",
                      "type": "string"
                    },
                    "source": {
                      "description": "Source of the news headline (e.g., Reuters, Bloomberg, etc.).",
                      "type": "string"
                    },
                    "tags": {
                      "description": "Tags or categories related to the headline.",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "tickers": {
                      "description": "List of ticker symbols related to this news.",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "created_at",
                    "headline",
                    "source"
                  ],
                  "title": "Headline News",
                  "type": "object"
                }
              }
            },
            "description": ""
          },
