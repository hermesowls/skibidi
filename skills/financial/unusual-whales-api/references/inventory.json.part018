 based on the options activity of companies which are in that specific sector\n",
        "operationId": "PublicApi.MarketController.sec_indst",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "sector",
            "required": true,
            "schema": {
              "description": "A singular sector.",
              "enum": [
                "Basic Materials",
                "Communication Services",
                "Consumer Cyclical",
                "Consumer Defensive",
                "Energy",
                "Financial Services",
                "Healthcare",
                "Industrials",
                "Real Estate",
                "Technology",
                "Utilities"
              ],
              "example": "Real Estate",
              "title": "Single sector",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          }
        ],
