                      ],
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "data",
                    "date",
                    "moneyness",
                    "tide_type",
                    "expiration"
                  ],
                  "title": "Expiry Tide Response",
                  "type": "object"
                }
              }
