  /api/options-pulse/top:
    get:
      callbacks: {}
      description: |
        Cross-symbol scanner: the latest intraday sentiment per ticker on a date, ranked by sentiment.
        `direction` `bullish` ranks highest sentiment first, `bearish` lowest first. Filterable by
        `ticker` (prefix), `min_score`/`max_score`, and `min_txn` (minimum opening-buy transactions).
      operationId: PublicApi.NasdaqPulseController.top
      parameters:
        - description: '`bullish` (default) or `bearish`.'
          in: query
          name: direction
          required: false
          schema:
            type: string
        - description: ''
          in: query
          name: date
          required: false
          schema:
            $ref: '#/components/schemas/Optional_Market_Date'
        - description: Restrict to tickers with this prefix.
          in: query
          name: ticker
          required: false
          schema:
            type: string
        - description: Minimum sentiment score.
          in: query
          name: min_score
          required: false
          schema:
            type: number
        - description: Maximum sentiment score.
          in: query
          name: max_score
          required: false
          schema:
            type: number
        - description: Minimum total opening-buy transactions (put + call).
          in: query
          name: min_txn
          required: false
          schema:
            type: integer
        - description: Max rows (default 50, max 500).
          in: query
          name: limit
          required: false
          schema:
            type: integer
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Nasdaq_Options_Pulse_Result'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error_Message'
          description: Unprocessable Entity
        '500':
          content:
            text/plain:
              schema:
                $ref: '#/components/schemas/Error_Message_on_an_internal_server_error.'
          description: Internal Server Error
      summary: Options Pulse Scanner
      tags:
        - options-pulse
