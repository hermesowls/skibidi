  /api/politics/fec/candidates:
    get:
      callbacks: {}
      description: |
        Federal candidates ranked by company-linked money received in a cycle: PAC-tier totals,
        employee-tier estimates, number of distinct companies, and basic candidate info with the
        linked politician where known.

        This is an enterprise only endpoint. Contact dev@unusualwhales.com for details about accessing this data.
