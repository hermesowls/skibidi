        - description: house | senate | president
          in: query
          name: office
          required: false
          schema:
            type: string
        - description: Two-letter state code.
          in: query
          name: state
          required: false
          schema:
            type: string
        - description: Party code, e.g. DEM, REP.
          in: query
          name: party
          required: false
          schema:
            type: string
        - description: Page number (default 1).
          in: query
          name: page
          required: false
          schema:
            type: integer
        - description: Rows per page (default 50, max 200).
          in: query
          name: limit
          required: false
          schema:
            type: integer
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Company_Politics_Candidates'
