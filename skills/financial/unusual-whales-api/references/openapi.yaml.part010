  /api/politics/fec/company/{ticker}/people:
    get:
      callbacks: {}
      description: |
        The people around a public company: candidates funded by its PAC and employees (with totals),
        politicians who traded the stock, and company insiders.

        This is an enterprise only endpoint. Contact dev@unusualwhales.com for details about accessing this data.
      operationId: PublicApi.PoliticsFecController.people
