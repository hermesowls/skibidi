  /api/option-trades/flow-alerts/{id}:
    get:
      callbacks: {}
      description: |
        Returns the trades that made up the specific alert. For multi leg flow alert trades it will
        return all the related multi leg trades.
        For alerts such as RepeatedHits it will return all the transactions that made up that alert.
      operationId: PublicApi.OptionTradeController.flow_alert
      parameters:
        - description: The UUID of the flow alert
          in: path
          name: id
          required: true
          schema:
            format: uuid
            type: string
        - description: ''
          in: query
          name: older_than
          required: false
          schema:
            $ref: '#/components/schemas/OlderThan'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Flow_Alert_Detail'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error_Message'
          description: Unprocessable Entity
        '500':
          content:
            text/plain:
              schema:
                $ref: '#/components/schemas/Error_Message_on_an_internal_server_error.'
          description: Internal Server Error
      summary: Flow Alert by ID
      tags:
        - option-trade
  /api/option-trades/full-tape/{date}:
    get:
      callbacks: {}
      description: |
        Download all option transactions (the "full tape") for a given trading date.

        To filter option transactions for the current trading day use the [Option Trades endpoint](https://api.unusualwhales.com/docs/operations/PublicApi.OptionTradeController.index).

        How far back you can download is determined by your plan's historical lookback window with data available since 2022-01-01.

        If you are looking to build a data lake with the full tape use this skill with your agent: https://unusualwhales.com/skills/uw-options-data-lake-skill.md

        You can download the data as a zip file using wget. For example, to download data for Fri Jul 25th, 2025, if your API key is "abc123":
        ```
        wget --header="Authorization: Bearer abc123" https://api.unusualwhales.com/api/option-trades/full-tape/2025-07-25 -O full_tape_20257225.zip
        ```
      operationId: PublicApi.OptionTradeController.full_tape
      parameters:
        - description: ''
          in: path
          name: date
          required: true
          schema:
            $ref: '#/components/schemas/Market_Date'
      responses:
        '200':
          content:
            application/zip: {}
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
      summary: Full Tape
      tags:
        - option-trade
  /api/option-trades/multi-leg:
    get:
      callbacks: {}
      description: |
        A live feed of detected multi-leg option strategies — vertical spreads, iron condors, butterflies,
        calendars, diagonals and more — reconstructed from their individual legs, newest first. Each row summarizes
        the strategy (fill/net price, net bid/ask, net premium, net greeks, strikes, DTE range, breakevens, max profit/loss) across all legs.
        Use the per-strategy `id` with the `legs` endpoint to fetch the individual contracts.

        Decimal values are returned as strings. Defaults to the current trading day when no time bounds are given.
        Queries are limited to a 24-hour range. If both bounds span more than 24 hours, `newer_than` is clamped
        to 24 hours before `older_than`.
      operationId: PublicApi.MultiLegController.index
      parameters:
        - description: Rows per page (default 50, max 500).
          in: query
          name: limit
          required: false
          schema:
            type: integer
        - description: Rows to skip for pagination (max 500).
          in: query
          name: offset
          required: false
          schema:
            type: integer
        - description: Restrict to a single underlying ticker.
          in: query
          name: ticker_symbol
          required: false
          schema:
            type: string
        - description: Only strategies executed at/after this UTC timestamp (ISO-8601). Defaults to last market open. The query range is limited to 24 hours.
          in: query
          name: newer_than
          required: false
          schema:
            type: string
        - description: Only strategies executed at/before this UTC timestamp (ISO-8601). The query range is limited to 24 hours.
          in: query
          name: older_than
          required: false
          schema:
            type: string
        - description: Filter by detected strategy name(s). Repeatable array param (e.g. `strategy[]=iron_condor&strategy[]=call_vertical_spread`).
          in: query
          name: strategy
          required: false
          schema:
            items:
              enum:
                - call_butterfly_spread
                - call_calendar
                - call_condor
                - call_diagonal_spread
                - call_ratio_spread
                - call_vertical_spread
                - iron_butterfly
                - iron_condor
                - jade_lizard
                - other
                - put_butterfly_spread
                - put_calendar
                - put_condor
                - put_diagonal_spread
                - put_frontspread
                - put_vertical_spread
                - risk_reversal
                - straddle
                - strangle
                - synthetic
              type: string
            type: array
        - description: Exclude strategies classified as `other` (unrecognized structures).
          in: query
          name: exclude_other
          required: false
          schema:
            type: boolean
        - description: Filter by direction (long/short). Repeatable array param.
          in: query
          name: direction
          required: false
          schema:
            items:
              type: string
            type: array
        - description: Filter by the strategy's net aggressor side (bid/ask/mid). Repeatable array param.
          in: query
          name: net_side
          required: false
          schema:
            items:
              enum:
                - bid
                - ask
                - mid
              type: string
            type: array
        - description: Minimum total contracts across legs.
          in: query
          name: min_size
          required: false
          schema:
            type: integer
        - description: Maximum total contracts across legs.
          in: query
          name: max_size
          required: false
          schema:
            type: integer
        - description: Minimum net premium (supports abs()).
          in: query
          name: min_premium
          required: false
          schema:
            type: string
        - description: Maximum net premium (supports abs()).
          in: query
          name: max_premium
          required: false
          schema:
            type: string
        - description: Minimum days-to-expiry.
          in: query
          name: min_dte
          required: false
          schema:
            type: integer
        - description: Maximum days-to-expiry.
          in: query
          name: max_dte
          required: false
          schema:
            type: integer
        - description: Minimum number of legs.
          in: query
          name: min_leg_count
          required: false
          schema:
            type: integer
        - description: Maximum number of legs.
          in: query
          name: max_leg_count
          required: false
          schema:
            type: integer
        - description: Only strategies where every leg is out-of-the-money.
          in: query
          name: all_otm
          required: false
          schema:
            type: boolean
        - description: Filter by underlying issue type(s), e.g. Common Stock, ETF. Repeatable array param.
          in: query
          name: issue_types
          required: false
          schema:
            items:
              type: string
            type: array
        - description: Filter by underlying sector(s). Repeatable array param.
          in: query
          name: sectors
          required: false
          schema:
            items:
              type: string
            type: array
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Multi-Leg_Trades_Response'
          description: Multi-Leg Trades
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error_Message'
          description: Unprocessable Entity
        '500':
          content:
            text/plain:
              schema:
                $ref: '#/components/schemas/Error_Message_on_an_internal_server_error.'
          description: Internal Server Error
      summary: Multi-Leg Option Trades
      tags:
        - option-trade
  /api/option-trades/multi-leg/{id}/legs:
    get:
      callbacks: {}
      description: |
        Returns the individual option legs that make up a single multi-leg strategy, aggregated by contract with
        size-weighted greeks and prices. Pass the strategy `id` returned by the Multi-Leg Option Trades feed.
      operationId: PublicApi.MultiLegController.legs
      parameters:
        - description: The multi-leg strategy id (UUID) from the trades feed.
          in: path
          name: id
          required: true
          schema:
            type: string
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Multi-Leg_Legs_Response'
          description: Multi-Leg Legs
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error_Message'
          description: Unprocessable Entity
        '500':
          content:
            text/plain:
              schema:
                $ref: '#/components/schemas/Error_Message_on_an_internal_server_error.'
          description: Internal Server Error
      summary: Multi-Leg Trade Legs
      tags:
        - option-trade
  /api/option-trades/optionable-tickers:
    get:
      callbacks: {}
      description: |
        Returns the current universe of underlying symbols that have listed options (sourced from the Nasdaq
        option-root locators), sorted alphabetically. Query this daily to track new listings and delistings.

        Pass `?ticker=SYMBOL` to check a single company instead — the response then reports whether that
        symbol currently has listed options.

        NOTICE: Access to this endpoint is only included in the Advanced API subscription.
      operationId: PublicApi.OptionTradeController.optionable_tickers
      parameters:
        - description: 'Optional: check a single symbol instead of listing the whole universe.'
          in: query
          name: ticker
          required: false
          schema:
            $ref: '#/components/schemas/Ticker'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Optionable_Tickers'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error_Message'
          description: Unprocessable Entity
        '500':
          content:
            text/plain:
              schema:
                $ref: '#/components/schemas/Error_Message_on_an_internal_server_error.'
          description: Internal Server Error
      summary: Optionable Tickers
      tags:
        - option-trade
