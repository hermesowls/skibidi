  /api/politics/fec/contributions:
    get:
      callbacks: {}
      description: |
        The company-politics contribution feed. With `aggregated=true` (the default) rows are at the
        company × candidate × cycle × tier grain - filter by `ticker` for a company's candidates, or by
        `candidate_id` for a candidate's companies. With `aggregated=false` rows are individual
        contributions, paginated by `cursor` (pass back `next_cursor` from the previous response);
        `tier` selects `pac` (default) or `employee`.

        This is an enterprise only endpoint. Contact dev@unusualwhales.com for details about accessing this data.
      operationId: PublicApi.PoliticsFecController.contributions
      parameters:
        - description: Default true.
          in: query
          name: aggregated
          required: false
          schema:
            type: boolean
        - description: ''
          in: query
          name: ticker
          required: false
          schema:
            type: string
        - description: ''
          in: query
          name: candidate_id
          required: false
          schema:
            type: integer
        - description: Politician UUID (aggregated only).
          in: query
          name: politician_id
          required: false
          schema:
            type: string
        - description: ''
          in: query
          name: party
          required: false
          schema:
            type: string
        - description: Two-year election cycle, e.g. 2026. Defaults to the current cycle.
          in: query
          name: cycle
          required: false
          schema:
            type: integer
        - description: pac | employee | all (aggregated default all).
          in: query
          name: tier
          required: false
          schema:
            type: string
        - description: Row-level only.
          in: query
          name: min_amount
          required: false
          schema:
            type: integer
        - description: Row-level only, ISO date.
          in: query
          name: min_date
          required: false
          schema:
            type: string
        - description: Row-level only, ISO date.
          in: query
          name: max_date
          required: false
          schema:
            type: string
        - description: 'Aggregated only: add a totals block.'
          in: query
          name: include_totals
          required: false
          schema:
            type: boolean
        - description: Row-level keyset cursor.
          in: query
          name: cursor
          required: false
          schema:
            type: string
        - description: Page number (default 1).
          in: query
          name: page
          required: false
          schema:
            type: integer
        - description: Rows per page (default 50, max 200).
          in: query
          name: limit
          required: false
          schema:
            type: integer
      responses:
        '200':
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: '#/components/schemas/Company_Politics_Contributions'
                  - $ref: '#/components/schemas/Company_Politics_Contribution_Rows'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error_Message'
          description: Unprocessable Entity
        '500':
          content:
            text/plain:
              schema:
                $ref: '#/components/schemas/Error_Message_on_an_internal_server_error.'
          description: Internal Server Error
      summary: Company political contributions
      tags:
        - politics
  /api/politics/politician/trades:
    get:
      callbacks: {}
      description: |
        Trades reported by members of congress, with the politician linked where known.
        If a date is given, will only return trades whose transaction date is <= the given input date.

        This is an enterprise only endpoint. Contact dev@unusualwhales.com for details about accessing this data.
      operationId: PublicApi.PoliticsFecController.politician_trades
      parameters:
        - description: ''
          in: query
          name: limit
          required: false
          schema:
            $ref: '#/components/schemas/Default_500_Max_500_Min_1'
        - description: ''
          in: query
          name: date
          required: false
          schema:
            $ref: '#/components/schemas/Optional_Market_Date'
        - description: ''
          in: query
          name: ticker
          required: false
          schema:
            $ref: '#/components/schemas/Optional_Ticker'
        - description: ''
          in: query
          name: politician_id
          required: false
          schema:
            $ref: '#/components/schemas/Politician_ID'
        - description: If true, will filter out any trades with a transaction date after the input date.
          in: query
          name: filter_late_reports
          required: false
          schema:
            $ref: '#/components/schemas/Filter_Late_Reports_Only'
        - description: The page number for the data being requested (default is 1).
          in: query
          name: page
          required: false
          schema:
            $ref: '#/components/schemas/Page'
        - description: If provided, will only return trades with a disclosure date >= this date.
          in: query
          name: disclosure_newer_than
          required: false
          schema:
            $ref: '#/components/schemas/NewerThan'
        - description: If provided, will only return trades with a disclosure date <= this date.
          in: query
          name: disclosure_older_than
          required: false
          schema:
            $ref: '#/components/schemas/OlderThan'
        - description: If provided, will only return trades with a transaction date >= this date.
          in: query
          name: transaction_newer_than
          required: false
          schema:
            $ref: '#/components/schemas/NewerThan'
        - description: If provided, will only return trades with a transaction date <= this date.
          in: query
          name: transaction_older_than
          required: false
          schema:
            $ref: '#/components/schemas/OlderThan'
        - description: ''
          in: query
          name: order_by
          required: false
          schema:
            $ref: '#/components/schemas/Congress_trade_order_by_field'
        - description: ''
          in: query
          name: order_direction
          required: false
          schema:
            $ref: '#/components/schemas/OrderDirection'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Politician_Trades'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error_Message'
          description: Unprocessable Entity
        '500':
          content:
            text/plain:
              schema:
                $ref: '#/components/schemas/Error_Message_on_an_internal_server_error.'
          description: Internal Server Error
      summary: Politician's trades
      tags:
        - politics
