    {
      "key": "GET /api/option-contract/{id}/historic",
      "method": "GET",
      "path": "/api/option-contract/{id}/historic",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns for every trading day historic data for the given option contract.\n\nData includes open, high, low, close of the contract of fills.\nThe percentage of the volume which was part of a multi leg trade, stock multi leg trade, sweep, floor\nand cross. The high and low of the implied volatility is included as well as the volume distributed per sides:\nAsk, bid, mid and neutral. Neutral is volume that is either a cross trade or from trades that came in late.\n\nYou can use this endpoint to retrieve for a given chains historical details about how much volume has been traded\nin the past, when the OI did start to build and much more.\n\nRows are returned under the `chains` key, not `data`.\n",
        "operationId": "PublicApi.OptionContractController.history",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "An option contract in the OSI format.",
              "example": "TSLA230526P00167500",
              "title": "OptionContract",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "description": "How many items to return. If no limit is given, returns all matching data. Min: 1.",
              "example": 10,
              "minimum": 1,
              "title": "Min Limit 1",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "",
                  "example": {
                    "chains": [
                      {
                        "ask_volume": 1766,
                        "avg_price": "0.01360828625235404896",
                        "bid_volume": 887,
                        "cross_volume": 0,
                        "date": "2023-05-26",
                        "floor_volume": 0,
                        "high_price": "0.03",
                        "implied_volatility": "0.310502942482285",
                        "iv_high": "0.675815680048166",
                        "iv_low": "0.310502942482285",
                        "last_price": "0.01",
                        "last_tape_time": "2023-05-26 21:30:29+00:00",
                        "low_price": "0.01",
                        "mid_volume": 0,
                        "multi_leg_volume": 393,
                        "nbbo_ask": "0.45",
                        "nbbo_bid": "0.30",
                        "neutral_volume": 2,
                        "open_interest": 15907,
                        "open_price": "0.02",
                        "stock_multi_leg_volume": 0,
                        "sweep_volume": 752,
                        "total_ask_changes": 165,
                        "total_bid_changes": 28,
                        "total_premium": "3613.00",
                        "trades": 244,
                        "volume": 2655
                      }
                    ]
                  },
                  "properties": {
                    "ask_volume": {
                      "description": "The amount of volume that happened on the ask side.\n\nAsk side is defined as (ask + bid) / 2 < fill price.\n",
                      "example": 119403,
                      "title": "Option Contract Ask Volume",
                      "type": "integer"
                    },
                    "avg_price": {
                      "description": "The volume weighted average fill price of the contract.",
                      "example": "1.0465802437910297887119234370",
                      "title": "Option Contract Avg Price",
                      "type": "string"
                    },
                    "bid_volume": {
                      "description": "The amount of volume that happened on the bid side.\n\nBid side is defined as (ask + bid) / 2 > fill price.\n",
                      "example": 122789,
                      "title": "Option Contract Bid Volume",
                      "type": "integer"
                    },
                    "cross_volume": {
                      "description": "The amount of cross volume.\nCross volume consists of all transaction that have the cross trade code.\n",
                      "example": 0,
                      "title": "Option Contract Cross Volume",
                      "type": "integer"
                    },
                    "date": {
                      "description": "A trading date in ISO format.\n",
                      "example": "2023-09-08",
                      "title": "Market General Trading day",
                      "type": "string"
                    },
                    "floor_volume": {
                      "description": "The amount of floor volume.\nFloor volume consists of all transaction that have the floor trade code.\n",
                      "example": 142,
                      "title": "Option Contract Floor Volume",
                      "type": "integer"
                    },
                    "high_price": {
                      "description": "The highest fill on that contract.",
                      "example": "2.95",
                      "title": "Option Contract High",
                      "type": "string"
                    },
                    "implied_volatility": {
                      "description": "The implied volatility for the last transaction.",
                      "example": "0.675815680048166",
                      "title": "Option Contract Last Transaction IV",
                      "type": "string"
                    },
                    "iv_high": {
                      "description": "The highest implied volatility at which a transaction occurred.",
                      "example": "0.675815680048166",
                      "title": "Option Contract IV High",
                      "type": "string"
                    },
                    "iv_low": {
                      "description": "The lowest implied volatility at which a transaction occurred.",
                      "example": "0.310502942482285",
                      "title": "Option Contract IV Low",
                      "type": "string"
                    },
                    "last_price": {
                      "description": "The last fill on the contract.",
                      "example": "0.03",
                      "title": "Option Contract Close",
                      "type": "string"
                    },
                    "last_tape_time": {
                      "description": "The last time there was a transaction for the given contract as UTC timestamp.",
                      "example": "2023-09-08 17:45:32+00:00",
                      "title": "Option Contract Last Transaction Time",
                      "type": "string"
                    },
                    "low_price": {
                      "description": "The lowest fill on that contract.",
                      "example": "0.02",
                      "title": "Option Contract Low",
                      "type": "string"
                    },
                    "mid_volume": {
                      "description": "The amount of volume that happened in the middle of the ask and bid.\n\nMid is defined as (ask + bid) / 2 == fill price.\n",
                      "example": 22707,
                      "title": "Option Contract Mid Volume",
                      "type": "integer"
                    },
                    "multi_leg_volume": {
                      "description": "The amount of volume that happened as part of a multileg trade with another contract.\nThis can be spreads/rolls/condors/butterflies and more.\n",
                      "example": 7486,
                      "title": "Option Contract Multi Leg Volume",
                      "type": "integer"
                    },
                    "nbbo_ask": {
                      "description": "The NBBO Ask price for the final tick of that day's trading session.",
                      "example": "0.45",
                      "title": "Last NBBO Ask",
                      "type": "string"
                    },
                    "nbbo_bid": {
                      "description": "The NBBO Bid price for the final tick of that day's trading session.",
                      "example": "0.30",
                      "title": "Last NBBO Bid",
                      "type": "string"
                    },
                    "no_side_volume": {
                      "description": "The amount of volume that happened on no identifiable side.\nThis can be late, out of sequence and/or cross transactions.\n",
                      "example": 0,
                      "title": "Option Contract No Side Volume",
                      "type": "integer"
                    },
                    "open_interest": {
                      "description": "The open interest for the contract.",
                      "example": 18680,
                      "title": "Option Contract Open interest",
                      "type": "integer"
                    },
                    "open_price": {
                      "description": "The first fill on that contract.",
                      "example": "0.92",
                      "title": "Option Contract Open",
                      "type": "string"
                    },
                    "stock_multi_leg_volume": {
                      "description": "The amount of volume that happened as part of a stock transaction and possibly other option contracts.\nThis can be covered calls and more.\n",
                      "example": 52,
                      "title": "Option Contract Stock Multi Leg Volume",
                      "type": "integer"
                    },
                    "sweep_volume": {
                      "description": "The amount of sweep volume.\nSweep volume consists of all transaction that have the sweep trade code.\n",
                      "example": 18260,
                      "title": "Option Contract Sweep Volume",
                      "type": "integer"
                    },
                    "total_ask_changes": {
                      "description": "The total count of changes to the NBBO ask during that day's trading session.",
                      "example": 165,
                      "title": "Option Contract Total Ask Changes",
                      "type": "integer"
                    },
                    "total_bid_changes": {
                      "description": "The total count of changes to the NBBO bid during that day's trading session.",
                      "example": 28,
                      "title": "Option Contract Total Bid Changes",
                      "type": "integer"
                    },
                    "total_premium": {
                      "description": "The total option premium.",
                      "example": "27723806.00",
                      "title": "Option Contract Premium",
                      "type": "string"
                    },
                    "trades": {
                      "description": "The amount of transaction for this contract.",
                      "example": 39690,
                      "title": "Option Contract Total Trades Count",
                      "type": "integer"
                    },
                    "volume": {
                      "description": "The contract volume.",
                      "example": 264899,
                      "title": "Option Contract Volume",
                      "type": "integer"
                    }
                  },
                  "title": "Option contract",
                  "type": "object"
                }
              }
            },
            "description": ""
          },
