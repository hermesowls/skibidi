    {
      "key": "GET /api/option-contract/{id}/intraday",
      "method": "GET",
      "path": "/api/option-contract/{id}/intraday",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns 1 minute interval intraday data for the given option contract.\n\nYou can use this to build volume profile charts for contracts to see when\nvolume can in, and which side dominated the volume. The volume and premium\nis segmented into bid, ask, mid and neutral.\n\nDate must be the current or a past date. If no date is given, returns data for the current/last market day.\n",
        "operationId": "PublicApi.OptionContractController.intraday",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "An option contract in the OSI format.",
              "example": "TSLA230526P00167500",
              "title": "OptionContract",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Minute-by-minute aggregated data for an option contract, based on chain aggregates.\n",
                  "example": {
                    "data": [
                      {
                        "avg_price": "30.18641509433962264151",
                        "close": "30.22",
                        "expiry": "2024-06-21",
                        "high": "30.25",
                        "iv_high": "0.25478345",
                        "iv_low": "0.24967245",
                        "low": "30.05",
                        "open": "30.15",
                        "option_symbol": "AAPL240621C00190000",
                        "premium_ask_side": "3138.00",
                        "premium_bid_side": "1403.92",
                        "premium_mid_side": "60.50",
                        "premium_no_side": "0.00",
                        "start_time": "2024-05-28 14:30:00+00:00",
                        "volume_ask_side": 104,
                        "volume_bid_side": 47,
                        "volume_mid_side": 2,
                        "volume_multi": 15,
                        "volume_no_side": 0,
                        "volume_stock_multi": 0
                      },
                      {
                        "avg_price": "30.2637719298245614035",
                        "close": "30.20",
                        "expiry": "2024-06-21",
                        "high": "30.35",
                        "iv_high": "0.25408976",
                        "iv_low": "0.25108545",
                        "low": "30.15",
                        "open": "30.22",
                        "option_symbol": "AAPL240621C00190000",
                        "premium_ask_side": "1058.75",
                        "premium_bid_side": "661.32",
                        "premium_mid_side": "0.00",
                        "premium_no_side": "0.00",
                        "start_time": "2024-05-28 14:31:00+0