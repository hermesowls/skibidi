    {
      "key": "GET /api/option-contract/{id}/flow",
      "method": "GET",
      "path": "/api/option-contract/{id}/flow",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the last 50 option trades for the given option chain. Optionally a min premium and a side can be supplied in the query for further filtering.\nIf no date is specified data for the last trading day is being returned.\n",
        "operationId": "PublicApi.OptionContractController.flow",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "An option contract in the OSI format.",
              "example": "TSLA230526P00167500",
              "title": "OptionContract",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "side",
            "required": false,
            "schema": {
              "default": "ALL",
              "description": "The side of a stock trade. Must be one of ASK, BID, MID. If not set, will return all side's trades.",
              "enum": [
                "ALL",
                "ASK",
                "BID",
                "MID"
              ],
              "example": "ASK",
              "title": "Side",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "min_premium",
            "required": false,
            "schema": {
              "default": 0,
              "description": "The minimum premium requested trades should have.",
              "example": 50000,
              "minimum": 0,
              "title": "StockTradesMinPremium",
              "type": "integer"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "description": "How many items to return. If no limit is given, returns all matching data. Min: 1.",
              "example": 10,
              "minimum": 1,
              "title": "Min Limit 1",
              "type": "integer"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
