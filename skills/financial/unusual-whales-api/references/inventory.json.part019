                    "query": {
                      "description": "The URL query segment.",
                      "type": "string"
                    },
                    "url": {
                      "description": "The full URL causing the error.",
                      "type": "string"
                    }
                  },
                  "title": "Error Message",
                  "type": "object"
                }
              }
            },
            "description": "Unprocessable Entity"
