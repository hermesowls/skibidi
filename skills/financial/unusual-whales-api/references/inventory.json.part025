            "schema": {
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "include_filings",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Page number (default 1).",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer"
            }
