    {
      "key": "GET /api/politics/fec/contributions",
      "method": "GET",
      "path": "/api/politics/fec/contributions",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "The company-politics contribution feed. With `aggregated=true` (the default) rows are at the\ncompany × candidate × cycle × tier grain - filter by `ticker` for a company's candidates, or by\n`candidate_id` for a candidate's companies. With `aggregated=false` rows are individual\ncontributions, paginated by `cursor` (pass back `next_cursor` from the previous response);\n`tier` selects `pac` (default) or `employee`.\n\nThis is an enterprise only endpoint. Contact dev@unusualwhales.com for details about accessing this data.\n",
        "operationId": "PublicApi.PoliticsFecController.contributions",
        "parameters": [
          {
            "description": "Default true.",
            "in": "query",
            "name": "aggregated",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "ticker",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "candidate_id",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Politician UUID (aggregated only).",
            "in": "query",
            "name": "politician_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "party",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Two-year election cycle, e.g. 2026. Defaults to the current cycle.",
            "in": "query",
            "name": "cycle",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "pac | employee | all (aggregated default all).",
            "in": "query",
            "name": "tier",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Row-level only.",
            "in": "query",
            "name": "min_amount",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Row-level only, ISO date.",
            "in": "query",
            "name": "min_date",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Row-level only, ISO date.",
            "in": "query",
            "name": "max_date",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Aggregated only: add a totals block.",
            "in": "query",
            "name": "include_totals",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Row-level keyset cursor.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page number (default 1).",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Rows per page (default 50, max 200).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "additionalProperties": true,
                      "description": "With aggregated=true (default), rows are company x candidate x cycle x tier with offset paging. With aggregated=false, rows are individual contributions for one tier, keyset-paginated via next_cursor.",
                      "example": {
                        "aggregated": true,
                        "data": [
                          {
                            "candidate_id": 18342,
                            "candidate_name": "DOE, JANE A.",
                            "company_name": "HOME DEPOT INC",
                            "contribution_count": 4,
                            "cycle": 2026,
                            "first_date": "2025-03-14",
                            "last_date": "2026-06-02",
                            "office": "house",
                            "party": "REP",
                            "politician_id": "1ccb3a38-6243-4c2f-bbcb-5986db785122",
                            "politician_slug": "jane-doe",
                            "state": "MI",
                            "ticker": "HD",
                            "tier": "pac",
                            "total": "12500.00"
                          }
                        ],
                        "limit": 50,
                        "page": 1,
                        "totals": {
                          "contribution_count": 513,
                          "employee_total_estimated": "0",
                          "pac_total": "1611500.00",
                          "total": "1611500.00"
                        }
                      },
                      "title": "Company Politics Contributions",
                      "type": "object"
                    },
                    {
                      "additionalProperties": true,
                      "description": "The aggregated=false response shape: individual contributions for one tier. Pass next_cursor back as cursor to fetch the following page; next_cursor is null on the final page.",
                      "example": {
                        "aggregated": false,
                        "data": [
                          {
                            "amount": "2500.00",
                            "candidate_id": 18342,
                            "candidate_name": "DOE, JANE A.",
                            "committee_name": "THE HOME DEPOT, INC. POLITICAL ACTION COMMITTEE",
                            "company_name": "HOME DEPOT INC",
                            "contribution_id": 218764531,
                            "date": "2026-06-02",
                            "party": "REP",
                            "pdf_url": "https://docquery.fec.gov/cgi-bin/fecimg/?202607159876543210",
                            "report_year": 2026,
                            "ticker": "HD",
                            "tier": "pac"
                          }
                        ],
                        "limit": 50,
                        "next_cursor": "MjAyNjoyMTg3NjQ1MzE",
                        "tier": "pac"
                      },
                      "title": "Company Politics Contribution Rows",
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": ""
          },
