    {
      "key": "GET /api/politics/fec/company/{ticker}/lobbying",
      "method": "GET",
      "path": "/api/politics/fec/company/{ticker}/lobbying",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Lobbying spend per quarter for a company from Senate LDA filings, in-house expenses\n(self-filed reports), and outside income (hired-firm reports) as separate series, with the top\nissue codes per period. `include_filings=true` adds the paginated filing list.\n\nThis is an enterprise only endpoint. Contact dev@unusualwhales.com for details about accessing this data.\n",
        "operationId": "PublicApi.PoliticsFecController.lobbying",
        "parameters": [
          {
            "description": "Company ticker.",
            "in": "path",
            "name": "ticker",
