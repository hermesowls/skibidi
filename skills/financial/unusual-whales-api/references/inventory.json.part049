    {
      "key": "GET /api/stock/{ticker}/stock-state",
      "method": "GET",
      "path": "/api/stock/{ticker}/stock-state",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the last stock state for the given ticker.\n\nThis is the easiest way to retreive the open, close, high, low and volume of the last trading day.\n\nFor the latest trade and national best bid and ask use `/api/stock/{ticker}/quote`. It also returns the quote age,\nmidpoint, spread, spread in basis points, top of book size imbalance and size-weighted midpoint.\n",
        "operationId": "PublicApi.TickerController.last_stock_state",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "The last stock price ticker for the given ticker",
                  "example": {
                    "data": {
                      "close": "56.79",
                      "high": "56.79",
                      "low": "56.79",
                      "market_time": "postmarket",
                      "open": "56.79",
                      "prev_close": "55.69",
                      "tape_time": "2023-09-07 20:11:00+00:00",
                      "total_volume": 13774488,
                      "volume": 500000
                    }
                  },
                  "properties": {
                    "close": {
                      "description": "The close stock price of the ticker.",
                      "example": "182.91",
                      "title": "Stock Close Price",
                      "type": "string"
                    },
                    "high": {
                      "description": "The high stock price of the ticker.",
                      "example": "182.91",
                      "title": "Stock High Price",
                      "type": "string"
                    },
                    "low": {
                      "description": "The low stock price of the ticker.",
                      "example": "182.91",
                      "title": "Stock Low Price",
                      "type": "string"
                    },
                    "market_time": {
                      "description": "The market time of the data",
                      "enum": [
                        "regular",
                        "premarket",
                        "postmarket"
                      ],
                      "example": "regular",
                      "title": "Market Time",
                      "type": "string"
                    },
                    "open": {
                      "description": "The open stock price of the ticker.",
                      "example": "182.91",
                      "title": "Stock Open Price",
                      "type": "string"
                    },
                    "prev_close": {
                      "description": "The previous trading day's stock price of the ticker.",
                      "example": "189.70",
                      "title": "Stock Prev Close Price",
                      "type": "string"
                    },
                    "tape_time": {
                      "description": "The last tape time of the data.",
                      "example": "2023-09-07 20:06:00+00:00",
                      "title": "Stock Last Tape Time",
                      "type": "string"
                    },
                    "total_volume": {
                      "description": "The cumulative stock volume through the trading day.",
                      "example": 23132119,
                      "title": "Cumulative Volume",
                      "type": "integer"
                    },
                    "volume": {
                      "description": "The cumulative total volume of the underlying stock traded.\n",
                      "example": 12348,
                      "title": "Stock Volume",
                      "type": "integer"
                    }
                  },
                  "title": "Stock state",
                  "type": "object"
                }
              }
            },
            "description": "Stock State Response"
          },
