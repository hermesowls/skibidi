    {
      "key": "GET /api/stock/{ticker}/unusualness",
      "method": "GET",
      "path": "/api/stock/{ticker}/unusualness",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "How unusual the ticker's volume is today vs its own trailing ~90 trading days, as a percentile (0-100)\nand decile (1-10) for both regular-session stock volume and total (call + put) option volume. This is\noutlier-robust and comparable across names, unlike a raw volume-vs-average ratio. A metric is null when\nfewer than 30 trailing days of history are available. Defaults to the last market day.\n",
        "operationId": "PublicApi.TickerController.unusualness",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "How unusual a ticker's volume is today, standardised against its own trailing ~90 trading days.\nEach metric is expressed as a percentile (0-100) and a decile (1-10) — outlier-robust and comparable\nacross names, unlike a raw volume-vs-average ratio. `stock` covers regular-session share volume;\n`option` covers total (call + put) option volume. `samples` is the number of trailing days used\n(a metric is null when fewer than 30 days of history are available).\n",
                  "example": {
                    "data": {
                      "date": "2026-09-02",
                      "opt_samples": 91,
                      "opt_vol_decile": 4,
                      "opt_vol_pctile": 34.1,
                      "stock_samples": 91,
                      "stock_vol_decile": 9,
                      "stock_vol_pctile": 81.3
                    }
                  },
                  "properties": {
                    "date": {
                      "description": "An ISO date.",
                      "example": "2024-01-09",
                      "title": "General ISO Date",
                      "type": "string"
                    },
                    "opt_samples": {
                      "description": "Trailing days used for the option-volume percentile.",
                      "type": "integer"
                    },
                    "opt_vol_decile": {
                      "description": "Option-volume decile (1-10).",
                      "type": "integer"
                    },
                    "opt_vol_pctile": {
                      "description": "Option-volume (call+put) percentile (0-100) vs the ticker's own ~90-day history.",
                      "type": "number"
                    },
                    "stock_samples": {
                      "description": "Trailing days used for the stock-volume percentile.",
                      "type": "integer"
                    },
                    "stock_vol_decile": {
                      "description": "Stock-volume decile (1-10).",
                      "type": "integer"
                    },
                    "stock_vol_pctile": {
                      "description": "Stock-volume percentile (0-100) vs the ticker's own ~90-day history.",
                      "type": "number"
                    }
                  },
                  "title": "Volume Unusualness",
                  "type": "object"
                }
              }
            },
            "description": "Volume Unusualness Response"
          },
