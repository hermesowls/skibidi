    {
      "key": "GET /api/stock/{ticker}/technical-indicator/{function}",
      "method": "GET",
      "path": "/api/stock/{ticker}/technical-indicator/{function}",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns any technical indicator time series for a ticker. Supports international stocks and OTC.\n\n**Supported functions:** SMA, EMA, WMA, DEMA, TEMA, TRIMA, KAMA, MAMA, T3, MACD, MACDEXT, STOCH, STOCHF, RSI, STOCHRSI, WILLR, ADX, ADXR, APO, PPO, MOM, BOP, CCI, CMO, ROC, ROCR, AROON, AROONOSC, MFI, TRIX, ULTOSC, DX, MINUS_DI, PLUS_DI, MINUS_DM, PLUS_DM, BBANDS, MIDPOINT, MIDPRICE, SAR, TRANGE, ATR, NATR, AD, ADOSC, OBV, HT_TRENDLINE, HT_SINE, HT_TRENDMODE, HT_DCPERIOD, HT_DCPHASE, HT_PHASOR, VWAP.\n\nNot all parameters apply to every function. For example, STOCH and BOP only use `interval`, while RSI uses all three (`interval`, `time_period`, `series_type`).\n\nThe `month` parameter is only relevant for intraday intervals (1min, 5min, 15min, 30min, 60min). For daily/weekly/monthly intervals, full history is returned and `month` is ignored.\n",
        "operationId": "PublicApi.AvFundamentalController.technical_indicator",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "path",
            "name": "function",
            "required": true,
            "schema": {
              "description": "The technical indicator function name (e.g. RSI, SMA, MACD, BBANDS)",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "interval",
            "required": false,
            "schema": {
              "default": "daily",
              "description": "Time interval between data points",
              "enum": [
                "1min",
                "5min",
                "15min",
                "30min",
                "60min",
                "daily",
                "weekly",
                "monthly"
              ],
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "time_period",
            "required": false,
            "schema": {
              "default": 14,
              "description": "Number of data points used to calculate the indicator (e.g. 14 for RSI, 20 for SMA)",
              "type": "integer"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "series_type",
            "required": false,
            "schema": {
              "default": "close",
              "description": "The price type used in the calculation",
              "enum": [
                "close",
                "open",
                "high",
                "low"
              ],
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "month",
            "required": false,
            "schema": {
              "description": "Target month for intraday data in YYYY-MM format (e.g. 2026-02). Only applies to intraday intervals.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "description": "One data point for a technical indicator. Indicator values are numeric strings under `values`.",
                        "properties": {
                          "date": {
                            "example": "2026-01-03",
                            "format": "date",
                            "type": "string"
                          },
                          "indicator": {
                            "example": "MACD",
                            "type": "string"
                          },
                          "interval": {
                            "example": "daily",
                            "type": "string"
                          },
                          "series_type": {
                            "example": "close",
                            "type": "string"
                          },
                          "ticker": {
                            "example": "AAPL",
                            "type": "string"
                          },
                          "time_period": {
                            "example": 14,
                            "type": "integer"
                          },
                          "values": {
                            "additionalProperties": {
                              "type": "string"
                            },
                            "description": "Indicator output values keyed by AlphaVantage's labels for the requested function. Keys vary by function (e.g. a single \"RSI\", or \"MACD\"/\"MACD_Signal\"/\"MACD_Hist\").",
                            "example": {
                              "MACD": "1.2345",
                              "MACD_Hist": "0.2469",
                              "MACD_Signal": "0.9876"
                            },
                            "type": "object"
                          }
                        },
                        "title": "Technical Indicator Point",
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "title": "Technical Indicator Response",
                  "type": "object"
                }
              }
            },
            "description": "Technical Indicator"
          },
