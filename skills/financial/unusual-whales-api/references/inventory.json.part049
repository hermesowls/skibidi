                            "title": "Stock Off Lit Volume",
                            "type": "integer"
                          },
                          "price": {
                            "description": "The exact execution price level.",
                            "format": "double",
                            "type": "number"
                          }
                        },
                        "title": "Off Lit Price Level",
                        "type": "object"
                      },
                      "type": "array"
