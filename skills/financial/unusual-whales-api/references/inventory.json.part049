    {
      "key": "GET /api/stock/{ticker}/stock-volume-price-levels",
      "method": "GET",
      "path": "/api/stock/{ticker}/stock-volume-price-levels",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the lit & off lit stock volume per price level for the given ticker.\n\n----\nImportant: The volume does **NOT** represent the full market dialy volume. It\nonly represents the volume of executed trades on exchanges operated by Nasdaq\nand FINRA off lit exchanges.\n",
