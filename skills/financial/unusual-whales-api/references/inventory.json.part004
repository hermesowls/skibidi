      "operation": {
        "callbacks": {},
        "description": "Returns trade points (with price context) and SPY daily closes over the requested date range,\nsuitable for plotting congressional trade activity against the broader market.\nDefaults to the last ~4 months when no range is supplied.\n\nThis is a premium endpoint. Contact dev@unusualwhales.com to request access.\n",
        "operationId": "PublicApi.UnusualTradesController.chart_data",
        "parameters": [
          {
            "description": "Inclusive lower bound on transaction_date (ISO 8601).",
            "in": "query",
            "name": "date_from",
            "required": false,
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "Inclusive upper bound on transaction_date (ISO 8601).",
            "in": "query",
            "name": "date_to",
            "required": false,
            "schema": {
              "format": "date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "spy_prices": {
                      "items": {
                        "properties": {
                          "close": {
                            "type": "number"
                          },
                          "date": {
                            "format": "date",
                            "type": "string"
                          }
                        },
                        "title": "SPY Daily Close",
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "trades": {
                      "items": {
                        "properties": {
                          "amount": {
                            "type": "string"
                          },
                          "asset_type": {
                            "example": "stock",
                            "type": "string"
                          },
                          "company_name": {
                            "example": "NVIDIA Corp",
                            "type": "string"
                          },
                          "filing_date": {
                            "format": "date",
                            "type": "string"
                          },
                          "id": {
                            "format": "uuid",
                            "type": "string"
                          },
                          "is_unusual": {
                            "type": "boolean"
                          },
                          "mid_value": {
                            "nullable": true,
                            "type": "number"
                          },
                          "politician_name": {
                            "example": "Nancy Pelosi",
                            "type": "string"
                          },
                          "price_at_trade": {
                            "nullable": true,
                            "type": "number"
                          },
                          "price_current": {
                            "nullable": true,
                            "type": "number"
                          },
                          "sector": {
                            "example": "Technology",
                            "nullable": true,
                            "type": "string"
                          },
                          "ticker": {
                            "example": "NVDA",
                            "type": "string"
                          },
                          "transaction_date": {
                            "format": "date",
                            "type": "string"
                          },
                          "transaction_type": {
                            "example": "Buy",
                            "type": "string"
                          },
                          "unusual_activity_tags": {
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          }
                        },
                        "title": "Unusual Trade Chart Point",
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "title": "Unusual Trades Chart Data",
                  "type": "object"
                }
              }
            },
            "description": "Unusual Trades Chart Data"
