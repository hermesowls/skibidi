    {
      "key": "GET /api/congress/unusual-trades",
      "method": "GET",
      "path": "/api/congress/unusual-trades",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns congressional trades that have been flagged as unusual, optionally filtered by reason tags.\nSupported `types` values include `committee_conflict`, `first_person_to_trade`, `low_marketcap`,\n`unusual_industry`, `unusually_large_trade`, and `fec_donation_conflict`.\n\nThis is a premium endpoint. Contact dev@unusualwhales.com to request access.\n",
        "operationId": "PublicApi.UnusualTradesController.recent",
        "parameters": [
          {
            "description": "Comma-separated list of unusual-activity tags to filter by. Returns all unusual trades when omitted.",
            "in": "query",
            "name": "types",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Number of results per page (max 500).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Page number (1-indexed).",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "properties": {
                          "amount": {
                            "description": "The disclosed amount range as a string.",
                            "example": "$1,001 - $15,000",
                            "type": "string"
                          },
                          "asset": {
                            "description": "Asset description as disclosed.",
                            "example": "NVIDIA Corp - Common Stock",
                            "type": "string"
                          },
                          "asset_type": {
                            "description": "The asset type.",
                            "example": "stock",
                            "type": "string"
                          },
                          "company_name": {
                            "description": "The full company name behind the traded ticker.",
                            "example": "NVIDIA Corp",
                            "type": "string"
                          },
                          "description": {
                            "description": "Additional disclosure description, if any.",
                            "nullable": true,
                            "type": "string"
                          },
                          "filing_date": {
                            "description": "The date the trade was disclosed.",
                            "example": "2025-10-04",
                            "format": "date",
                            "type": "string"
                          },
                          "id": {
                            "description": "The trade's unique ID.",
                            "example": "5fbe81ac-1157-4bc8-9d76-c77e6164fe25",
                            "format": "uuid",
                            "type": "string"
                          },
                          "politician_id": {
                            "description": "The politician's ID.",
                            "example": "e138f347-ae92-4cfb-8f41-7036ff09a213",
                            "format": "uuid",
                            "type": "string"
                          },
                          "politician_name": {
                            "description": "The politician's full name.",
                            "example": "Nancy Pelosi",
                            "type": "string"
                          },
                          "ticker": {
                            "description": "The traded ticker symbol.",
                            "example": "NVDA",
                            "type": "string"
                          },
                          "transaction_date": {
                            "description": "The date the transaction occurred.",
                            "example": "2025-09-12",
                            "format": "date",
                            "type": "string"
                          },
                          "transaction_type": {
                            "description": "The type of transaction (e.g., Buy, Sell, Sale Partial).",
                            "example": "Buy",
                            "type": "string"
                          },
                          "unusual_activity_meta": {
                            "description": "Per-tag metadata explaining why each flag was applied.",
                            "items": {
                              "type": "object"
                            },
                            "type": "array"
                          },
                          "unusual_activity_tags": {
                            "description": "Reason tags this trade was flagged as unusual.",
                            "example": [
                              "committee_conflict"
                            ],
                            "items": {
                              "enum": [
                                "committee_conflict",
                                "first_person_to_trade",
                                "low_marketcap",
                                "unusual_industry",
                                "unusually_large_trade",
                                "fec_donation_conflict"
                              ],
                              "type": "string"
                            },
                            "type": "array"
                          }
                        },
                        "title": "Unusual Congressional Trade",
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "title": "Unusual Trades",
                  "type": "object"
                }
              }
            },
            "description": "Unusual Trades"
          },
