                      "type": "boolean"
                    },
                    "support_email": {
                      "description": "Where to send questions about API access.",
                      "type": "string"
                    },
                    "token_url": {
                      "description": "Where to create and manage API tokens.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "title": "Forbidden Error",
                  "type": "object"
                }
              }
            },
            "description": "Forbidden"
          },
