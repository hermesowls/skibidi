                                  "type": "integer"
                                },
                                "quote_changes": {
                                  "description": "Updates where at least one bid or ask price or size changed.",
                                  "example": 1255891,
                                  "format": "int64",
                                  "type": "integer"
                                },
                                "size_only_changes": {
                                  "description": "Quote changes where size changed but bid and ask prices did not.",
                                  "example": 1110077,
                                  "format": "int64",
                                  "type": "integer"
                                },
                                "spread_tightened": {
                                  "description": "Quote changes where the ask minus bid spread decreased.",
                                  "example": 74875,
                                  "format": "int64",
                                  "type": "integer"
                                },
                                "spread_unchanged": {
                                  "description": "Quote changes where the ask minus bid spread did not change.",
                                  "example": 1110077,
                                  "format": "int64",
                                  "type": "integer"
                                },
                                "spread_widened": {
                                  "description": "Quote changes where the ask minus bid spread increased.",
                                  "example": 70939,
                                  "format": "int64",
                                  "type": "integer"
                                }
                              },
                              "required": [
                                "midpoint_changes",
                                "quote_changes",
                                "size_only_changes",
                                "spread_tightened",
                                "spread_unchanged",
                                "spread_widened"
                              ],
                              "title": "Stock Quote Session Statistics",
                              "type": "object"
                            }
                          },
                          "required": [
                            "premarket",
                            "regular",
                            "postmarket"
                          ],
                          "title": "Stock Quote Statistics",
                          "type": "object"
                        },
                        "quote_values": {
                          "properties": {
                            "midpoint": {
                              "description": "Arithmetic mean of the best bid and ask prices.",
                              "example": "775.655",
                              "type": "string"
                            },
                            "quote_age_ms": {
                              "description": "Milliseconds since the latest quote update when this response was generated.",
                              "example": 89,
                              "format": "int64",
                              "type": "integer"
                            },
                            "size_imbalance": {
                              "description": "Top of book size imbalance. Positive values indicate more displayed bid size.",
                              "example": 0.5238095238095238,
                              "format": "double",
                              "maximum": 1,
                              "minimum": -1,
                              "nullable": true,
                              "type": "number"
                            },
                            "size_weighted_midpoint": {
                              "description": "Midpoint adjusted toward the side opposite the greater displayed size.",
                              "example": 775.657619047619,
                              "format": "double",
                              "nullable": true,
                              "type": "number"
                            },
                            "spread": {
                              "description": "Best ask price minus best bid price.",
                              "example": "0.010",
                              "type": "string"
                            },
                            "spread_bps": {
                              "description": "Quoted spread relative to the midpoint, expressed in basis points.",
                              "example": 0.12892329708428238,
                              "format": "double",
                              "nullable": true,
                              "type": "number"
                            }
                          },
                          "required": [
                            "midpoint",
                            "spread",
                            "quote_age_ms"
                          ],
                          "title": "Derived Stock Quote Values",
                          "type": "object",
                          "description": "Values derived from the latest quote, or null when no quote is available.",
                          "nullable": true
                        }
                      },
                      "required": [
