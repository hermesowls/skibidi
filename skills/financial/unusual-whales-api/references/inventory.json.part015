            "required": false,
            "schema": {
              "default": 100,
              "description": "How many items to return. Default: 100. Max: 200. Min: 1.",
              "example": 10,
              "maximum": 200,
              "minimum": 1,
              "title": "Default 100 Max 200 Min 1",
              "type": "integer"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
