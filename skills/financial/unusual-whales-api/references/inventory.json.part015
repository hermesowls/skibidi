                      "title": "Single Trade Settlement",
                      "type": "string"
                    },
                    "volume": {
                      "description": "The volume of the ticker for the trading day.",
                      "example": 23132119,
                      "title": "Stock Day Stock Volume",
                      "type": "integer"
                    }
                  },
                  "title": "Lit Trade",
                  "type": "object"
                }
              }
