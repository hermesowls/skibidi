                        "ext_hour_sold_codes": null,
                        "market_center": "N",
                        "nbbo_ask": "185.52",
                        "nbbo_ask_quantity": 300,
                        "nbbo_bid": "185.48",
                        "nbbo_bid_quantity": 600,
                        "premium": "927400.00",
                        "price": "185.48",
                        "sale_cond_codes": "regular_sale",
                        "size": 5000,
                        "ticker": "AAPL",
                        "tracking_id": 71984384768588,
                        "trade_code": null,
                        "trade_settlement": "regular_settlement",
                        "volume": 15936819
                      }
                    ]
                  },
                  "properties": {
