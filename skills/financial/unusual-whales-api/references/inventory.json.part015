              "example": 150000,
              "title": "StockTradesMaxSize",
              "type": "integer"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "min_volume",
            "required": false,
            "schema": {
              "default": 0,
              "description": "The minimum consolidated volume requested trades should have. Must be a positive integer.",
              "example": 50000,
              "minimum": 0,
