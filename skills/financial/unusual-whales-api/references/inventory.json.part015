    {
      "key": "GET /api/market/correlations",
      "method": "GET",
      "path": "/api/market/correlations",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the correlations between a list of tickers.\nDate must be the current or a past date. If no date is given, returns data for the current/last market day.\n\nYou can filter the time period either by:\n1. Using the `interval` parameter (e.g. \"1y\", \"6m\", \"3m\", \"1m\")\n2. Using `start_date` and optionally `end_date` (if `end_date` is not provided, it defaults to the current date)\n\nIf you send `interval` alongside `start_date`, `interval` filter will take priority.\n",
        "operationId": "PublicApi.MarketController.correlations",
        "parameters": [
          {
            "description": "",
            "in": "query",
            "name": "tickers",
            "required": true,
            "schema": {
              "description": "A comma separated list of tickers. To exclude certain tickers prefix the first ticker with a `-`.",
              "example": "AAPL,INTC",
              "title": "Ticker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "interval",
            "required": false,
            "schema": {
              "default": "1Y",
              "description": "The timeframe of the data to return.\nCan be one of the following formats:\n- YTD\n- 1D, 2D, etc.\n- 1W, 2W, etc.\n- 1M, 2M, etc.\n- 1Y, 2Y, etc.\n",
              "example": "2M",
              "title": "Time frame",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "start_date",
            "required": false,
            "schema": {
              "description": "A date in the format of YYYY-MM-DD to start the correlation calculation from.\nThis is optional and works alongside end_date to define a specific time range.\nCan be used as an alternative to the interval parameter.\n",
              "example": "2023-01-01",
              "format": "date",
              "title": "Correlation Start Date",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "end_date",
            "required": false,
            "schema": {
              "description": "A date in the format of YYYY-MM-DD to end the correlation calculation.\nThis is optional and defaults to the current date when start_date is provided.\nWorks alongside start_date to define a specific time range.\nCan be used as an alternative to the interval parameter.\n",
              "example": "2023-12-31",
              "format": "date",
              "title": "Correlation End Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "A list of correlations\n",
                  "example": {
                    "data": [
                      {
                        "correlation": 0.27936797861890483,
                        "fst": "AAPL",
                        "max_date": "2024-07-11",
                        "min_date": "2023-07-11",
                        "rows": 253,
                        "snd": "SPY"
                      },
                      {
                        "correlation": 0.279367978618901,
                        "fst": "SPY",
                        "max_date": "2024-07-11",
                        "min_date": "2023-07-11",
                        "rows": 253,
                        "snd": "AAPL"
                      }
                    ]
                  },
                  "properties": {
                    "correlation": {
                      "$ref": "#/components/schemas/Correlation"
                    },
                    "fst": {
                      "description": "The stock ticker.",
                      "example": "AAPL",
                      "title": "Stock Ticker",
                      "type": "string"
                    },
                    "max_date": {
                      "description": "An ISO date.",
                      "example": "2024-01-09",
                      "title": "General ISO Date",
                      "type": "string"
                    },
                    "min_date": {
                      "description": "An ISO date.",
                      "example": "2024-01-09",
                      "title": "General ISO Date",
                      "type": "string"
                    },
                    "rows": {
                      "description": "The amount of data points considered.",
                      "example": "100",
                      "title": "Count of data points",
                      "type": "integer"
                    },
                    "snd": {
                      "description": "The stock ticker.",
                      "example": "AAPL",
                      "title": "Stock Ticker",
                      "type": "string"
                    }
                  },
                  "title": "Correlation",
                  "type": "object"
                }
              }
            },
            "description": ""
          },
