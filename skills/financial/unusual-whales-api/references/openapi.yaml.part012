            example: 0.01
            type: integer
        - description: ''
          in: query
          name: max_fee_rate
          required: false
          schema:
            description: The max fee rate.
            example: 0.45
            type: integer
        - description: ''
          in: query
          name: min_rebate_rate
          required: false
