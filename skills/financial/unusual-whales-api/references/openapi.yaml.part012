  /api/short_screener:
    get:
      callbacks: {}
      description: |
        Returns short interest and float data for percentage calculations based off search params.
        This endpoint provides information about the percentage of float that is shorted,
        the float size, and the days to cover metric.
      operationId: PublicApi.ShortController.short_screener
      parameters:
        - description: ''
          in: query
          name: tickers
          required: false
          schema:
            $ref: '#/components/schemas/Ticker'
        - description: ''
          in: query
          name: limit
          required: false
          schema:
            default: 100
            description: 'The limit of results. Default: 100. Max: 500. Min: 0.'
            example: 125
            maximum: 500
            minimum: 0
            type: integer
        - description: ''
          in: query
          name: offset
          required: false
          schema:
            default: 0
            description: 'The offset of results. Default: 0. Min: 0.'
            example: 100
            minimum: 0
            type: integer
        - description: ''
          in: query
          name: min_short_interest
          required: false
          schema:
            description: The min short interest.
            example: 5000
            type: integer
        - description: ''
          in: query
          name: max_short_interest
          required: false
          schema:
            description: The max short interest.
            example: 100000
            type: integer
        - description: ''
          in: query
          name: min_days_to_cover
          required: false
          schema:
            description: The min days to cover.
            example: 1.1
            type: integer
        - description: ''
          in: query
          name: max_days_to_cover
          required: false
          schema:
            description: The max days to cover.
            example: 5.3
            type: integer
        - description: ''
          in: query
          name: min_si_float
          required: false
          schema:
            description: The min short interest float ratio.
            example: 0.1
            type: integer
        - description: ''
          in: query
          name: max_si_float
          required: false
          schema:
            description: The max short interest float ratio.
            example: 0.05
            type: integer
        - description: ''
          in: query
          name: min_si_float_with_synth_long_pct_of_total_shares
          required: false
          schema:
            description: The min si_float_with_synth_long_pct_of_total_shares.
            example: 0.05
            type: integer
        - description: ''
          in: query
          name: max_si_float_with_synth_long_pct_of_total_shares
          required: false
          schema:
            description: The max si_float_with_synth_long_pct_of_total_shares.
            example: 0.05
            type: integer
        - description: ''
          in: query
          name: min_total_float
          required: false
          schema:
            description: The min total float.
            example: 10000000
            type: integer
        - description: ''
          in: query
          name: max_total_float
          required: false
          schema:
            description: The max total float.
            example: 100000000
            type: integer
        - description: ''
          in: query
          name: order_by
          required: false
          schema:
            $ref: '#/components/schemas/ShortScreenerOrderBy'
        - description: ''
          in: query
          name: order_direction
          required: false
          schema:
            $ref: '#/components/schemas/OrderDirection'
        - description: ''
          in: query
          name: min_market_date
          required: false
          schema:
            $ref: '#/components/schemas/Market_Date'
        - description: ''
          in: query
          name: max_market_date
          required: false
          schema:
            $ref: '#/components/schemas/Market_Date'
        - description: ''
          in: query
          name: min_fee_rate
          required: false
