    {
      "key": "GET /api/stock/{ticker}/volatility/variance-risk-premium/windows",
      "method": "GET",
      "path": "/api/stock/{ticker}/volatility/variance-risk-premium/windows",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns every variance risk premium horizon with an implied volatility observation date in the requested\ncalendar lookback. `history_days` defaults to 365 and cannot exceed 365. Rows are ordered by observation\ndate from newest to oldest. Each row includes the realized volatility completion date.\n",
        "operationId": "PublicApi.VolatilityController.variance_risk_premium_windows",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "history_days",
            "required": false,
            "schema": {
              "default": 365,
              "description": "Return volatility window rows from this many calendar days before the requested date.",
              "example": 30,
              "maximum": 365,
              "minimum": 1,
              "title": "VolatilityWindowHistoryDays",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "A variance risk premium calculated as implied volatility minus realized volatility for mapped horizons.",
                  "properties": {
                    "date": {
                      "example": "2026-08-10",
                      "format": "date",
                      "type": "string"
                    },
                    "implied_volatility": {
                      "example": "0.263456",
                      "type": "string"
                    },
                    "implied_volatility_days": {
                      "example": 30,
                      "type": "integer"
                    },
                    "rank": {
                      "description": "The percentile rank among values for the same ticker and horizon pair that completed during the preceding year. Values range from 0 to 1. The value is null when a rank has not been calculated.",
                      "example": "0.75",
                      "nullable": true,
                      "type": "string"
                    },
                    "realized_date": {
                      "example": "2026-09-08",
                      "format": "date",
                      "type": "string"
                    },
                    "realized_volatility": {
                      "example": "0.213456",
                      "type": "string"
                    },
                    "realized_volatility_days": {
                      "example": 21,
                      "type": "integer"
                    },
                    "risk_premium": {
                      "example": "0.05",
                      "type": "string"
                    },
                    "ticker": {
                      "example": "AAPL",
                      "type": "string"
                    }
                  },
                  "title": "Variance Risk Premium Window",
                  "type": "object"
                }
              }
            },
            "description": ""
          },
