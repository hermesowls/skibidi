    {
      "key": "GET /api/stock/{ticker}/volatility/variance-risk-premium",
      "method": "GET",
      "path": "/api/stock/{ticker}/volatility/variance-risk-premium",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns variance risk premium history for a ticker. `days` selects the realized volatility horizon in\ntrading days. The default is 21 trading days paired with 30 calendar days of implied volatility.\n",
        "operationId": "PublicApi.VolatilityController.variance_risk_premium",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 21,
              "description": "Select the realized volatility horizon in trading days.",
              "enum": [
                1,
                3,
                5,
                10,
                21,
                42,
                63,
                126,
                251
              ],
              "example": 21,
              "title": "RealizedVolatilityDays",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "A variance risk premium calculated as implied volatility minus realized volatility for mapped horizons.",
                  "properties": {
                    "date": {
                      "example": "2026-08-10",
                      "format": "date",
                      "type": "string"
                    },
                    "implied_volatility": {
                      "example": "0.263456",
                      "type": "string"
                    },
                    "implied_volatility_days": {
                      "example": 30,
                      "type": "integer"
                    },
                    "rank": {
                      "description": "The percentile rank among values for the same ticker and horizon pair that completed during the preceding year. Values range from 0 to 1. The value is null when a rank has not been calculated.",
                      "example": "0.75",
                      "nullable": true,
                      "type": "string"
                    },
                    "realized_date": {
                      "example": "2026-09-08",
                      "format": "date",
                      "type": "string"
                    },
                    "realized_volatility": {
                      "example": "0.213456",
                      "type": "string"
                    },
                    "realized_volatility_days": {
                      "example": 21,
                      "type": "integer"
                    },
                    "risk_premium": {
                      "example": "0.05",
                      "type": "string"
                    },
                    "ticker": {
                      "example": "AAPL",
                      "type": "string"
                    }
                  },
                  "title": "Variance Risk Premium Window",
                  "type": "object"
                }
              }
            },
            "description": ""
          },
