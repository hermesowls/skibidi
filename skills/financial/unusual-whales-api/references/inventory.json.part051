    {
      "key": "GET /api/stock/{ticker}/volatility/term-structure/distribution",
      "method": "GET",
      "path": "/api/stock/{ticker}/volatility/term-structure/distribution",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns one row per expiry with the range of that expiry's at the money implied volatility over the\n365 calendar days ending on `date`. Each row holds the minimum, first quartile, median, third quartile\nand maximum of the daily values, the value on `date`, and the share of daily values at or below it.\n\nThe response covers expiries after `date` and at most 365 days after it. An expiry without a value on\n`date` is omitted. Expiries listed recently have few daily values, so check `samples` before comparing\nranges. Rows are ordered by expiry from nearest to furthest. `date` defaults to the last trading day.\n",
        "operationId": "PublicApi.VolatilityController.term_structure_distribution",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "The range of one expiry's at the money implied volatility over the 365 calendar days ending on `date`. Volatility values are annualized decimals, so `0.43` means 43%.",
                  "properties": {
                    "date": {
                      "example": "2026-09-18",
                      "format": "date",
                      "type": "string"
                    },
                    "dte": {
                      "description": "The number of calendar days from `date` to `expiry`.",
                      "example": 91,
                      "type": "integer"
                    },
                    "expiry": {
                      "example": "2026-12-18",
                      "format": "date",
                      "type": "string"
                    },
                    "first_date": {
                      "description": "The earliest trading day included in the lookback for the expiry.",
                      "example": "2025-09-19",
                      "format": "date",
                      "type": "string"
                    },
                    "max": {
                      "description": "The highest daily value in the lookback.",
                      "example": "0.595370292271564",
                      "type": "string"
                    },
                    "median": {
                      "description": "The median of the daily values, interpolated linearly and rounded to 6 decimals.",
                      "example": "0.491979",
                      "type": "string"
                    },
                    "min": {
                      "description": "The lowest daily value in the lookback.",
                      "example": "0.4291603363676975",
                      "type": "string"
                    },
                    "percentile": {
                      "description": "The share of daily values at or below `volatility`, from 0 to 1. The value on `date` counts as one of the daily values.",
                      "example": "0.0080",
                      "type": "string"
                    },
                    "q1": {
                      "description": "The first quartile of the daily values, interpolated linearly and rounded to 6 decimals.",
                      "example": "0.474857",
                      "type": "string"
                    },
                    "q3": {
                      "description": "The third quartile of the daily values, interpolated linearly and rounded to 6 decimals.",
                      "example": "0.548378",
                      "type": "string"
                    },
                    "samples": {
                      "description": "The number of daily values in the lookback, one per trading day with a value for the expiry.",
                      "example": 251,
                      "type": "integer"
                    },
                    "ticker": {
                      "example": "TSLA",
                      "type": "string"
                    },
                    "volatility": {
                      "description": "The implied volatility of the expiry on `date`. It is the average of the latest call and put implied volatility at the at the money strike.",
                      "example": "0.4295974677151735",
                      "type": "string"
                    }
                  },
                  "title": "Implied Volatility Term Structure Distribution",
                  "type": "object"
                }
              }
            },
            "description": ""
          },
