    {
      "key": "GET /api/stock/{ticker}/greek-exposure",
      "method": "GET",
      "path": "/api/stock/{ticker}/greek-exposure",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Greek Exposure is the assumed greek exposure that market makers are exposed to.\n\nThe most popular greek exposure is gamma exposure (GEX).\n\nInvestors and large funds lower risk and protect their money by selling calls and buying puts. Market makers provide the liquidity to facilitate these trades.\n\nGEX assumes that market makers are part of every transaction and that the bulk of their transactions are buying calls and selling puts to investors hedging their portfolios.\n\nIf a market maker has one contract open with a gamma value of 0.05, then that market maker is exposed to 0.05 * [100 shares] of gamma. The total market maker exposure is calculated by summing up the exposure values of all open contracts determined by the daily open interest.\n\nMarket makers profit from the bid-ask spreads and as such, they constantly gamma hedge (they buy and sell shares to keep their positions delta neutral).\n\nLong call positions are positive gamma - as the stock price increases and delta rises (approaches 1), market makers hedge by selling shares, and they buy shares if the stock price decreases and delta falls.\n\nShort put positions are negative gamma - as the stock price increases and delta falls (approaches -1), market makers hedge by buying shares, and they sell shares if the stock price decreases and delta rises.\n\nAs such, in the event of large positive gamma, volatility is suppressed as market makers will hedge by buying as the stock price decreases and selling as the stock price increases. And in the event of large negative gamma, volatility is amplified as market makers will hedge by buying as the stock price increases and selling as the stock price decreases.\n\nThis data updates once per day at market open.\n",
        "operationId": "PublicApi.TickerController.greek_exposure",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "timeframe",
            "required": false,
            "schema": {
              "default": "1Y",
              "description": "The timeframe of the data to return.\nCan be one of the following formats:\n- YTD\n- 1D, 2D, etc.\n- 1W, 2W, etc.\n- 1M, 2M, etc.\n- 1Y, 2Y, etc.\n",
              "example": "2M",
              "title": "Time frame",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "",
                  "example": {
                    "data": [
                      {
                        "call_charm": "102382359.5786",
                        "call_delta": "227549667.4651",
                        "call_gamma": "9356683.4241",
                        "call_vanna": "152099632406.9564",
                        "date": "2023-09-08",
                        "put_charm": "-943028472.4815",
                        "put_delta": "-191893077.7193",
                        "put_gamma": "-12337386.0524",
                        "put_vanna": "488921784213.1121"
                      },
                      {
                        "call_charm": "81465130.0002",
                        "call_delta": "210202465.3421",
                        "call_gamma": "8456599.8505",
                        "call_vanna": "161231587973.6811",
                        "date": "2023-09-07",
                        "put_charm": "-1054548432.6111",
                        "put_delta": "-210881557.3003",
                        "put_gamma": "-12703877.0243",
                        "put_vanna": "488921784213.1121"
                      }
                    ]
                  },
                  "properties": {
                    "call_charm": {
                      "description": "The sum of the charm values of all call transactions that executed multiplied by the open interest and the number of shares per contract (typically 100 shares per contract).",
                      "example": "102382359.5786",
                      "title": "Gex Call Charm",
                      "type": "string"
                    },
                    "call_delta": {
                      "description": "The sum of the delta values of all call transactions that executed multiplied by the open interest and the number of shares per contract (typically 100 shares per contract).",
                      "example": "227549667.4651",
                      "title": "Gex Call Delta",
                      "type": "string"
                    },
                    "call_gamma": {
                      "description": "The sum of the gamma values of all call transactions that executed multiplied by the open interest and the number of shares per contract (typically 100 shares per contract).",
                      "example": "9356683.4241",
                      "title": "Gex Call Gamma",
                      "type": "string"
                    },
                    "call_vanna": {
                      "description": "The sum of the vanna values of all call transactions that executed multiplied by the open interest and the number of shares per contract (typically 100 shares per contract).",
                      "example": "152099632406.9564",
                      "title": "Gex Call Vanna",
                      "type": "string"
                    },
                    "date": {
                      "description": "A trading date in ISO format.\n",
                      "example": "2023-09-08",
                      "title": "Market General Trading day",
                      "type": "string"
                    },
                    "put_charm": {
                      "description": "The sum of the charm values of all put transactions that executed multiplied by the open interest and the number of shares per contract (typically 100 shares per contract).",
                      "example": "-943028472.4815",
                      "title": "Gex Put Charm",
                      "type": "string"
