unts, RSU data, and revenue breakdowns by product and geography.
      operationId: PublicApi.FundamentalController.show
      parameters:
        - description: ''
          in: path
          name: ticker
          required: true
          schema:
            $ref: '#/components/schemas/SingleTicker'
