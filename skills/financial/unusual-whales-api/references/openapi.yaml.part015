        - description: Max rows (default 50, max 200).
          in: query
          name: limit
          required: false
          schema:
            type: integer
        - description: '`half_life` (default), `hurst`, or `neg_entropy`.'
          in: query
          name: sort
          required: false
          schema:
            type: string
        - description: '`asc` (default) or `desc`.'
          in: query
          name: dir
          required: false
