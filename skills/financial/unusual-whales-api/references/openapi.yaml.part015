          required: true
          schema:
            $ref: '#/components/schemas/SingleTicker'
        - description: ''
          in: query
          name: date
          required: false
          schema:
            $ref: '#/components/schemas/Optional_Market_Date'
        - description: ''
          in: query
          name: history_days
          required: false
          schema:
            $ref: '#/components/schemas/VolatilityWindowHistoryDays'
      responses:
