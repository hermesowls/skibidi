    {
      "key": "GET /api/alerts/filters",
      "method": "GET",
      "path": "/api/alerts/filters",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the available filters for creating alert configurations:\n- `data`: per alert type (`noti_type`) the filter fields that can be used in the `config` object, each with its accepted values\n- `access`: per alert type whether your account can create alerts of that type\n- `noti_type_descriptions`: a description of each alert type\n- `filter_descriptions`: per alert type a description of each filter field\n- `rate_limits`: per alert type the maximum amount of alerts that trigger per day\n\nUse this endpoint to determine which alert types the account can access and to build a structured `config` object.\nSubmit the resulting `noti_type` and `config` to `POST /api/alerts/configuration` to create an alert.\n\nFor more complex filters, fetch the Query language syntax and fields from `GET /api/alerts/query/grammar`,\nthen submit the Query expression to `POST /api/alerts/configuration` using `input` instead of `config`.\nThe `config` and `input` fields are mutually exclusive.\n",
        "operationId": "PublicApi.AlertsController.filters",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "The available filters per alert type for creating alert configurations",
                  "example": {
                    "access": {
                      "flow_alerts": true,
                      "option_trade": true,
                      "politician_trades": false
                    },
                    "data": {
                      "option_trade": [
                        {
                          "accepted_values": [
                            "all",
                            "watchlist_only",
                            "list"
                          ],
                          "filter": "symbols"
                        },
                        {
                          "accepted_values": "list",
                          "filter": "option_contracts"
                        },
                        {
                          "accepted_values": "bool",
                          "description": "Filter for options expiring on OpEx (monthly expiration) Friday",
                          "filter": "opex_only"
                        },
                        {
                          "accepted_values": "bool",
                          "description": "Filter for options expiring on a quarterly OpEx (3rd Friday of Mar/Jun/Sep/Dec)",
                          "filter": "is_quarterly"
                        },
                        {
                          "accepted_values": [
                            "jan",
                            "feb",
                            "mar",
                            "apr",
                            "may",
                            "jun",
                            "jul",
                            "aug",
                            "sep",
                            "oct",
                            "nov",
                            "dec"
                          ],
                          "description": "Filter for monthly opex expiries in any of these months",
                          "filter": "expiry_months"
                        },
                        {
                          "accepted_values": "bool",
                          "filter": "is_multi_leg"
