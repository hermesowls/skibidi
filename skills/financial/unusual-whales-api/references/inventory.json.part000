    {
      "key": "GET /api/alerts/configuration",
      "method": "GET",
      "path": "/api/alerts/configuration",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returnst all alert configurations of the user.\n\nUsers can create alerts for:\n- Market tide\n- Gamma exposure (GEX), Vanna exposure (VEX), Charm exposure (CEX)\n- Interval Contract screeners (replicates and alerts on the Flow Feed)\n- Analyst ratings, price targets, and actions\n- Politician trades\n- Insider trades\n- OI changes for contract in premarket\n- FDA\n- Flow alerts\n- Contract screener (replicates and alerts on the Hottest Chains)\n- Stock screeners\n- News\n- Earnings\n- Dividends\n- Splits\n- Trading stats (halts, unhalts)\n- Economic release\n- SEC filings\n\nThe alerts are the same alerts as the user created on [https://unusualwhales.com/custom-alerts](https://unusualwhales.com/custom-alerts)\n",
        "operationId": "PublicApi.AlertsController.configs",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "An alert configuration",
                  "example": {
                    "data": [
                      {
                        "config": {
                          "option_symbols": [
                            "TGT241122C00177500"
                          ],
                          "symbols": "all"
                        },
                        "created_at": "2024-11-19 18:19:14+00:00",
                        "id": "ebe24953-a0bf-4b4d-98be-14f721a1199a",
                        "name": "Chain OI Chg: TGT241122C00177500",
                        "noti_type": "chain_oi_change",
                        "status": "active"
                      },
                      {
                        "config": {
                          "name_contains": [
                            "berkshire"
                          ],
                          "symbols": "all"
                        },
                        "created_at": "2024-08-09 23:23:13+00:00",
                        "id": "4457d60e-e7e5-4950-82e6-0ea010586f25",
                        "name": "Berkshire",
                        "noti_type": "sec_filings",
                        "status": "active"
                      }
                    ]
                  },
                  "properties": {
                    "config": {
                      "description": "An alert configuration, there is no fixed schema for this as each alert will have a different configuration.",
                      "example": {
                        "config": {
                          "option_symbols": [
                            "TGT241122C00177500"
                          ],
                          "symbols": "all"
                        }
                      },
                      "title": "The configuration of an alert.",
                      "type": "object"
                    },
                    "created_at": {
                      "description": "",
                      "example": "2024-11-19 18:19:14+00:00",
                      "title": "The creation timestamp",
                      "type": "string"
                    },
                    "id": {
                      "description": "",
                      "example": "ebe24953-a0bf-4b4d-98be-14f721a1199a",
                      "title": "The alert id",
                      "type": "string"
                    },
                    "name": {
                      "description": "",
                      "example": "Chain OI Chg: TGT241122C00177500",
                      "title": "The name of the alert",
                      "type": "string"
                    },
                    "noti_type": {
                      "description": "",
                      "example": "chain_oi_change",
                      "title": "The type of the alert",
                      "type": "string"
                    },
                    "status": {
                      "description": "",
                      "enum": [
                        "active",
                        "rate_limit",
                        "paused"
                      ],
                      "example": "active",
                      "title": "The status of the alert",
                      "type": "string"
                    }
                  },
                  "title": "Alert config",
                  "type": "object"
                }
              }
            },
            "description": ""
          },
