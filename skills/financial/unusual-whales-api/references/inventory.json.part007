    {
      "key": "GET /api/darkpool/{ticker}/price-levels",
      "method": "GET",
      "path": "/api/darkpool/{ticker}/price-levels",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns rounded darkpool and regular stock volume concentration by price level for one ticker.\nEach price is grouped into a bucket to highlight areas where trading activity is concentrated.\nDate must be the current or a past date. If no date is given, returns data for the current/last market day.\n",
        "operationId": "PublicApi.DarkpoolController.darkpool_price_levels",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "data": [
                      {
                        "dark_pool_volume": 12000,
                        "price": "123.25",
                        "regular_volume": 35000
                      }
                    ],
                    "date": "2026-08-03"
                  },
                  "properties": {
                    "data": {
                      "items": {
                        "properties": {
                          "dark_pool_volume": {
                            "description": "Stock volume executed off exchange.",
                            "type": "integer"
                          },
                          "price": {
                            "description": "The price level.",
                            "example": "120.12",
                            "title": "Stock Price Level",
                            "type": "string"
                          },
                          "regular_volume": {
                            "description": "Stock volume executed on lit exchanges.",
                            "type": "integer"
                          }
                        },
                        "title": "Darkpool Price Level",
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "date": {
                      "description": "A trading date in ISO format.\n",
                      "example": "2023-09-08",
                      "title": "Market General Trading day",
                      "type": "string"
                    }
                  },
                  "title": "Darkpool Price Levels",
                  "type": "object"
                }
              }
            },
            "description": ""
          },
