    {
      "key": "GET /api/darkpool/{ticker}",
      "method": "GET",
      "path": "/api/darkpool/{ticker}",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the darkpool trades for the given ticker on a given day.\nDate must be the current or a past date. If no date is given, returns data for the current/last market day.\n\nFor real time streaming of darkpool trades, subscribe to the `off_lit_trades` websocket channel, see [https://api.unusualwhales.com/docs/operations/PublicApi.SocketController.off_lit_trades](https://api.unusualwhales.com/docs/operations/PublicApi.SocketController.off_lit_trades).\n\n`executed_at` is an ISO 8601 timestamp in UTC. `trf_executed_at` is the time the trade was reported to\nthe tape.\n",
        "operationId": "PublicApi.DarkpoolController.darkpool_ticker",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "newer_than",
            "required": false,
            "schema": {
              "description": "The unix time in milliseconds or seconds at which no older results will be returned. Can be used with `older_than` to paginate by time. Also accepts an ISO date or RFC 3339 datetime (example: 2024-01-25).",
              "example": 1715083417,
              "title": "NewerThan",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "older_than",
            "required": false,
            "schema": {
              "description": "The unix time in milliseconds or seconds at which no newer results will be returned. Can be used with `newer_than` to paginate by time. Also accepts an ISO date or RFC 3339 datetime (example: 2024-01-25).",
              "example": 1715083417,
              "title": "OlderThan",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "min_premium",
            "required": false,
            "schema": {
              "default": 0,
              "description": "The minimum premium requested trades should have.",
              "example": 50000,
              "minimum": 0,
              "title": "StockTradesMinPremium",
              "type": "integer"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "max_premium",
            "required": false,
            "schema": {
              "description": "The maximum premium requested trades should have.",
              "example": 150000,
