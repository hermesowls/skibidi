        dir_vega_flow:
          $ref: '#/components/schemas/Dir_Vega_Flow'
        expiry:
          $ref: '#/components/schemas/Option_Contract_Expiry'
        flow_group:
          $ref: '#/components/schemas/Flow_Group'
        net_call_premium:
          $ref: '#/components/schemas/Market_General_Net_Call_Premium'
        net_call_volume:
          $ref: '#/components/schemas/Market_General_Net_Call_Volume'
        net_put_premium:
          $ref: '#/components/schemas/Market_General_Net_Put_Premium'
        net_put_volume:
          $ref: '#/components/schemas/Market_General_Net_Put_Volume'
        otm_dir_delta_flow:
          $ref: '#/components/schemas/OTM_Dir_Delta_Flow'
        otm_dir_vega_flow:
          $ref: '#/components/schemas/OTM_Dir_Vega_Flow'
        otm_total_delta_flow:
          $ref: '#/components/schemas/OTM_Total_Delta_Flow'
        otm_total_vega_flow:
          $ref: '#/components/schemas/OTM_Total_Vega_Flow'
        timestamp:
          $ref: '#/components/schemas/Timestamp'
        total_delta_flow:
          $ref: '#/components/schemas/Total_Delta_Flow'
        total_vega_flow:
          $ref: '#/components/schemas/Total_Vega_Flow'
        transactions:
          $ref: '#/components/schemas/Transactions'
        volume:
          $ref: '#/components/schemas/Volume'
      title: Group Flow Expiry
      type: object
    Has_More:
      description: Indicates whether there are more results available beyond the current page.
      example: false
      title: Has More
      type: boolean
    Has_Options:
      description: Whether the company has options available for trading
      example: true
      nullable: true
      title: Has Options
      type: boolean
    Headline_News:
      description: |
        News headlines for financial markets.
        This endpoint provides recent news headlines that may impact the markets,
        including company-specific news, sector news, and market-wide events.
      example:
        data:
          - created_at: 2023-04-15T16:30:00Z
            headline: Company XYZ Reports Better Than Expected Earnings
            is_major: true
            meta: {}
            sentiment: positive
            source: BusinessWire
            tags:
              - earnings
              - tech
            tickers:
              - XYZ
              - EXMP
          - created_at: 2023-04-15T14:20:00Z
            headline: Federal Reserve Signals Possible Rate Cut
            is_major: true
            meta: {}
            sentiment: neutral
            source: MarketNews
            tags:
              - federal-reserve
              - interest-rates
            tickers: []
      properties:
        created_at:
          description: Timestamp when the news headline was created or published.
          format: date_time
          type: string
        headline:
          description: The actual news headline text.
          type: string
        is_major:
          description: Indicates whether the news is considered major or significant.
          type: boolean
        meta:
          description: Additional metadata related to the headline.
          type: object
        sentiment:
          description: Sentiment analysis of the headline (e.g., positive, negative, neutral).
          type: string
        source:
          description: Source of the news headline (e.g., Reuters, Bloomberg, etc.).
          type: string
        tags:
          description: Tags or categories related to the headline.
          items:
            type: string
          type: array
        tickers:
          description: List of ticker symbols related to this news.
          items:
            type: string
          type: array
      required:
        - created_at
        - headline
        - source
      title: Headline News
      type: object
    Historical_Risk_Reversal_Skew:
      description: ''
      example:
        data:
          - date: 2024-01-01
            delta: 10
            risk_reversal: '0.014'
            ticker: SPY
          - date: 2024-01-02
            delta: 10
            risk_reversal: '0.009'
            ticker: SPY
      properties:
        date:
          $ref: '#/components/schemas/General_ISO_Date'
        delta:
          $ref: '#/components/schemas/Risk_Reversal_Delta'
        risk_reversal:
          $ref: '#/components/schemas/Risk_Reversal'
        ticker:
          $ref: '#/components/schemas/Stock_Ticker'
      title: Historical Risk Reversal Skew
      type: object
    Historical_Ticker_Earnings:
      description: |
        The earnings data for a ticker and date.
      example:
        data:
          - actual_eps: '2.45'
            ending_fiscal_quarter: 2024-09-30
            expected_move: '9.91'
            expected_move_perc: '0.0359'
            long_straddle_1d: '0.2349'
            long_straddle_1w: '0.0129'
            post_earnings_move_1d: '0.0724'
            post_earnings_move_1w: '0.132'
            post_earnings_move_2w: '0.1582'
            post_earnings_move_3d: '0.0231'
            pre_earnings_move_1d: '0.0724'
            pre_earnings_move_1w: '0.132'
            pre_earnings_move_2w: '0.1582'
            pre_earnings_move_3d: '0.0231'
            report_date: 2024-11-10
            report_time: postmarket
            short_straddle_1d: '-0.5830'
            short_straddle_1w: '-0.005'
            source: company
            street_mean_est: '2.25'
          - actual_eps: '2.32'
            ending_fiscal_quarter: 2024-06-30
            expected_move: '8.23'
            expected_move_perc: '0.0261'
            long_straddle_1d: '0.2349'
            long_straddle_1w: '0.0129'
            post_earnings_move_1d: '0.0724'
            post_earnings_move_1w: '0.132'
            post_earnings_move_2w: '0.1582'
            post_earnings_move_3d: '0.0231'
            pre_earnings_move_1d: '0.0724'
            pre_earnings_move_1w: '0.132'
            pre_earnings_move_2w: '0.1582'
            pre_earnings_move_3d: '0.0231'
            report_date: 2024-08-02
            report_time: postmarket
            short_straddle_1d: '-0.5830'
            short_straddle_1w: '-0.005'
            source: company
            street_mean_est: '2.15'
      properties:
        actual_eps:
          $ref: '#/components/schemas/Actual_EPS'
        ending_fiscal_quarter:
          $ref: '#/components/schemas/General_ISO_Date'
        expected_move:
          $ref: '#/components/schemas/Expected_Move'
        expected_move_perc:
          $ref: '#/components/schemas/Expected_Move_Perc'
        long_straddle_1d:
          $ref: '#/components/schemas/Long_Straddle_1_Day'
        long_straddle_1w:
          $ref: '#/components/schemas/Long_Straddle_1_Week'
        post_earnings_move_1d:
          $ref: '#/components/schemas/Post_Earnings_Move_1_Day'
        post_earnings_move_1w:
          $ref: '#/components/schemas/Post_Earnings_Move_1_Week'
        post_earnings_move_2w:
          $ref: '#/components/schemas/Post_Earnings_Move_2_Week'
        post_earnings_move_3d:
          $ref: '#/components/schemas/Post_Earnings_Move_13Day'
        pre_earnings_move_1d:
          $ref: '#/components/schemas/Pre_Earnings_Move_1_Day'
        pre_earnings_move_1w:
          $ref: '#/components/schemas/Pre_Earnings_Move_1_Week'
        pre_earnings_move_2w:
          $ref: '#/components/schemas/Pre_Earnings_Move_2_Week'
        pre_earnings_move_3d:
          $ref: '#/components/schemas/Pre_Earnings_Move_13Day'
        report_date:
          $ref: '#/components/schemas/General_ISO_Date'
        report_time:
          $ref: '#/components/schemas/Report_Time'
        short_straddle_1d:
          $ref: '#/components/schemas/Short_Straddle_1_Day'
        short_straddle_1w:
