          $ref: '#/components/schemas/Source'
        street_mean_est:
          $ref: '#/components/schemas/Street_Mean_Est'
      title: Historical Ticker Earnings
      type: object
    Historical_Units:
      description: Historical unit counts. Maximum length = 8.
      example:
        - 4103
        - 4423
      items:
        type: integer
      title: Historical Units
      type: array
    Holdings:
