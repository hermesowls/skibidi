          $ref: '#/components/schemas/Insider_Unique_Insiders'
        volume:
          $ref: '#/components/schemas/Insider_Volume'
      title: Insider Ticker Flow
      type: object
    Insider_Trade_Agg:
      description: An aggregated insider trade
      example:
        data:
          - amount: -35921
            date_excercisable:
            director_indirect:
            expiration_date:
