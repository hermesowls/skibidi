    IPO_Calendar_Response:
      properties:
        data:
          properties:
            ipos:
              items:
                $ref: '#/components/schemas/Upcoming_IPO'
              type: array
          type: object
      title: IPO Calendar Response
      type: object
    IV_Rank:
      description: |
        The IV rank data for a ticker over a time period.
        IV rank is a measure of where current implied volatility stands relative to its historical range.
      example:
        data:
          - close: '180.50'
            date: 2024-01-22
            iv_rank_1y: '0.65'
            updated_at: 2024-01-22T16:35:52.168490Z
            volatility: '0.25'
          - close: '181.25'
            date: 2024-01-23
            iv_rank_1y: '0.72'
            updated_at: 2024-01-23T16:35:52.168490Z
            volatility: '0.28'
      properties:
        close:
          $ref: '#/components/schemas/Stock_Close_Price'
        date:
          $ref: '#/components/schemas/Market_General_Trading_day'
        iv_rank_1y:
          $ref: '#/components/schemas/Market_General_IV_Rank'
        updated_at:
          $ref: '#/components/schemas/General_UTC_Timestamp'
        volatility:
          $ref: '#/components/schemas/Market_General_Volatility'
      title: IV Rank
      type: object
    Implied_Volatility:
      description: The implied volatility of the option trade.
      example: '0.604347250962543'
      title: Implied Volatility
      type: string
    Implied_Volatility_Term_Structure:
      description: ''
      example:
        data:
          - date: 2023-09-08
            dte: 0
            expiry: 2023-09-08
            implied_move: '3.1025'
            implied_move_perc: '0.01765'
            volatility: '0.2319'
          - date: 2023-09-08
            dte: 7
            expiry: 2023-09-15
            implied_move: '4.923'
            implied_move_perc: '0.02747'
            volatility: '0.2352'
      properties:
        date:
          $ref: '#/components/schemas/Market_General_Trading_day'
        dte:
          $ref: '#/components/schemas/DTE'
        expiry:
          $ref: '#/components/schemas/Stock_Expiry'
        implied_move:
          $ref: '#/components/schemas/Stock_Implied_Move'
        implied_move_perc:
          $ref: '#/components/schemas/Stock_Implied_Move_Perc'
        volatility:
          $ref: '#/components/schemas/Stock_Volatility'
      title: Implied Volatility Term Structure
      type: object
    Implied_Volatility_Term_Structure_Distribution:
      description: The range of one expiry's at the money implied volatility over the 365 calendar days ending on `date`. Volatility values are annualized decimals, so `0.43` means 43%.
      properties:
        date:
          example: 2026-09-18
          format: date
          type: string
        dte:
          description: The number of calendar days from `date` to `expiry`.
          example: 91
          type: integer
        expiry:
          example: 2026-12-18
          format: date
          type: string
        first_date:
          description: The earliest trading day included in the lookback for the expiry.
          example: 2025-09-19
          format: date
          type: string
        max:
          description: The highest daily value in the lookback.
          example: '0.595370292271564'
          type: string
        median:
          description: The median of the daily values, interpolated linearly and rounded to 6 decimals.
          example: '0.491979'
          type: string
        min:
          description: The lowest daily value in the lookback.
          example: '0.4291603363676975'
          type: string
        percentile:
          description: The share of daily values at or below `volatility`, from 0 to 1. The value on `date` counts as one of the daily values.
          example: '0.0080'
          type: string
        q1:
          description: The first quartile of the daily values, interpolated linearly and rounded to 6 decimals.
          example: '0.474857'
          type: string
        q3:
          description: The third quartile of the daily values, interpolated linearly and rounded to 6 decimals.
          example: '0.548378'
          type: string
        samples:
          description: The number of daily values in the lookback, one per trading day with a value for the expiry.
          example: 251
          type: integer
        ticker:
          example: TSLA
          type: string
        volatility:
          description: The implied volatility of the expiry on `date`. It is the average of the latest call and put implied volatility at the at the money strike.
          example: '0.4295974677151735'
          type: string
      title: Implied Volatility Term Structure Distribution
      type: object
    Income_Statement:
      description: A single income-statement period. All monetary figures are numeric strings, null when not reported.
      properties:
        comprehensive_income_net_of_tax:
          example: '22430000000'
          nullable: true
          type: string
        cost_of_goods_and_services_sold:
          example: '51000000000'
          nullable: true
          type: string
        cost_of_revenue:
          example: '52553000000'
          nullable: true
          type: string
        depreciation:
          example: '1200000000'
          nullable: true
          type: string
        depreciation_and_amortization:
          example: '2910000000'
          nullable: true
          type: string
        ebit:
          example: '29281000000'
          nullable: true
          type: string
        ebitda:
          example: '32191000000'
          nullable: true
          type: string
        fiscal_date_ending:
          example: 2024-09-30
          format: date
          type: string
        gross_profit:
          example: '42377000000'
          nullable: true
          type: string
        income_before_tax:
          example: '28279000000'
          nullable: true
          type: string
        income_tax_expense:
          example: '4422000000'
          nullable: true
          type: string
        inserted_at:
          example: 2026-07-29T12:34:56Z
          format: date-time
          type: string
        interest_and_debt_expense:
          example: '1002000000'
          nullable: true
          type: string
        interest_expense:
          example: '1002000000'
          nullable: true
          type: string
        interest_income:
          example: '1190000000'
          nullable: true
          type: string
        investment_income_net:
          example: '800000000'
          nullable: true
          type: string
        net_income:
          example: '23857000000'
          nullable: true
          type: string
        net_income_from_continuing_operations:
          example: '23857000000'
          nullable: true
          type: string
        net_interest_income:
          example: '188000000'
          nullable: true
          type: string
        non_interest_income:
          example: '93740000000'
          nullable: true
          type: string
        operating_expenses:
          example: '14286000000'
          nullable: true
          type: string
        operating_income:
          example: '28091000000'
          nullable: true
          type: string
        other_non_operating_income:
          example: '-13000000'
          nullable: true
          type: string
        report_type:
          enum:
            - annual
            - quarterly
          example: quarterly
          type: string
        reported_currency:
          example: USD
          nullable: true
          type: string
        research_and_development:
          example: '7763000000'
          nullable: true
          type: string
        selling_general_and_administrative:
          example: '6523000000'
          nullable: true
          type: string
        ticker:
          example: AAPL
          type: string
        total_revenue:
          example: '94930000000'
          nullable: true
          type: string
        updated_at:
          example: 2026-07-29T12:34:56Z
          format: date-time
          type: string
      title: Income Statement
      type: object
    Income_Statements_Response:
      properties:
        data:
          items:
            $ref: '#/components/schemas/Income_Statement'
          type: array
      title: Income Statements Response
      type: object
    Industries:
      description: An array of one or more industries.
      example:
        - Semiconductors
        - Software - Infrastructure
      items:
        type: string
      title: Industries
      type: array
    Inflow_and_Outflow:
      description: ''
      example:
        data:
          - change: -50
            change_prem: '-12000.0'
            close: '236.16'
            date: 2024-10-02
            is_fomc: false
            volume: 592342
          - change: 100
            change_prem: '23500.0'
            close: '235.12'
            date: 2024-10-01
            is_fomc: false
            volume: 602342
      properties:
        change:
          $ref: '#/components/schemas/Etf_Share_Change'
        change_prem:
          $ref: '#/components/schemas/Etf_Premium_Change'
        close:
          $ref: '#/components/schemas/Stock_Close_Price'
        date:
          $ref: '#/components/schemas/General_ISO_Date'
        is_fomc:
          $ref: '#/components/schemas/Is_FOMC_Date'
        volume:
          $ref: '#/components/schemas/Stock_Day_Stock_Volume'
      title: Inflow & Outflow
      type: object
    Insider:
      description: An insider
      example:
        data:
          - cik: '0001823951'
            display_name: KARP ALEXANDER
            id: 10343
            is_person: true
            logo_url: https://storage.googleapis.com/uwassets/insiders/10343
            name: KARP ALEXANDER
            name_slug: karp-alexander
            ticker: PLTR
      properties:
        cik:
          $ref: '#/components/schemas/Insider_CIK'
        id:
          $ref: '#/components/schemas/Insider_ID'
        is_person:
          $ref: '#/components/schemas/Insider_Is_Person'
        logo_url:
          $ref: '#/components/schemas/Insider_Logo_URL'
        name:
          $ref: '#/components/schemas/Insider_Name'
        name_slug:
          $ref: '#/components/schemas/Insider_Name_Slug'
        social_links:
          $ref: '#/components/schemas/Insider_Social_Links'
        ticker:
          $ref: '#/components/schemas/Stock_Ticker'
      title: Insider
      type: object
    Insider_Amount:
      description: The amount of the insider trade.
      example: 1000
      title: Insider Amount
      type: integer
    Insider_Average_Price:
      description: The average price of the insider trade.
      example: '123.45'
      title: Insider Average Price
      type: string
    Insider_CIK:
      description: The insider's CIK (Central Index Key).
      example: '0000902015'
      title: Insider CIK
      type: string
    Insider_Date_Excercisable:
      description: The date excercisable of the insider trade.
      example: 2023-12-06
      title: Insider Date Excercisable
      type: string
    Insider_Director_Indirect:
      description: The director indirect of the insider trade.
      example: John Doe
      title: Insider Director Indirect
      type: string
    Insider_Expiration_Date:
      description: The expiration date of the insider trade.
      example: 2023-12-06
      title: Insider Expiration Date
      type: string
    Insider_Filing_Date:
      description: The filing date of the insider trade.
      example: 2023-12-06
      title: Insider Filing Date
      type: string
    Insider_Form_Type:
      description: 'The SEC form the row came from: 3 (initial ownership), 4 (change in ownership), 5 (annual), 144 (notice of intended sale, not an executed trade), each with an /A variant for amendments.'
      enum:
        - '3'
        - 3/A
        - '4'
        - 4/A
        - '5'
        - 5/A
        - '144'
        - 144/A
      example: '4'
      title: Insider Form Type
      type: string
    Insider_ID:
      description: The insider's ID.
      example: 1
      title: Insider ID
      type: integer
    Insider_IDs:
      description: The IDs of the insider trade.
      example:
        - '1234'
      items:
        type: string
      title: Insider IDs
      type: array
    Insider_Is_10_Owner:
      description: Whether the insider is a 10% owner.
      example: true
      title: Insider Is 10 Owner
      type: boolean
    Insider_Is_10b5-1:
      description: True if this insider trade was part of a 10b5-1 plan
      example: true
      title: Insider Is 10b5-1
      type: boolean
    Insider_Is_Director:
      description: Whether the insider is a director.
      example: true
      title: Insider Is Director
      type: boolean
    Insider_Is_Officer:
      description: Whether the insider is an officer.
      example: true
      title: Insider Is Officer
      type: boolean
    Insider_Is_Person:
      description: Whether the insider is a person. False if the insider is a fund, LLC, etc.
      example: true
      title: Insider Is Person
      type: boolean
    Insider_Logo_URL:
      description: The URL to the insider's logo.
      example: https://example.com/logo.png
      title: Insider Logo URL
      type: string
    Insider_Name:
      description: The name of the insider.
      example: John Doe
      title: Insider Name
      type: string
    Insider_Name_Slug:
      description: The slugified name of the insider.
      example: john-doe
      title: Insider Name Slug
      type: string
    Insider_Nature_of_Ownership:
      description: The nature of ownership of the insider trade.
      example: Direct
      title: Insider Nature of Ownership
      type: string
    Insider_Officer_Title:
      description: The officer title of the insider trade.
      example: CEO
      title: Insider Officer Title
      type: string
    Insider_Owner_Name:
      description: The owner name of the insider trade.
      example: John Doe
      title: Insider Owner Name
      type: string
    Insider_Premium:
      description: The premium of the insider trade.
      example: '123.45'
      title: Insider Premium
      type: string
    Insider_Price:
      description: The price of the insider trade.
      example: '123.45'
      title: Insider Price
      type: string
    Insider_Price_Excercisable:
      description: The price excercisable of the insider trade.
      example: '123.45'
      title: Insider Price Excercisable
      type: string
    Insider_Sector_Flow:
      description: The total buy/sell insider flow for a given sector on a given date. If there have been buy & sells on the same day then there will be 2 rows for that day.
      example:
        data:
          - avg_price: 162.32
            buy_sell: sell
            date: 2024-12-12
            premium: '664386'
            transactions: 54
            uniq_insiders: 10
            volume: 244331
        has_more: false
      properties:
        avg_price:
          $ref: '#/components/schemas/Insider_Average_Price'
        buy_sell:
          $ref: '#/components/schemas/Transaction_Side'
        date:
          $ref: '#/components/schemas/Market_General_Trading_day'
        has_more:
          $ref: '#/components/schemas/Has_More'
        premium:
          $ref: '#/components/schemas/Insider_Premium'
        transactions:
          $ref: '#/components/schemas/Insider_Transactions'
        uniq_insiders:
          $ref: '#/components/schemas/Insider_Unique_Insiders'
        volume:
          $ref: '#/components/schemas/Insider_Volume'
      title: Insider Sector Flow
      type: object
    Insider_Security_AD_Code:
      description: The security AD code of the insider trade.
      example: '1234'
      title: Insider Security AD Code
      type: string
    Insider_Security_Title:
      description: The security title of the insider trade.
      example: Common Stock
      title: Insider Security Title
      type: string
    Insider_Shares_Owned_After:
      description: The number of shares owned after the insider trade.
      example: 2000
      title: Insider Shares Owned After
      type: integer
    Insider_Shares_Owned_Before:
      description: The number of shares owned before the insider trade.
      example: 1000
      title: Insider Shares Owned Before
      type: integer
    Insider_Social_Links:
      description: The social links of the insider.
      example:
        - https://twitter.com/johndoe
      items:
        type: string
      title: Insider Social Links
      type: array
    Insider_Ticker_Flow:
      description: The total buy/sell insider flow for a given ticker on a given date. If there have been buy & sells on the same day then there will be 2 rows for that day.
      example:
        data:
          - avg_price: 162.32
            buy_sell: sell
            date: 2024-12-12
            premium: '664386'
            transactions: 54
            uniq_insiders: 10
            volume: 244331
        has_more: false
      properties:
        avg_price:
          $ref: '#/components/schemas/Insider_Average_Price'
        buy_sell:
          $ref: '#/components/schemas/Transaction_Side'
        date:
          $ref: '#/components/schemas/Market_General_Trading_day'
