        director_indirect:
          $ref: '#/components/schemas/Insider_Director_Indirect'
        expiration_date:
          $ref: '#/components/schemas/Insider_Expiration_Date'
        filing_date:
          $ref: '#/components/schemas/Insider_Filing_Date'
        formtype:
          $ref: '#/components/schemas/Insider_Form_Type'
        ids:
          $ref: '#/components/schemas/Insider_IDs'
