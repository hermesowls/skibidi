        - value
        - avg_price
        - perc_outstanding
        - perc_units_changed
        - activity
        - perc_inst_value
        - perc_share_value
      example: name
      title: Institutional Ownership Order By
      type: string
    Institutional_Report_End_Date:
      description: |
        A date in the format of YYYY-MM-DD, only institutional holdings with `report_date` values on or before this date will be returned.
      example: 2023-03-31
      format: date
      title: Institutional Report End Date
      type: string
    Institutional_Report_Start_Date:
      description: |
        A date in the format of YYYY-MM-DD, only institutional holdings with `report_date` values on or after this date will be returned.
      example: 2023-01-01
      format: date
      title: Institutional Report Start Date
      type: string
    Institutional_Reporting_End_Date:
      description: |
        End date to filter institutional reporting data in the format YYYY-MM-DD.

        Only data with dates on or before this date will be returned.
      example: 2023-03-31
      format: date
      title: Institutional Reporting End Date
      type: string
    Institutional_Reporting_Start_Date:
      description: |
        Start date to filter institutional reporting data in the format YYYY-MM-DD.

        Only data with dates on or after this date will be returned.
      example: 2023-01-01
      format: date
      title: Institutional Reporting Start Date
      type: string
    Interpolated_IV:
      description: Interpolated implied volatility data for different time horizons
      example:
        data:
          - date: 2025-05-30
            days: 1
            implied_move_perc: '0.003'
            percentile: '100'
            volatility: '1.739'
          - date: 2025-05-30
            days: 5
            implied_move_perc: '0.02'
            percentile: '94.737'
            volatility: '0.696'
          - date: 2025-05-30
            days: 7
            implied_move_perc: '0.026'
            percentile: '52.632'
            volatility: '0.278'
          - date: 2025-05-30
            days: 14
            implied_move_perc: '0.041'
            percentile: '68.421'
            volatility: '0.311'
          - date: 2025-05-30
            days: 30
            implied_move_perc: '0.058'
            percentile: '77.193'
            volatility: '0.299'
      properties:
        date:
          $ref: '#/components/schemas/Market_General_Trading_day'
        days:
          description: Number of days to expiration
          example: 30
          type: integer
        implied_move_perc:
          description: Expected move as a percentage of the current price
          example: '0.058'
          type: string
        percentile:
          description: Percentile ranking of this volatility value over a 1y period
          example: '77.193'
          type: string
        volatility:
          description: Interpolated implied volatility value
          example: '0.299'
          type: string
      title: Interpolated IV
      type: object
    Interpolated_IV_Distribution:
      description: The range of one fixed maturity's interpolated implied volatility over the 365 calendar days ending on `date`. Volatility values are annualized decimals, so `0.43` means 43%.
      properties:
        date:
          example: 2026-09-18
          format: date
          type: string
        days:
          description: The fixed maturity in calendar days. One of 7, 30, 60, 90, 180 or 365.
          example: 30
          type: integer
        first_date:
          description: The earliest trading day included in the lookback for the maturity.
          example: 2025-09-19
          format: date
          type: string
        max:
          description: The highest daily value in the lookback.
          example: '0.648'
          type: string
        median:
          description: The median of the daily values, interpolated linearly and rounded to 6 decimals.
          example: '0.461'
          type: string
        min:
          description: The lowest daily value in the lookback.
          example: '0.369'
          type: string
        percentile:
          description: The share of daily values at or below `volatility`, from 0 to 1. The value on `date` counts as one of the daily values.
          example: '0.1434'
          type: string
        q1:
          description: The first quartile of the daily values, interpolated linearly and rounded to 6 decimals.
          example: '0.426'
          type: string
        q3:
          description: The third quartile of the daily values, interpolated linearly and rounded to 6 decimals.
          example: '0.487'
          type: string
        samples:
          description: The number of daily values in the lookback, one per trading day with a positive value.
          example: 251
          type: integer
        ticker:
          example: TSLA
          type: string
        volatility:
          description: The interpolated implied volatility of the maturity on `date`.
          example: '0.412'
          type: string
      title: Interpolated IV Distribution
      type: object
    Is_Active:
      description: Is the politician an active member.
      example: G000585
      title: Is Active
      type: string
    Is_FOMC_Date:
      description: If the date has an FOMC announcement.
      example: false
      title: Is FOMC Date
      type: boolean
    Is_Hedge_Fund:
      description: ''
      example: true
      title: Is Hedge Fund
      type: boolean
    Is_OTM_Contract:
      description: Only include contracts which are currently out of the money.
      example: true
      title: Is OTM Contract
      type: boolean
    Is_Part_of_the_SandP_500:
      description: ''
      title: Is Part of the S&P 500
      type: boolean
    Issue_types:
      description: An array of 1 or more issue types.
      example:
        - Common Stock
        - Index
      items:
        $ref: '#/components/schemas/Single_issue_type'
      title: Issue types
      type: array
    Issuer_CIK:
      description: SEC Central Index Key of the issuing company.
      example: '0001326801'
      title: Issuer CIK
      type: string
    Last_NBBO_Ask:
      description: The NBBO Ask price for the final tick of that day's trading session.
      example: '0.45'
      title: Last NBBO Ask
      type: string
    Last_NBBO_Bid:
      description: The NBBO Bid price for the final tick of that day's trading session.
      example: '0.30'
      title: Last NBBO Bid
      type: string
    Latest_Institutional_Filings:
      description: The latest institutional filings.
      example:
        data:
          - cik: '0001791786'
            filing_date: 2024-10-03
            is_hedge_fund: true
            name: ELLIOTT INVESTMENT MANAGEMENT L.P.
            people:
              - Paul Singer
            short_name: Elliott Investment Management
            tags:
              - activist
      properties:
        cik:
          $ref: '#/components/schemas/CIK'
        filing_date:
          $ref: '#/components/schemas/General_ISO_Date'
        is_hedge_fund:
          $ref: '#/components/schemas/Is_Hedge_Fund'
        name:
          $ref: '#/components/schemas/Name'
        people:
          $ref: '#/components/schemas/People'
        short_name:
          $ref: '#/components/schemas/Short_Name'
        tags:
          $ref: '#/components/schemas/Tags'
      title: Latest Institutional Filings
      type: object
    Latest_Institutional_Filings_Order_By:
      description: Optional columns to order the result by. The filing date is always sorted in descending or