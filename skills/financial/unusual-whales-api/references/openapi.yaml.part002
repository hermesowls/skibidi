          $ref: '#/components/schemas/Description'
        filing_date:
          $ref: '#/components/schemas/Filing_Date'
        founder_img_url:
          $ref: '#/components/schemas/Founder_Image_URL'
        fund_holdings:
          $ref: '#/components/schemas/Fund_Holding_Units'
        fund_value:
