        issuer_cik:
          $ref: '#/components/schemas/Issuer_CIK'
        natureofownership:
          $ref: '#/components/schemas/Insider_Nature_of_Ownership'
        officer_title:
          $ref: '#/components/schemas/Insider_Officer_Title'
        owner_name:
          $ref: '#/components/schemas/Insider_Owner_Name'
        price:
          $ref: '#/components/schemas/Insider_Price'
        price_excercisable:
          $ref: '#/components/schemas/Insider_Price_Excercisable'
        reporter_cik:
          $ref: '#/components/schemas/Reporter_CIK'
        security_ad_code:
          $ref: '#/components/schemas/Insider_Security_AD_Code'
        security_title:
          $ref: '#/components/schemas/Insider_Security_Title'
        shares_owned_after:
          $ref: '#/components/schemas/Insider_Shares_Owned_After'
        shares_owned_before:
