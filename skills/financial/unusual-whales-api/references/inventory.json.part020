                  "description": "A plain message informing, that an internal server error occured. In this case please send a mail with the full URL that caused the issue to support@unusualwhales.com.",
                  "example": "Something went wrong",
                  "title": "Error Message on an internal server error.",
                  "type": "string"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Volume Profile",
        "tags": [
          "option-contract"
        ],
        "security": [
          {
            "authorization": []
          }
        ],
        "servers": [
          {
            "url": "https://api.unusualwhales.com",
            "variables": {}
          }
        ]
      }
    },
    {
      "key": "GET /api/option-trades",
      "method": "GET",
      "path": "/api/option-trades",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Filter the full option trades tape.\n\nThis endpoint returns the same data and supports the same filter params as on the unusualwhales website [https://unusualwhales.com/live-options-flow](https://unusualwhales.com/live-options-flow).\n\nThis endpoint only returns data for the latest trading day. To retrieve historical option trades,\nuse the `/api/option-trades/full-tape/:date` endpoint to download the full market file for a trading day.\n\nList parameters may be supplied using repeated bracket notation, for example\n`tags[]=ask_side&tags[]=bid_side`. Unix timestamps may be supplied in seconds or milliseconds.\n\nPagination uses the `older_than` and `newer_than` cursors, which accept Unix seconds, Unix milliseconds\nor ISO 8601 values. `page` and `offset` are not supported. `limit` defaults to 50 and has a maximum of\n500. A cursor earlier than the latest trading day returns HTTP 400. Use\n`/api/option-trades/full-tape/{date}` for older history.\n\nThe side-volume fields (`ask_vol`, `bid_vol`, `mid_vol` and `no_side_vol`) sum to `volume`.\n`multi_vol` and `stock_multi_vol` are overlapping subsets of `volume`, not separate amounts to subtract.\n\nOn this REST endpoint, `executed_at`, `nbbo_bid_time` and `nbbo_ask_time` are ISO 8601 timestamps in UTC.\nOn the WebSocket `option_trades` channel, the same fields are Unix epoch timestamps in milliseconds.\n",
        "operationId": "PublicApi.OptionTradeController.index",
        "parameters": [
          {
            "description": "",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "How many items to return. Default: 50. Max: 500. Min: 1.",
              "example": 10,
              "maximum": 500,
              "minimum": 1,
              "title": "Default 50, Max 500 Min 1",
              "type": "integer"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "ticker_symbol",
            "required": false,
            "schema": {
              "description": "A comma separated list of tickers. To exclude certain tickers prefix the first ticker with a `-`.",
              "example": "AAPL,INTC",
              "title": "Ticker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "option_contracts[]",
            "required": false,
            "schema": {
              "description": "Option contracts to include.",
              "example": [
                "AAPL250117C00200000"
              ],
              "items": {
                "description": "An option contract in the OSI format.",
                "example": "TSLA230526P00167500",
                "title": "OptionContract",
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "chain[]",
            "required": false,
            "schema": {
              "description": "Alias for `option_contracts[]`.",
              "example": [
                "AAPL250117C00200000"
              ],
              "items": {
                "description": "An option contract in the OSI format.",
                "example": "TSLA230526P00167500",
                "title": "OptionContract",
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "strike",
            "required": false,
            "schema": {
              "description": "The strike price of an option contract.",
              "example": "150.0",
              "title": "Strike",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "description": "The option type to filter by if specified.",
              "enum": [
                "call",
                "Call",
                "put",
                "Put"
              ],
              "title": "OptionType",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "newer_than",
            "required": false,
            "schema": {
              "description": "The unix time in milliseconds or seconds at which no older results will be returned. Can be used with `older_than` to paginate by time. Also accepts an ISO date or RFC 3339 datetime (example: 2024-01-25).",
              "example": 1715083417,
              "title": "NewerThan",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "older_than",
            "required": false,
            "schema": {
              "description": "The unix time in milliseconds or seconds at which no newer results will be returned. Can be used with `newer_than` to paginate by time. Also accepts an ISO date or RFC 3339 datetime (example: 2024-01-25).",
              "example": 1715083417,
              "title": "OlderThan",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "canceled",
            "required": false,
            "schema": {
              "description": "Whether the option trade was canceled.",
              "example": false,
              "title": "Canceled",
              "type": "boolean"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "is_multi_leg",
            "required": false,
            "schema": {
              "description": "Boolean flag whether the transaction is a multi-leg transaction.",
              "example": true,
              "title": "Flow Alerts Is Multi Leg",
              "type": "boolean"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "volume_greater_oi",
            "required": false,
            "schema": {
              "description": "Only include contracts where the volume is greater than the open interest.",
              "example": true,
              "title": "Volume Greater Than Open Interest Contract",
              "type": "boolean"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "exclude_deep_itm",
            "required": false,
            "schema": {
              "description": "Exclude deep in-the-money contracts.",
              "example": true,
              "type": "boolean"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "force_15_min_delay",
            "required": false,
            "schema": {
              "description": "Only return trades that are at least 15 minutes old.",
              "example": true,
              "type": "boolean"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "hide_expired",
            "required": false,
            "schema": {
              "description": "Exclude expired option contracts.",
              "example": true,
              "type": "boolean"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "include_agg_trades",
            "required": false,
            "schema": {
              "description": "Whether to roll up related option transactions executed at the same time into a single transaction in the response. This allows filters to apply to their combined premium and size. For example, if one $25,000 order is reported as ten $2,500 transactions, it will only match `min_premium=20000` when `include_agg_trades=true`.",
              "example": true,
              "type": "boolean"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "intraday_only",
            "required": false,
            "schema": {
              "description": "Only return trades from the current trading day.",
              "example": true,
              "type": "boolean"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "is_otm",
            "required": false,
            "schema": {
              "description": "Filter out-of-the-money or in-the-money trades.",
              "example": true,
              "type": "boolean"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "opening",
            "required": false,
            "schema": {
              "description": "Filter opening or non-opening transactions.",
              "example": true,
              "type": "boolean"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "opex_only",
            "required": false,
            "schema": {
              "description": "Filter contracts by whether they expire on monthly OpEx Friday.",
              "example": true,
              "type": "boolean"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "size_greater_oi",
            "required": false,
            "schema": {
              "description": "Filter by whether trade size exceeds open interest.",
              "example": true,
              "type": "boolean"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "exchanges[]",
            "required": false,
            "schema": {
              "description": "Options exchanges to include.",
              "example": [
                "AMXO",
                "MXOP"
              ],
              "items": {
                "enum": [
                  "AMXO",
                  "ARCO",
                  "BATO",
                  "C2OX",
                  "EDGO",
                  "EMLD",
                  "GMNI",
                  "MCRY",
                  "MPRL",
                  "XBOX",
                  "XBXO",
                  "XCBO",
                  "XISX",
                  "XMIO",
                  "XNDQ",
                  "XPHO",
                  "MXOP",
                  "SPHR",
                  "MXTO",
                  "IEXO"
                ],
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "excluded_tags[]",
            "required": false,
            "schema": {
              "description": "Exclude trades containing any of these tags.",
              "example": [
                "bid_side"
              ],
              "items": {
                "enum": [
                  "ask_side",
                  "bid_side",
                  "mid_side",
                  "no_side",
                  "china",
                  "volatility",
                  "dividend",
                  "index",
                  "arbitrage"
                ],
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "expiry_dates[]",
            "required": false,
            "schema": {
              "description": "An array of 1 or more expiry dates.",
              "example": [
                "2024-02-02",
                "2024-01-26"
              ],
              "items": {
                "description": "A single expiry date in ISO date format.",
                "example": "2024-02-02",
                "title": "Single expiry date",
                "type": "string"
              },
              "title": "Expiry dates",
              "type": "array"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "industries[]",
            "required": false,
            "schema": {
              "description": "An array of one or more industries.",
              "example": [
                "Semiconductors",
                "Software - Infrastructure"
              ],
              "items": {
                "type": "string"
              },
              "title": "Industries",
              "type": "array"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "issue_types[]",
            "required": false,
            "schema": {
              "description": "An array of 1 or more issue types.",
              "example": [
                "Common Stock",
                "Index"
              ],
              "items": {
                "description": "A singular issue type.",
                "enum": [
                  "Common Stock",
                  "ETF",
                  "Index",
                  "ADR"
                ],
                "example": "Common Stock",
                "title": "Single issue type",
                "type": "string"
              },
              "title": "Issue types",
              "type": "array"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "marketcap_size[]",
            "required": false,
            "schema": {
              "description": "An array of one or more market capitalization size categories.",
              "example": [
                "large",
                "big"
              ],
              "items": {
                "description": "A market capitalization size category.",
                "enum": [
                  "micro",
                  "small",
                  "mid",
                  "large",
                  "big"
                ],
                "example": "large",
                "title": "Single market cap size",
                "type": "string"
              },
              "title": "Market cap sizes",
              "type": "array"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "report_flag[]",
            "required": false,
            "schema": {
              "description": "Trade report flags to include.",
              "example": [
                "intermarket_sweep"
              ],
              "items": {
                "enum": [
                  "opening",
                  "closing",
                  "reopening",
                  "cross_trade",
                  "extended_hours",
                  "intermarket_sweep",
                  "trade_through_exempt",
                  "odd_lot",
                  "official_price_report",
                  "futures_floor",
                  "summary",
                  "printable",
                  "normal"
                ],
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "sectors[]",
            "required": false,
            "schema": {
              "description": "An array of 1 or more sectors.",
              "example": [
                "Consumer Cyclical",
                "Technology",
                "Utilities"
              ],
              "items": {
                "description": "A singular sector.",
                "enum": [
                  "Basic Materials",
                  "Communication Services",
                  "Consumer Cyclical",
                  "Consumer Defensive",
                  "Energy",
                  "Financial Services",
                  "Healthcare",
                  "Industrials",
                  "Real Estate",
                  "Technology",
                  "Utilities"
                ],
                "example": "Real Estate",
                "title": "Single sector",
                "type": "string"
              },
              "title": "Sectors",
              "type": "array"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "tags[]",
            "required": false,
            "schema": {
              "description": "Include trades containing any of these tags.",
              "example": [
                "ask_side"
              ],
              "items": {
                "enum": [
                  "ask_side",
                  "bid_side",
                  "mid_side",
                  "no_side",
                  "china",
                  "volatility",
                  "dividend",
