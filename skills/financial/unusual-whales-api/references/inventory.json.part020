    {
      "key": "GET /api/option-contract/{id}/volume-profile",
      "method": "GET",
      "path": "/api/option-contract/{id}/volume-profile",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the volume profile (volume - sweep, floor, cross, ask, bid, etc. - per fill price) for an option symbol on a given trading day.\nDate must be the current or a past date. If no date is given, returns data for the current/last market day.\n",
        "operationId": "PublicApi.OptionContractController.volume_profile",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "An option contract in the OSI format.",
              "example": "TSLA230526P00167500",
              "title": "OptionContract",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Volume data for an option contract at a specific price level on a particular trading day.\nIncludes breakdowns of volume by trade type (ask, bid, mid, multi-leg, sweep, floor, cross).\n",
                  "example": {
                    "data": [
                      {
                        "ask_vol": 850,
                        "bid_vol": 325,
                        "cross_vol": 5,
                        "date": "2024-05-28",
                        "floor_vol": 10,
                        "mid_vol": 25,
                        "multi_vol": 40,
                        "price": "3.50",
                        "sweep_vol": 120,
                        "transactions": 42,
                        "volume": 1250
                      },
                      {
                        "ask_vol": 620,
                        "bid_vol": 275,
                        "cross_vol": 0,
                        "date": "2024-05-28",
                        "floor_vol": 5,
                        "mid_vol": 15,
                        "multi_vol": 25,
                        "price": "3.55",
                        "sweep_vol": 90,
                        "transactions": 31,
                        "volume": 950
                      }
                    ]
                  },
                  "properties": {
                    "ask_vol": {
                      "description": "The amount of volume that happened on the ask side.\n\nAsk side is defined as (ask + bid) / 2 < fill price.\n",
                      "example": 119403,
                      "title": "Option Contract Ask Volume",
                      "type": "integer"
                    },
                    "bid_vol": {
                      "description": "The amount of volume that happened on the bid side.\n\nBid side is defined as (ask + bid) / 2 > fill price.\n",
                      "example": 122789,
                      "title": "Option Contract Bid Volume",
                      "type": "integer"
                    },
                    "cross_vol": {
                      "description": "The amount of cross volume.\nCross volume consists of all transaction that have the cross trade code.\n",
                      "example": 0,
                      "title": "Option Contract Cross Volume",
                      "type": "integer"
                    },
                    "date": {
                      "description": "A trading date in ISO format.\n",
                      "example": "2023-09-08",
                      "title": "Market General Trading day",
                      "type": "string"
                    },
                    "floor_vol": {
                      "description": "The amount of floor volume.\nFloor volume consists of all transaction that have the floor trade code.\n",
                      "example": 142,
                      "title": "Option Contract Floor Volume",
                      "type": "integer"
                    },
                    "mid_vol": {
                      "description": "The amount of volume that happened in the middle of the ask and bid.\n\nMid is defined as (ask + bid) / 2 == fill price.\n",
                      "example": 22707,
                      "title": "Option Contract Mid Volume",
                      "type": "integer"
                    },
                    "multi_vol": {
                      "description": "The amount of volume that happened as part of a multileg trade with another contract.\nThis can be spreads/rolls/condors/butterflies and more.\n",
                      "example": 7486,
                      "title": "Option Contract Multi Leg Volume",
                      "type": "integer"
                    },
                    "price": {
                      "description": "The fill price of the option trade.",
                      "example": "21.50",
                      "title": "Fill Price",
                      "type": "string"
                    },
                    "sweep_vol": {
                      "description": "The amount of sweep volume.\nSweep volume consists of all transaction that have the sweep trade code.\n",
                      "example": 18260,
                      "title": "Option Contract Sweep Volume",
                      "type": "integer"
                    },
                    "transactions": {
                      "description": "The amount of transaction for this contract.",
                      "example": 39690,
                      "title": "Option Contract Total Trades Count",
                      "type": "integer"
                    },
                    "volume": {
                      "description": "The contract volume.",
                      "example": 264899,
                      "title": "Option Contract Volume",
                      "type": "integer"
                    }
                  },
                  "title": "Option Contract Price Level Volume",
                  "type": "object"
                }
              }
            },
            "description": ""
          },
