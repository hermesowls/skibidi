                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "min_ask_perc",
            "required": false,
            "schema": {
              "description": "The minimum ask percentage. Decimal proxy for percentage (0 to 1). Min: 0. Max: 1.",
              "example": 0.25,
              "maximum": 1,
              "minimum": 0,
              "title": "Flow Alerts Min Ask Percentage",
              "type": "number"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "max_ask_perc",
            "required": false,
            "schema": {
              "description": "The maximum ask percentage. Decimal proxy for percentage (0 to 1). Min: 0. Max: 1.",
              "example": 0.75,
              "maximum": 1,
              "minimum": 0,
              "title": "Flow Alerts Max Ask Percentage",
              "type": "number"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "min_bear_perc",
            "required": false,
            "schema": {
              "description": "The minimum bear percentage. Decimal proxy for percentage (0 to 1). Min: 0. Max: 1.",
              "example": 0.5,
              "maximum": 1,
              "minimum": 0,
              "title": "Flow Alerts Min Bear Percentage",
              "type": "number"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "max_bear_perc",
            "required": false,
            "schema": {
              "description": "The maximum bear percentage. Decimal proxy for percentage (0 to 1). Min: 0. Max: 1.",
              "example": 0.9,
              "maximum": 1,
              "minimum": 0,
              "title": "Flow Alerts Max Bear Percentage",
              "type": "number"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "min_bid_perc",
            "required": false,
            "schema": {
              "description": "The minimum bid percentage. Decimal proxy for percentage (0 to 1). Min: 0. Max: 1.",
              "example": 0.25,
              "maximum": 1,
              "minimum": 0,
              "title": "Flow Alerts Min Bid Percentage",
              "type": "number"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "max_bid_perc",
            "required": false,
            "schema": {
              "description": "The maximum bid percentage. Decimal proxy for percentage (0 to 1). Min: 0. Max: 1.",
              "example": 0.75,
              "maximum": 1,
              "minimum": 0,
              "title": "Flow Alerts Max Bid Percentage",
              "type": "number"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "min_bull_perc",
            "required": false,
            "schema": {
              "description": "The minimum bull percentage. Decimal proxy for percentage (0 to 1). Min: 0. Max: 1.",
              "example": 0.5,
              "maximum": 1,
              "minimum": 0,
              "title": "Flow Alerts Min Bull Percentage",
              "type": "number"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "max_bull_perc",
            "required": false,
            "schema": {
              "description": "The maximum bull percentage. Decimal proxy for percentage (0 to 1). Min: 0. Max: 1.",
              "example": 0.9,
              "maximum": 1,
              "minimum": 0,
              "title": "Flow Alerts Max Bull Percentage",
              "type": "number"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "min_skew",
            "required": false,
            "schema": {
              "description": "The minimum skew. Decimal proxy for percentage (0 to 1). Min: 0. Max: 1.",
              "example": 0.3,
              "maximum": 1,
              "minimum": 0,
              "title": "Flow Alerts Min Skew",
              "type": "number"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "max_skew",
            "required": false,
            "schema": {
              "description": "The maximum skew. Decimal proxy for percentage (0 to 1). Min: 0. Max: 1.",
              "example": 0.7,
              "maximum": 1,
              "minimum": 0,
              "title": "Flow Alerts Max Skew",
              "type": "number"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "min_days_between_expiry_and_earnings",
            "required": false,
            "schema": {
              "description": "Minimum value of (contract_expiry_date - underlying_next_earnings_date) in days. Negative = contract expires BEFORE earnings; zero = same day; positive = AFTER earnings. Use together with `max_days_between_expiry_and_earnings` to target a window around the next earnings announcement. Examples: to exclude contracts that expire after the next earnings, set `max_days_between_expiry_and_earnings=-1`. To target contracts that expire the same week as (and after) earnings, set `min_days_between_expiry_and_earnings=1&max_days_between_expiry_and_earnings=6`. Contracts whose underlying has no known next earnings date are excluded whenever this filter is used.",
              "example": 1,
              "title": "MinDaysBetweenExpiryAndEarnings",
              "type": "integer"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "max_days_between_expiry_and_earnings",
            "required": false,
            "schema": {
              "description": "Maximum value of (contract_expiry_date - underlying_next_earnings_date) in days. Negative = contract expires BEFORE earnings; zero = same day; positive = AFTER earnings. Use together with `min_days_between_expiry_and_earnings` to target a window around the next earnings announcement. Examples: to exclude contracts that expire after the next earnings, set `max_days_between_expiry_and_earnings=-1`. To target contracts that expire the same week as (and after) earnings, set `min_days_between_expiry_and_earnings=1&max_days_between_expiry_and_earnings=6`. Contracts whose underlying has no known next earnings date are excluded whenever this filter is used.",
              "example": 6,
              "title": "MaxDaysBetweenExpiryAndEarnings",
              "type": "integer"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "min_dte",
            "required": false,
            "schema": {
              "description": "The minimum days to expiry. Min: 0.",
              "example": 1,
              "minimum": 0,
              "title": "Min DTE",
              "type": "integer"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "max_dte",
            "required": false,
            "schema": {
              "description": "The maximum days to expiry. Min: 0.",
              "example": 3,
              "minimum": 0,
              "title": "Max DTE",
              "type": "integer"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "min_earnings_dte",
            "required": false,
            "schema": {
              "description": "The minimum days until the next earnings report.",
              "example": 5,
              "title": "Min Earnings DTE",
              "type": "integer"
            }
          },
          {
            "description": "",
