                  "arbitrage"
                ],
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "trade_codes[]",
            "required": false,
            "schema": {
              "description": "OPRA trade code of the executed transaction.",
              "example": [
