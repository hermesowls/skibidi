      {
        "description": "",
        "in": "query",
        "name": "min_diff",
        "required": false,
        "schema": {
          "description": "The minimum OTM diff of a contract.\nGiven a strike price of 120 and an underlying price of 98\nthe diff for a call option would equal to:\n(120 - 98) / 98 = 0.2245\n\nThe diff for a put option would equal to:\n-1 * (120 - 98) / 98 = -0.2245.\n",
          "example": 0.53,
          "title": "Min Contract Diff",
          "type": "string"
        }
      },
      {
        "description": "",
        "in": "query",
        "name": "max_diff",
        "required": false,
        "schema": {
          "description": "The maximum OTM diff of a contract.\nGiven a strike price of 120 and an underlying price of 98\nthe diff for a call option would equal to:\n(120 - 98) / 98 = 0.2245\n\nThe diff for a put option would equal to:\n-1 * (120 - 98) / 98 = -0.2245.\n",
