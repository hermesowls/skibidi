        "description": "",
        "in": "path",
        "name": "candle_size",
        "required": true,
        "schema": {
          "enum": [
            "1m",
            "5m",
            "10m",
            "15m",
            "30m",
            "1h",
            "4h",
            "1d",
            "1w"
          ],
          "type": "string"
        }
      },
      {
        "description": "",
        "in": "query",
        "name": "timeframe",
        "required": false,
        "schema": {
          "default": "1Y",
          "description": "The timeframe of the data to return.\nCan be one of the following formats:\n- YTD\n- 1D, 2D, etc.\n- 1W, 2W, etc.\n- 1M, 2M, etc.\n- 1Y, 2Y, etc.\n",
          "example": "2M",
          "title": "Time frame",
          "type": "string"
        }
      },
      {
        "description": "",
        "in": "query",
        "name": "end_date",
