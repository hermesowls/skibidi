    "operationId": "PublicApi.PrivateMarketsController.funding",
    "parameters": [
      {
        "description": "",
        "in": "path",
        "name": "npm_ticker",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "description": "",
        "in": "query",
        "name": "limit",
        "required": false,
        "schema": {
          "type": "integer"
        }
      },
      {
        "description": "",
        "in": "query",
        "name": "offset",
        "required": false,
        "schema": {
