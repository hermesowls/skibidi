  "key": "GET /api/private-markets/companies",
  "method": "GET",
  "path": "/api/private-markets/companies",
  "transport": "http-rest",
  "operation": {
    "callbacks": {},
    "description": "Returns Nasdaq Private Markets companies, optionally filtered by sector or name. Sorted alphabetically.\n\nThis is a premium endpoint. Contact dev@unusualwhales.com to request access.\n",
