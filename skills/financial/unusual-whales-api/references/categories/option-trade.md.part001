```

## GET /api/option-trades/flow-alerts/{id}

Flow Alert by ID

Returns the trades that made up the specific alert. For multi leg flow alert trades it will
return all the related multi leg trades.
For alerts such as RepeatedHits it will return all the transactions that made up that alert.


### Fully resolved operation
```json
{
  "key": "GET /api/option-trades/flow-alerts/{id}",
  "method": "GET",
  "path": "/api/option-trades/flow-alerts/{id}",
  "transport": "http-rest",
  "operation": {
    "callbacks": {},
    "description": "Returns the trades that made up the specific alert. For multi leg flow alert trades it will\nreturn all the related multi leg trades.\nFor alerts such as RepeatedHits it will return all the transactions that made up that alert.\n",
    "operationId": "PublicApi.OptionTradeController.flow_alert",
    "parameters": [
      {
        "description": "The UUID of the flow alert",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      },
      {
        "description": "",
        "in": "query",
        "name": "older_than",
        "required": false,
        "schema": {
          "description": "The unix time in milliseconds or seconds at which no newer results will be returned. Can be used with `newer_than` to paginate by time. Also accepts an ISO date or RFC 3339 datetime (example: 2024-01-25).",
          "example": 1715083417,
          "title": "OlderThan",
          "type": "string"
        }
      }
    ],
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "description": "Detailed flow alert with associated trades.",
              "example": {
                "alert": {
                  "all_opening_trades": false,
                  "ask": "2.1",
                  "bid": "1.85",
                  "created_at": "2026-03-11 15:17:55.477300+00:00",
                  "end_time": 1773242266346,
                  "expiry": "2026-04-17",
                  "expiry_count": 1,
                  "has_floor": true,
                  "has_multileg": true,
                  "has_singleleg": false,
                  "has_sweep": false,
