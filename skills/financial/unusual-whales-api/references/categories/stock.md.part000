## GET /api/stock/{ticker}/atm-chains

ATM Chains

Returns the ATM chains for the given expirations


### Fully resolved operation
```json
{
  "key": "GET /api/stock/{ticker}/atm-chains",
  "method": "GET",
  "path": "/api/stock/{ticker}/atm-chains",
  "transport": "http-rest",
  "operation": {
    "callbacks": {},
    "description": "Returns the ATM chains for the given expirations\n",
    "operationId": "PublicApi.TickerController.atm_chains",
    "parameters": [
      {
        "description": "",
        "in": "path",
        "name": "ticker",
        "required": true,
        "schema": {
          "description": "A single ticker",
          "example": "AAPL",
          "title": "SingleTicker",
          "type": "string"
        }
      },
      {
        "description": "",
        "in": "query",
        "name": "expirations[]",
        "required": true,
        "schema": {
          "description": "An array of 1 or more expiry dates.",
          "example": [
            "2024-02-02",
            "2024-01-26"
          ],
          "items": {
            "description": "A single expiry date in ISO date format.",
            "example": "2024-02-02",
            "title": "Single expiry date",
            "type": "string"
          },
          "title": "Expiry dates",
          "type": "array"
        }
      }
    ],
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "description": "",
              "example": {
                "data": [
                  {
                    "ask_side_volume": 119403,
                    "avg_price": "1.0465802437910297887119234370",
                    "bid_side_volume": 122789,
                    "chain_prev_close": "1.29",
                    "close": "0.03",
                    "cross_volume": 0,
                    "er_time": "unknown",
                    "expiry": "2023-09-08",
                    "floor_volume": 142,
                    "high": "2.95",
                    "last_fill": "2023-09-08 17:45:32+00:00",
                    "low": "0.02",
                    "mid_volume": 22707,
                    "multileg_volume": 7486,
                    "next_earnings_date": "2023-10-18",
                    "no_side_volume": 0,
                    "open": "0.92",
                    "open_interest": 18680,
                    "option_symbol": "TSLA230908C00255000",
                    "option_type": "call",
                    "premium": "27723806.00",
                    "sector": "Consumer Cyclical",
                    "stock_multi_leg_volume": 52,
                    "stock_price": "247.94",
                    "strike": "255.0",
                    "sweep_volume": 18260,
                    "ticker_vol": 2546773,
                    "total_ask_changes": 44343,
                    "total_bid_changes": 43939,
                    "trades": 39690,
                    "volume": 264899
                  }
                ]
              },
              "properties": {
                "ask_side_volume": {
                  "description": "The amount of volume that happened on the ask side.\n\nAsk side is defined as (ask + bid) / 2 < fill price.\n",
                  "example": 119403,
                  "title": "Option Contract Ask Volume",
                  "type": "integer"
                },
                "avg_price": {
                  "description": "The volume weighted average fill price of the contract.",
                  "example": "1.0465802437910297887119234370",
                  "title": "Option Contract Avg Price",
                  "type": "string"
                },
                "bid_side_volume": {
                  "description": "The amount of volume that happened on the bid side.\n\nBid side is defined as (ask + bid) / 2 > fill price.\n",
                  "example": 122789,
                  "title": "Option Contract Bid Volume",
                  "type": "integer"
                },
                "chain_prev_close": {
                  "description": "The previous trading day's contract price.",
                  "example": "1.29",
                  "title": "Option Contract Previous Close Price",
                  "type": "string"
                },
                "close": {
                  "description": "The last fill on the contract.",
                  "example": "0.03",
                  "title": "Option Contract Close",
                  "type": "string"
                },
                "cross_volume": {
                  "description": "The amount of cross volume.\nCross volume consists of all transaction that have the cross trade code.\n",
                  "example": 0,
                  "title": "Option Contract Cross Volume",
                  "type": "integer"
                },
                "er_time": {
                  "description": "The time when the earnings will be released.",
                  "enum": [
                    "unknown",
                    "afterhours",
                    "premarket"
                  ],
                  "example": "premarket",
                  "title": "Stock Earnings time",
                  "type": "string"
                },
                "expiry": {
                  "description": "The contract expiry date in ISO format.",
                  "example": "2023-12-22",
                  "title": "Option Contract Expiry",
                  "type": "string"
                },
                "floor_volume": {
                  "description": "The amount of floor volume.\nFloor volume consists of all transaction that have the floor trade code.\n",
                  "example": 142,
                  "title": "Option Contract Floor Volume",
                  "type": "integer"
                },
                "high": {
                  "description": "The highest fill on that contract.",
                  "example": "2.95",
                  "title": "Option Contract High",
                  "type": "string"
                },
                "last_fill": {
                  "description": "The last time there was a transaction for the given contract as UTC timestamp.",
                  "example": "2023-09-08 17:45:32+00:00",
                  "title": "Option Contract Last Transaction Time",
                  "type": "string"
                },
                "low": {
                  "description": "The lowest fill on that contract.",
                  "example": "0.02",
                  "title": "Option Contract Low",
                  "type": "string"
                },
                "mid_volume": {
                  "description": "The amount of volume that happened in the middle of the ask and bid.\n\nMid is defined as (ask + bid) / 2 == fill price.\n",
                  "example": 22707,
                  "title": "Option Contract Mid Volume",
                  "type": "integer"
                },
                "multileg_volume": {
                  "description": "The amount of volume that happened as part of a multileg trade with another contract.\nThis can be spreads/rolls/condors/butterflies and more.\n",
                  "example": 7486,
                  "title": "Option Contract Multi Leg Volume",
                  "type": "integer"
                },
                "next_earnings_date": {
                  "description": "The next earnings date of the ticker. Null if either unknown as of now or if the ticker does not have any earnings such as an ETF",
                  "example": "2023-10-26",
                  "format": "date",
                  "title": "Stock Next Earnings Date",
                  "type": "string"
                },
                "no_side_volume": {
                  "description": "The amount of volume that happened on no identifiable side.\nThis can be late, out of sequence and/or cross transactions.\n",
                  "example": 0,
                  "title": "Option Contract No Side Volume",
                  "type": "integer"
                },
                "open": {
                  "description": "The first fill on that contract.",
                  "example": "0.92",
                  "title": "Option Contract Open",
                  "type": "string"
                },
                "open_interest": {
                  "description": "The open interest for the contract.",
                  "example": 18680,
                  "title": "Option Contract Open interest",
                  "type": "integer"
                },
                "option_symbol": {
                  "description": "The option symbol of the contract.\n\nYou can use the following regex to extract underlying ticker, option type, expiry & strike:\n`^(?<symbol>[\\w]*)(?<expiry>(\\d{2})(\\d{2})(\\d{2}))(?<type>[PC])(?<strike>\\d{8})$`\n\nKeep in mind that the strike needs to be multiplied by 1,000.\n",
                  "title": "Option Contract Symbol",
                  "type": "string"
                },
                "option_type": {
                  "description": "The option type of the contract.",
                  "enum": [
                    "call",
                    "put"
                  ],
                  "example": "call",
                  "title": "Option Contract Option Type",
                  "type": "string"
                },
                "premium": {
                  "description": "The total option premium.",
                  "example": "27723806.00",
                  "title": "Option Contract Premium",
                  "type": "string"
                },
                "sector": {
                  "description": "The financial sector of the ticker. Empty if unknown or not applicable such as ETF/Index.",
                  "enum": [
                    "Basic Materials",
                    "Communication Services",
                    "Consumer Cyclical",
                    "Consumer Defensive",
                    "Energy",
                    "Financial Services",
                    "Healthcare",
                    "Industrials",
                    "Real Estate",
                    "Technology",
                    "Utilities"
                  ],
                  "example": "Technology",
                  "title": "Market General Sector",
                  "type": "string"
                },
                "stock_multi_leg_volume": {
                  "description": "The amount of volume that happened as part of a stock transaction and possibly other option contracts.\nThis can be covered calls and more.\n",
                  "example": 52,
                  "title": "Option Contract Stock Multi Leg Volume",
                  "type": "integer"
                },
                "stock_price": {
                  "description": "The close stock price of the ticker.",
                  "example": "182.91",
                  "title": "Stock Close Price",
                  "type": "string"
                },
                "strike": {
                  "description": "The contract strike.",
                  "example": "375",
                  "title": "Option Contract Strike",
                  "type": "string"
                },
                "sweep_volume": {
                  "description": "The amount of sweep volume.\nSweep volume consists of all transaction that have the sweep trade code.\n",
                  "example": 18260,
                  "title": "Option Contract Sweep Volume",
                  "type": "integer"
                },
                "ticker_vol": {
                  "description": "The total amount of options volume for the given ticker.",
                  "title": "Stock Total Volume",
                  "type": "integer"
                },
                "total_ask_changes": {
                  "description": "The total count of changes to the NBBO ask during that day's trading session.",
                  "example": 165,
                  "title": "Option Contract Total Ask Changes",
                  "type": "integer"
                },
                "total_bid_changes": {
                  "description": "The total count of changes to the NBBO bid during that day's trading session.",
                  "example": 28,
                  "title": "Option Contract Total Bid Changes",
                  "type": "integer"
                },
                "trades": {
                  "description": "The amount of transaction for this contract.",
                  "example": 39690,
                  "title": "Option Contract Total Trades Count",
                  "type": "integer"
                },
                "volume": {
                  "description": "The contract volume.",
                  "example": 264899,
                  "title": "Option Contract Volume",
                  "type": "integer"
                }
              },
              "title": "Option Contract Screener response.",
              "type": "object"
            }
          }
        },
        "description": ""
      },
