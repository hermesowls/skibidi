          "description": "FDA target date in one of the following formats:\n- YYYY-Q[1-4] (e.g. 2024-Q1)\n- YYYY-H[1-2] (e.g. 2024-H1)\n- YYYY-MID (e.g. 2024-MID)\n- YYYY-LATE (e.g. 2024-LATE)\n- YYYY-MM-DD\n",
          "example": "2024-Q1",
          "pattern": "^\\d{4}-(Q[1-4]|H[1-2]|MID|LATE|\\d{2}-\\d{2})$",
          "title": "FDA Target Date",
          "type": "string"
        }
      },
      {
        "description": "Filter by drug name (partial match)",
        "in": "query",
        "name": "drug",
        "required": false,
        "schema": {
          "description": "Drug name to filter FDA calendar entries (partial match supported)",
          "example": "Keytruda",
          "title": "Drug Name",
          "type": "string"
        }
      },
      {
        "description": "Filter by ticker symbol",
        "in": "query",
        "name": "ticker",
