    "description": "Returns the correlations between a list of tickers.\nDate must be the current or a past date. If no date is given, returns data for the current/last market day.\n\nYou can filter the time period either by:\n1. Using the `interval` parameter (e.g. \"1y\", \"6m\", \"3m\", \"1m\")\n2. Using `start_date` and optionally `end_date` (if `end_date` is not provided, it defaults to the current date)\n\nIf you send `interval` alongside `start_date`, `interval` filter will take priority.\n",
    "operationId": "PublicApi.MarketController.correlations",
    "parameters": [
      {
        "description": "",
        "in": "query",
        "name": "tickers",
        "required": true,
        "schema": {
          "description": "A comma separated list of tickers. To exclude certain tickers prefix the first ticker with a `-`.",
          "example": "AAPL,INTC",
          "title": "Ticker",
          "type": "string"
        }
      },
      {
        "description": "",
        "in": "query",
        "name": "interval",
        "required": false,
        "schema": {
          "default": "1Y",
          "description": "The timeframe of the data to return.\nCan be one of the following formats:\n- YTD\n- 1D, 2D, etc.\n- 1W, 2W, etc.\n- 1M, 2M, etc.\n- 1Y, 2Y, etc.\n",
          "example": "2M",
          "title": "Time frame",
          "type": "string"
        }
      },
      {
        "description": "",
        "in": "query",
        "name": "start_date",
        "required": false,
        "schema": {
          "description": "A date in the format of YYYY-MM-DD to start the correlation calculation from.\nThis is optional and works alongside end_date to define a specific time range.\nCan be used as an alternative to the interval parameter.\n",
