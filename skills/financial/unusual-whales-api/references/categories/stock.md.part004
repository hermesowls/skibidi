                  "type": "string"
                },
                "percentile": {
                  "description": "Percentile ranking of this volatility value over a 1y period",
                  "example": "77.193",
                  "type": "string"
                },
                "volatility": {
                  "description": "Interpolated implied volatility value",
                  "example": "0.299",
                  "type": "string"
                }
              },
              "title": "Interpolated IV",
              "type": "object"
            }
