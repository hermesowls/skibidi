## GET /api/stock/{ticker}/option-contracts

Option contracts

Returns all option contracts for the given ticker.

Each row includes the NBBO bid and ask, implied volatility and per-contract delta, gamma, theta, vega
and rho, so quotes and greeks are available in one call. Charm and vanna are not included. Use
`/api/stock/{ticker}/greeks` and join this response's `option_symbol` to `call_option_symbol` or
`put_option_symbol` for those values.


### Fully resolved operation
```json
{
  "key": "GET /api/stock/{ticker}/option-contracts",
  "method": "GET",
  "path": "/api/stock/{ticker}/option-contracts",
  "transport": "http-rest",
  "operation": {
    "callbacks": {},
    "description": "Returns all option contracts for the given ticker.\n\nEach row includes the NBBO bid and ask, implied volatility and per-contract delta, gamma, theta, vega\nand rho, so quotes and greeks are available in one call. Charm and vanna are not included. Use\n`/api/stock/{ticker}/greeks` and join this response's `option_symbol` to `call_option_symbol` or\n`put_option_symbol` for those values.\n",
    "operationId": "PublicApi.OptionContractController.option_contracts",
    "parameters": [
      {
        "description": "",
        "in": "path",
        "name": "ticker",
        "required": true,
        "schema": {
          "description": "A single ticker",
          "example": "AAPL",
          "title": "SingleTicker",
          "type": "string"
        }
      },
      {
        "description": "",
        "in": "query",
        "name": "expiry",
        "required": false,
        "schema": {
          "description": "A single expiry date in ISO date format.",
          "example": "2024-02-02",
          "title": "Single expiry date",
          "type": "string"
        }
      },
      {
        "description": "",
        "in": "query",
        "name": "option_type",
        "required": false,
        "schema": {
          "description": "The option type to filter by if specified.",
          "enum": [
            "call",
            "Call",
            "put",
            "Put"
          ],
          "title": "OptionType",
          "type": "string"
        }
      },
      {
        "description": "Wether to only return chains where volume > open interest",
        "example": true,
        "in": "query",
        "name": "vol_greater_oi",
        "required": false,
        "schema": {
          "type": "boolean"
        }
      },
      {
        "description": "Wether to only return chains where volume > 0",
        "example": true,
        "in": "query",
        "name": "exclude_zero_vol_chains",
        "required": false,
        "schema": {
          "type": "boolean"
        }
      },
      {
        "description": "Wether to only return chains which do not expire on the same day",
        "example": true,
        "in": "query",
        "name": "exclude_zero_dte",
        "required": false,
        "schema": {
          "type": "boolean"
        }
      },
      {
        "description": "Wether to only return chains where open interest > 0",
        "example": true,
        "in": "query",
        "name": "exclude_zero_oi_chains",
        "required": false,
        "schema": {
          "type": "boolean"
        }
      },
      {
        "description": "Wether to only return chains which are out of the money",
        "example": true,
        "in": "query",
        "name": "maybe_otm_only",
        "required": false,
        "schema": {
          "type": "boolean"
        }
      },
      {
        "description": "Minimum days to expiration (expiry at least this many days from today).",
        "in": "query",
        "name": "min_dte",
        "required": false,
        "schema": {
          "type": "integer"
        }
      },
      {
        "description": "Maximum days to expiration (expiry at most this many days from today).",
        "in": "query",
        "name": "max_dte",
        "required": false,
        "schema": {
          "type": "integer"
        }
      },
      {
        "description": "Options symbols to filter by",
        "in": "query",
        "name": "option_symbol[]",
        "required": false,
        "schema": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      {
        "description": "",
        "in": "query",
        "name": "limit",
        "required": false,
        "schema": {
          "default": 500,
          "description": "How many items to return. Default: 500. Max: 500. Min: 1.",
          "example": 10,
          "maximum": 500,
          "minimum": 1,
          "title": "Default 500 Max 500 Min 1",
          "type": "integer"
        }
      },
      {
        "description": "",
        "in": "query",
        "name": "page",
        "required": false,
        "schema": {
          "description": "Page number (use with limit). Starts on page 0.",
          "example": 1,
          "title": "Page",
          "type": "integer"
        }
      }
    ],
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "description": "All option contracts for a ticker",
              "example": {
                "data": [
                  {
                    "ask_volume": 56916,
                    "avg_price": "0.77927817593516586531",
                    "bid_volume": 68967,
                    "delta": "-0.187",
                    "floor_volume": 1815,
                    "gamma": "0.021",
                    "high_price": "5.75",
                    "implied_volatility": "0.542805337797143",
                    "last_price": "0.01",
                    "last_tape_time": "2024-02-01 20:59:58+00:00",
                    "low_price": "0.01",
                    "mid_volume": 6393,
                    "multi_leg_volume": 9871,
                    "nbbo_ask": "0.01",
                    "nbbo_bid": "0",
                    "no_side_volume": 6393,
                    "open_interest": 22868,
                    "option_symbol": "AAPL240202P00185000",
                    "prev_oi": 20217,
                    "rho": "-0.015",
                    "stock_multi_leg_volume": 13,
                    "sweep_volume": 12893,
                    "theta": "-0.043",
                    "total_premium": "10307980.00",
                    "vega": "0.089",
                    "volume": 132276
