  "key": "GET /api/politician-portfolios/disclosures",
  "method": "GET",
  "path": "/api/politician-portfolios/disclosures",
  "transport": "http-rest",
  "operation": {
    "callbacks": {},
    "description": "Returns all annual disclosure file records for politicians.\nCan be filtered by politician_id and/or limited to latest per politician.\n\nThis is an enterprise only endpoint. Contact dev@unusualwhales.com for details about accessing this data.\n",
    "operationId": "PublicApi.PoliticianPortfoliosController.disclosures",
    "parameters": [
      {
        "description": "Filter by politician ID",
