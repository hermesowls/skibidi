    "parameters": [
      {
        "description": "Stock ticker symbol (e.g., AAPL, TSLA)",
        "in": "path",
        "name": "ticker",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "description": "If true, aggregates all of a politicians portfolios into a single portfolio named 'aggregated'. Default is false. Note that this does not aggregate holdings within a portfolio, only across portfolios.",
