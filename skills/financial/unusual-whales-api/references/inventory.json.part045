    {
      "key": "GET /api/stock/{ticker}/option-contracts",
      "method": "GET",
      "path": "/api/stock/{ticker}/option-contracts",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns all option contracts for the given ticker.\n\nEach row includes the NBBO bid and ask, implied volatility and per-contract delta, gamma, theta, vega\nand rho, so quotes and greeks are available in one call. Charm and vanna are not included. Use\n`/api/stock/{ticker}/greeks` and join this response's `option_symbol` to `call_option_symbol` or\n`put_option_symbol` for those values.\n",
        "operationId": "PublicApi.OptionContractController.option_contracts",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "expiry",
            "required": false,
            "schema": {
              "description": "A single expiry date in ISO date format.",
              "example": "2024-02-02",
              "title": "Single expiry date",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "option_type",
            "required": false,
            "schema": {
              "description": "The option type to filter by if specified.",
              "enum": [
                "call",
                "Call",
                "put",
                "Put"
              ],
              "title": "OptionType",
              "type": "string"
            }
          },
          {
            "description": "Wether to only return chains where volume > open interest",
            "example": true,
            "in": "query",
            "name": "vol_greater_oi",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Wether to only return chains where volume > 0",
            "example": true,
            "in": "query",
            "name": "exclude_zero_vol_chains",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Wether to only return chains which do not expire on the same day",
            "example": true,
            "in": "query",
            "name": "exclude_zero_dte",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Wether to only return chains where open interest > 0",
            "example": true,
            "in": "query",
            "name": "exclude_zero_oi_chains",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Wether to only return chains which are out of the money",
            "example": true,
            "in": "query",
            "name": "maybe_otm_only",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Minimum days to expiration (expiry at least this many days from today).",
            "in": "query",
            "name": "min_dte",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Maximum days to expiration (expiry at most this many days from today).",
            "in": "query",
            "name": "max_dte",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Options symbols to filter by",
            "in": "query",
            "name": "option_symbol[]",
            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 500,
              "description": "How many items to return. Default: 500. Max: 500. Min: 1.",
              "example": 10,
              "maximum": 500,
              "minimum": 1,
              "title": "Default 500 Max 500 Min 1",
              "type": "integer"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "description": "Page number (use with limit). Starts on page 0.",
              "example": 1,
              "title": "Page",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "All option contracts for a ticker",
                  "example": {
                    "data": [
                      {
                        "ask_volume": 56916,
                        "avg_price": "0.77927817593516586531",
                        "bid_volume": 68967,
                        "delta": "-0.187",
                        "floor_volume": 1815,
                        "gamma": "0.021",
                        "high_price": "5.75",
                        "implied_volatility": "0.542805337797143",
                        "last_price": "0.01",
                        "last_tape_time": "2024-02-01 20:59:58+00:00",
                        "low_price": "0.01",
                        "mid_volume": 6393,
                        "multi_leg_volume": 9871,
                        "nbbo_ask": "0.01",
                        "nbbo_bid": "0",
                        "no_side_volume": 6393,
                        "open_interest": 22868,
                        "option_symbol": "AAPL240202P00185000",
                        "prev_oi": 20217,
                        "rho": "-0.015",
                        "stock_multi_leg_volume": 13,
                        "sweep_volume": 12893,
                        "theta": "-0.043",
                        "total_premium": "10307980.00",
                        "vega": "0.089",
                        "volume": 132276
                      },
                      {
                        "ask_volume": 54820,
                        "avg_price": "0.19195350495251190385",
                        "bid_volume": 60784,
                        "floor_volume": 0,
                        "high_price": "0.80",
                        "implied_volatility": "0.462957019859562",
                        "last_price": "0.01",
                        "low_price": "0.01",
                        "mid_volume": 2215,
                        "multi_leg_volume": 5301,
                        "nbbo_ask": "0.01",
                        "nbbo_bid": "0",
                        "no_side_volume": 2215,
                        "open_interest": 19352,
                        "option_symbol": "AAPL240202C00187500",
                        "prev_oi": 18135,
                        "stock_multi_leg_volume": 9,
                        "sweep_volume": 11152,
                        "total_premium": "2261577.00",
                        "volume": 117819
                      }
                    ]
                  },
                  "properties": {
                    "ask_volume": {
                      "description": "The amount of volume that happened on the ask side.\n\nAsk side is defined as (ask + bid) / 2 < fill price.\n",
                      "example": 119403,
                      "title": "Option Contract Ask Volume",
                      "type": "integer"
                    },
                    "avg_price": {
                      "description": "The volume weighted average fill price of the contract.",
                      "example": "1.0465802437910297887119234370",
                      "title": "Option Contract Avg Price",
                      "type": "string"
                    },
                    "bid_volume": {
                      "description": "The amount of volume that happened on the bid side.\n\nBid side is defined as (ask + bid) / 2 > fill price.\n",
                      "example": 122789,
                      "title": "Option Contract Bid Volume",
                      "type": "integer"
                    },
                    "cross_volume": {
                      "description": "The amount of cross volume.\nCross volume consists of all transaction that have the cross trade code.\n",
                      "example": 0,
                      "title": "Option Contract Cross Volume",
                      "type": "integer"
                    },
                    "delta": {
                      "description": "First-order greek: delta.",
                      "example": "0.42",
                      "nullable": true,
                      "type": "string"
                    },
                    "floor_volume": {
                      "description": "The amount of floor volume.\nFloor volume consists of all transaction that have the floor trade code.\n",
                      "example": 142,
                      "title": "Option Contract Floor Volume",
                      "type": "integer"
                    },
                    "gamma": {
                      "description": "First-order greek: gamma.",
                      "example": "0.031",
                      "nullable": true,
                      "type": "string"
                    },
                    "high_price": {
                      "description": "The highest fill on that contract.",
                      "example": "2.95",
                      "title": "Option Contract High",
                      "type": "string"
                    },
                    "implied_volatility": {
                      "description": "The implied volatility for the last transaction.",
                      "example": "0.675815680048166",
                      "title": "Option Contract Last Transaction IV",
                      "type": "string"
                    },
                    "last_price": {
                      "description": "The last fill on the contract.",
                      "example": "0.03",
                      "title": "Option Contract Close",
                      "type": "string"
                    },
                    "last_tape_time": {
                      "description": "As-of timestamp anchoring row freshness — the contract's last trade (tape) time. Approximate for NBBO freshness (it is trade time, not a dedicated quote timestamp).",
                      "format": "date-time",
                      "nullable": true,
                      "type": "string"
                    },
                    "low_price": {
                      "description": "The lowest fill on that contract.",
                      "example": "0.02",
                      "title": "Option Contract Low",
                      "type": "string"
                    },
                    "mid_volume": {
                      "description": "The amount of volume that happened in the middle of the ask and bid.\n\nMid is defined as (ask + bid) / 2 == fill price.\n",
                      "example": 22707,
                      "title": "Option Contract Mid Volume",
                      "type": "integer"
                    },
                    "multi_leg_volume": {
                      "description": "The amount of volume that happened as part of a multileg trade with another contract.\nThis can be spreads/rolls/condors/butterflies and more.\n",
                      "example": 7486,
                      "title": "Option Contract Multi Leg Volume",
                      "type": "integer"
                    },
                    "nbbo_ask": {
                      "description": "The National Best Bid and Offer (NBBO) ask price.",
                      "example": "0.03",
                      "title": "NBBO Ask",
                      "type": "string"
                    },
                    "nbbo_bid": {
                      "description": "The National Best Bid and Offer (NBBO) bid price.",
                      "example": "0.03",
                      "title": "NBBO Bid",
                      "type": "string"
                    },
                    "no_side_volume": {
                      "description": "The amount of volume that happened on no identifiable side.\nThis can be late, out of sequence and/or cross transactions.\n",
                      "example": 0,
                      "title": "Option Contract No Side Volume",
                      "type": "integer"
                    },
                    "open_interest": {
                      "description": "The open interest for the contract.",
                      "example": 18680,
                      "title": "Option Contract Open interest",
                      "type": "integer"
                    },
                    "option_symbol": {
                      "description": "The option symbol of the contract.\n\nYou can use the following regex to extract underlying ticker, option type, expiry & strike:\n`^(?<symbol>[\\w]*)(?<expiry>(\\d{2})(\\d{2})(\\d{2}))(?<type>[PC])(?<strike>\\d{8})$`\n\nKeep in mind that the strike needs to be multiplied by 1,000.\n",
                      "title": "Option Contract Symbol",
                      "type": "string"
                    },
                    "prev_oi": {
                      "description": "The previous trading day's open interest.",
                      "example": 18680,
                      "title": "Option Contract Previous Open Interest",
                      "type": "integer"
                    },
                    "rho": {
                      "description": "First-order greek: rho.",
                      "example": "0.027",
                      "nullable": true,
                      "type": "string"
                    },
                    "stock_multi_leg_volume": {
                      "description": "The amount of volume that happened as part of a stock transaction and possibly other option contracts.\nThis can be covered calls and more.\n",
                      "example": 52,
                      "title": "Option Contract Stock Multi Leg Volume",
                      "type": "integer"
                    },
                    "sweep_volume": {
                      "description": "The amount of sweep volume.\nSweep volume consists of all transaction that have the sweep trade code.\n",
                      "example": 18260,
                      "title": "Option Contract Sweep Volume",
                      "type": "integer"
                    },
                    "theta": {
                      "description": "First-order greek: theta.",
                      "example": "-0.058",
                      "nullable": true,
                      "type": "string"
                    },
                    "total_premium": {
                      "description": "The total option premium.",
                      "example": "27723806.00",
                      "title": "Option Contract Premium",
                      "type": "string"
                    },
                    "vega": {
                      "description": "First-order greek: vega.",
                      "example": "0.112",
                      "nullable": true,
