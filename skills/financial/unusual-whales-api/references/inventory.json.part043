    {
      "key": "GET /api/stock/{ticker}/interpolated-iv/distribution",
      "method": "GET",
      "path": "/api/stock/{ticker}/interpolated-iv/distribution",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns one row per fixed maturity with the range of its interpolated implied volatility over the\n365 calendar days ending on `date`. Each row holds the minimum, first quartile, median, third quartile\nand maximum of the daily values, the value on `date`, and the share of daily values at or below it.\n\nThe response covers the 7, 30, 60, 90, 180 and 365 day maturities. Daily values at or below zero are\nignored, and a maturity without a positive value on `date` is omitted. Rows are ordered by maturity\nfrom shortest to longest. `date` defaults to the last trading day.\n",
        "operationId": "PublicApi.VolatilityController.interpolated_iv_distribution",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "The range of one fixed maturity's interpolated implied volatility over the 365 calendar days ending on `date`. Volatility values are annualized decimals, so `0.43` means 43%.",
                  "properties": {
                    "date": {
                      "example": "2026-09-18",
                      "format": "date",
                      "type": "string"
                    },
                    "days": {
                      "description": "The fixed maturity in calendar days. One of 7, 30, 60, 90, 180 or 365.",
                      "example": 30,
                      "type": "integer"
                    },
                    "first_date": {
                      "description": "The earliest trading day included in the lookback for the maturity.",
                      "example": "2025-09-19",
                      "format": "date",
                      "type": "string"
                    },
                    "max": {
                      "description": "The highest daily value in the lookback.",
                      "example": "0.648",
                      "type": "string"
                    },
                    "median": {
                      "description": "The median of the daily values, interpolated linearly and rounded to 6 decimals.",
                      "example": "0.461",
                      "type": "string"
                    },
                    "min": {
                      "description": "The lowest daily value in the lookback.",
                      "example": "0.369",
                      "type": "string"
                    },
                    "percentile": {
                      "description": "The share of daily values at or below `volatility`, from 0 to 1. The value on `date` counts as one of the daily values.",
                      "example": "0.1434",
                      "type": "string"
                    },
                    "q1": {
                      "description": "The first quartile of the daily values, interpolated linearly and rounded to 6 decimals.",
                      "example": "0.426",
                      "type": "string"
                    },
                    "q3": {
                      "description": "The third quartile of the daily values, interpolated linearly and rounded to 6 decimals.",
                      "example": "0.487",
                      "type": "string"
                    },
                    "samples": {
                      "description": "The number of daily values in the lookback, one per trading day with a positive value.",
                      "example": 251,
                      "type": "integer"
                    },
                    "ticker": {
                      "example": "TSLA",
                      "type": "string"
                    },
                    "volatility": {
                      "description": "The interpolated implied volatility of the maturity on `date`.",
                      "example": "0.412",
                      "type": "string"
                    }
                  },
                  "title": "Interpolated IV Distribution",
                  "type": "object"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
