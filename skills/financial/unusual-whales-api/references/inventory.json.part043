    {
      "key": "GET /api/stock/{ticker}/interpolated-iv",
      "method": "GET",
      "path": "/api/stock/{ticker}/interpolated-iv",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the Interpolated IV for a given trading day. If there is no expiration then the data is calcualted via linear interpolation\nwith the next 2 closest expirations\n\nDate must be the current or a past date. If no date is given, returns data for the current/last market day.\n",
        "operationId": "PublicApi.TickerController.interpolated_iv",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Interpolated implied volatility data for different time horizons",
                  "example": {
                    "data": [
                      {
                        "date": "2025-05-30",
                        "days": 1,
                        "implied_move_perc": "0.003",
                        "percentile": "100",
                        "volatility": "1.739"
                      },
                      {
                        "date": "2025-05-30",
                        "days": 5,
                        "implied_move_perc": "0.02",
                        "percentile": "94.737",
                        "volatility": "0.696"
                      },
                      {
                        "date": "2025-05-30",
                        "days": 7,
                        "implied_move_perc": "0.026",
                        "percentile": "52.632",
                        "volatility": "0.278"
                      },
                      {
                        "date": "2025-05-30",
                        "days": 14,
                        "implied_move_perc": "0.041",
                        "percentile": "68.421",
                        "volatility": "0.311"
                      },
                      {
                        "date": "2025-05-30",
                        "days": 30,
                        "implied_move_perc": "0.058",
                        "percentile": "77.193",
                        "volatility": "0.299"
                      }
                    ]
                  },
                  "properties": {
                    "date": {
                      "description": "A trading date in ISO format.\n",
                      "example": "2023-09-08",
                      "title": "Market General Trading day",
                      "type": "string"
                    },
                    "days": {
                      "description": "Number of days to expiration",
                      "example": 30,
                      "type": "integer"
                    },
                    "implied_move_perc": {
                      "description": "Expected move as a percentage of the current price",
                      "example": "0.058",
                      "type": "string"
                    },
                    "percentile": {
                      "description": "Percentile ranking of this volatility value over a 1y period",
                      "example": "77.193",
                      "type": "string"
                    },
                    "volatility": {
                      "description": "Interpolated implied volatility value",
                      "example": "0.299",
                      "type": "string"
                    }
                  },
                  "title": "Interpolated IV",
                  "type": "object"
                }
              }
            },
            "description": ""
          },
