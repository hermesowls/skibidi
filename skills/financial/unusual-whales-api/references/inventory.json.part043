    {
      "key": "GET /api/stock/{ticker}/iv-rank",
      "method": "GET",
      "path": "/api/stock/{ticker}/iv-rank",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the IV rank data for a ticker over a period of time.\nIV rank is a measure of where current implied volatility stands relative to its historical range.\n\nRows are returned oldest first, so the latest value is the last element. Sort by date or read the last\nrow before using the current value.\n",
        "operationId": "PublicApi.TickerController.iv_rank",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "timespan",
            "required": false,
            "schema": {
              "description": "Optional timespan parameter that can be used to specify a date range. Accepts values like '1y', '6m', '3m', '1m', '1w' or an ISO date (example: 2024-01-25).",
              "example": "1y",
              "title": "OptionalTimespan",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "The IV rank data for a ticker over a time period.\nIV rank is a measure of where current implied volatility stands relative to its historical range.\n",
                  "example": {
                    "data": [
                      {
                        "close": "180.50",
                        "date": "2024-01-22",
                        "iv_rank_1y": "0.65",
                        "updated_at": "2024-01-22 16:35:52.168490+00:00",
                        "volatility": "0.25"
