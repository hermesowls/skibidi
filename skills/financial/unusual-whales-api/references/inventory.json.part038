                          "surprise_percentage": {
                            "example": "2.5",
                            "nullable": true,
                            "type": "string"
                          },
                          "ticker": {
                            "example": "AAPL",
                            "type": "string"
                          },
                          "updated_at": {
                            "example": "2026-07-29 12:34:56+00:00",
                            "format": "date-time",
                            "type": "string"
                          }
                        },
                        "title": "Earnings Report",
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "title": "Earnings Response",
                  "type": "object"
                }
              }
            },
            "description": "Earnings History"
