                            "description": "Normalized to \"premarket\" / \"postmarket\"; earnings-calendar rows may pass through \"bmo\" / \"amc\".",
                            "example": "postmarket",
                            "nullable": true,
                            "type": "string"
                          },
                          "report_type": {
                            "enum": [
                              "annual",
                              "quarterly"
                            ],
                            "example": "quarterly",
                            "type": "string"
                          },
                          "reported_eps": {
                            "example": "1.64",
                            "nullable": true,
                            "type": "string"
                          },
                          "surprise": {
                            "example": "0.04",
                            "nullable": true,
                            "type": "string"
