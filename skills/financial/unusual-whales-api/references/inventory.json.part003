                        },
                        "statements": {
                          "items": {
                            "properties": {
                              "content": {
                                "nullable": true,
                                "type": "string"
                              },
                              "sentiment": {
                                "nullable": true,
                                "type": "number"
                              },
                              "speaker": {
                                "nullable": true,
                                "type": "string"
                              },
                              "title": {
                                "nullable": true,
                                "type": "string"
                              }
                            },
                            "title": "Transcript Statement",
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "ticker": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "title": "Transcript Response",
                  "type": "object"
                }
              }
            },
            "description": "Transcript"
          },
