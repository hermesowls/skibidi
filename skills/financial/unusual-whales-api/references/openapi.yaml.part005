    StockScreenerQueryHelp:
      properties:
        fields:
          items:
            properties:
              aliases:
                items:
                  type: string
                type: array
              description:
                nullable: true
                type: string
              kind:
                enum:
                  - number
                  - boolean
                  - symbol
                  - list
                  - keyword
                type: string
              name:
                type: string
            required:
              - name
              - aliases
              - kind
              - description
            type: object
          type: array
        functions:
          items:
            type: string
          type: array
        keywords:
          items:
            type: string
          type: array
        operators:
          items:
            type: string
          type: array
        scopes:
          items:
            type: string
          type: array
        syntax:
          properties:
            examples:
              items:
                type: string
              type: array
            format:
              enum:
                - EBNF
              type: string
            function_signatures:
              items:
                properties:
                  max_args:
                    description: Null when there is no upper argument limit.
                    nullable: true
                    type: integer
                  min_args:
                    type: integer
                  name:
                    type: string
                required:
                  - name
                  - min_args
                  - max_args
                type: object
              type: array
            grammar:
              description: EBNF grammar for constructing stock screener queries.
              type: string
            notes:
              items:
                type: string
              type: array
          required:
            - format
            - grammar
            - notes
            - examples
            - function_signatures
          type: object
        watchlists:
          description: Empty for this endpoint. Personal watchlists are not forwarded to the screener.
          items:
            type: string
          type: array
      required:
        - syntax
        - fields
        - keywords
        - operators
        - functions
        - scopes
        - watchlists
      title: StockScreenerQueryHelp
      type: object
    StockTradesMaxPremium:
      description: The maximum premium requested trades should have.
      example: 150000
      title: StockTradesMaxPremium
      type: integer
    StockTradesMaxSize:
      description: The maximum size requested trades should have. Must be a positive integer.
      example: 150000
      title: StockTradesMaxSize
      type: integer
    StockTradesMaxVol:
      description: The maximum consolidated volume requested trades should have. Must be a positive integer.
      example: 150000
      title: StockTradesMaxVol
      type: integer
    StockTradesMinPremium:
      default: 0
      description: The minimum premium requested trades should have.
      example: 50000
      minimum: 0
      title: StockTradesMinPremium
      type: integer
    StockTradesMinSize:
      default: 0
      description: The minimum size requested trades should have. Must be a positive integer.
      example: 50000
      minimum: 0
      title: StockTradesMinSize
      type: integer
    StockTradesMinVol:
      default: 0
      description: The minimum consolidated volume requested trades should have. Must be a positive integer.
      example: 50000
      minimum: 0
      title: StockTradesMinVol
      type: integer
    Stock_Average_30_Day_Volume:
      description: The avg stock volume for the stock last 30 days.
      example: '55973002'
      title: Stock Average 30 Day Volume
      type: string
    Stock_Beta:
      description: The beta coefficient measuring the stock's volatility relative to the overall market (typically S&P 500). A beta of 1 indicates the stock moves with the market, greater than 1 indicates higher volatility, and less than 1 indicates lower volatility.
      example: '1.25'
      title: Stock Beta
      type: string
    Stock_Close_Price:
      description: The close stock price of the ticker.
      example: '182.91'
      title: Stock Close Price
      type: string
    Stock_Company_Name:
      description: The name of the company.
      example: APPLE INC
      title: Stock Company Name
      type: string
    Stock_Day_Stock_Volume:
      description: The volume of the ticker for the trading day.
      example: 23132119
      title: Stock Day Stock Volume
      type: integer
    Stock_Earnings_time:
      description: The time when the earnings will be released.
      enum:
        - unknown
        - afterhours
        - premarket
      example: premarket
      title: Stock Earnings time
      type: string
    Stock_Expiry:
      description: The expiry of an options cycle as an ISO date.
      example: 2023-09-08
      title: Stock Expiry
      type: string
    Stock_Full_Name:
      description: Full name of the ticker.
      example: APPLE
      title: Stock Full Name
      type: string
    Stock_Has_Dividend:
      description: Boolean flag whether the company pays dividends.
      example: true
      title: Stock Has Dividend
      type: boolean
    Stock_Has_Earnings_History:
      description: Boolean flag whether historic earnings data is present.
      example: true
      title: Stock Has Earnings History
      type: boolean
    Stock_Has_Investment_Arm:
      description: Boolean flag whether the given stock is holding stocks of other companies.
      example: true
      title: Stock Has Investment Arm
      type: boolean
    Stock_Has_Options:
      description: Boolean flag whether the company has options.
      example: true
      title: Stock Has Options
      type: boolean
    Stock_High_Price:
      description: The high stock price of the ticker.
      example: '182.91'
      title: Stock High Price
      type: string
    Stock_Holding:
      description: A stock or ETF holding in a portfolio
      properties:
        max_amount:
          description: The maximum share quantity.
          example: 15
          type: number
        mid_amount:
          description: The midpoint share quantity.
          example: 7
          type: number
        min_amount:
          description: The minimum share quantity.
          example: 1
          type: number
        ticker:
          description: The stock ticker symbol.
          example: XYZ
          type: string
        type:
          description: The holding type.
          example: stock
          type: string
      title: Stock Holding
      type: object
    Stock_Implied_Move:
      description: The implied move of the underlying stock by a given date based on the money option contracts. It is calculated by multiplying the sum of the call and put price by 0.85. If no expiry date is included, then the implied move is for the nearest end of the week expiration (the nearest monthly expiration if there are no weekly contracts).
      example: '2.2398043036460877'
      title: Stock Implied Move
      type: string
    Stock_Implied_Move_Perc:
      description: The implied move as a percentage of the underlying stock price.
      example: '0.012247398860706955'
      title: Stock Implied Move Perc
      type: string
    Stock_Industry_Type:
      description: The industry type of the ticker.
      example: Semiconductors
      title: Stock Industry Type
      type: string
    Stock_Issue_Type:
      description: The issue type of the ticker.
      enum:
        - Common Stock
        - ETF
        - Index
        - ADR
      example: Common Stock
      title: Stock Issue Type
      type: string
    Stock_Last_Tape_Time:
      description: The last tape time of the data.
      example: 2023-09-07T20:06:00Z
      title: Stock Last Tape Time
      type: string
    Stock_Lit_Volume:
      description: The lit volume (this only represents stock trades executed on exchanges operated by Nasdaq).
      example: 19941285
      title: Stock Lit Volume
      type: integer
    Stock_Low_Price:
      description: The low stock price of the ticker.
      example: '182.91'
      title: Stock Low Price
      type: string
    Stock_Marketcap_AUM:
      description: The marketcap of the underlying ticker. If the issue type of the ticker is ETF then the marketcap represents the AUM.
      example: '2965813810400'
      title: Stock Marketcap AUM
      type: string
    Stock_Next_Earnings_Date:
      description: The next earnings date of the ticker. Null if either unknown as of now or if the ticker does not have any earnings such as an ETF
      example: 2023-10-26
      format: date
      title: Stock Next Earnings Date
      type: string
    Stock_Off_Lit_Volume:
      description: The off lit stock volume (this only represents the FINRA operated exchanges).
      example: 22074116
      title: Stock Off Lit Volume
      type: integer
    Stock_Open_Interest:
      description: The sum of open interest for all contracts.
      example: 451630
      title: Stock Open Interest
      type: integer
    Stock_Open_Price:
      description: The open stock price of the ticker.
      example: '182.91'
      title: Stock Open Price
      type: string
    Stock_Options_Volume:
      description: The sum of volume for all contracts.
      example: 962332
      title: Stock Options Volume
      type: integer
    Stock_Prev_Close_Price:
      description: The previous trading day's stock price of the ticker.
      example: '189.70'
      title: Stock Prev Close Price
      type: string
    Stock_Price_Level:
      description: The price level.
      example: '120.12'
      title: Stock Price Level
      type: string
    Stock_Quote:
      properties:
        last_trade:
          $ref: '#/components/schemas/Latest_Stock_Trade'
          description: Latest price forming trade, or null when unavailable.
          nullable: true
        market_time:
          $ref: '#/components/schemas/Stock_Quote_Market_Time'
        quote:
          $ref: '#/components/schemas/National_Best_Bid_and_Ask'
          description: Latest national best bid and ask, or null when unavailable.
          nullable: true
        quote_statistics:
          $ref: '#/components/schemas/Stock_Quote_Statistics'
        quote_values:
          $ref: '#/components/schemas/Derived_Stock_Quote_Values'
          description: Values derived from the latest quote, or null when no quote is available.
          nullable: true
      required:
        - market_time
        - quote_statistics
      title: Stock Quote
      type: object
    Stock_Quote_Error_Response:
      properties:
        error:
          properties:
            code:
              example: stock_quote_not_found
              type: string
            message:
              example: Stock quote not found
              type: string
          required:
            - code
            - message
          type: object
      required:
        - error
      title: Stock Quote Error Response
      type: object
    Stock_Quote_Level:
      properties:
        price:
          description: Price in US dollars.
          example: '775.660'
          type: string
        size:
          description: Number of shares available at this price.
          example: 240
          format: int64
          type: integer
      required:
        - price
        - size
      title: Stock Quote Level
      type: object
    Stock_Quote_Market_Time:
      description: Current US equity market session.
      enum:
        - regular
        - premarket
        - postmarket
      example: regular
      title: Stock Quote Market Time
      type: string
    Stock_Quote_Response:
      example:
        data:
          last_trade:
            price: '775.645'
            time: 1786636349747
            vol: 13548986
          market_time: regular
          quote:
            ask:
              price: '775.660'
              size: 240
            bid:
              price: '775.650'
              size: 80
            time: 1786636351248
          quote_statistics:
            postmarket:
              midpoint_changes: 0
              quote_changes: 0
              size_only_changes: 0
              spread_tightened: 0
              spread_unchanged: 0
              spread_widened: 0
            premarket:
              midpoint_changes: 12540
              quote_changes: 105322
              size_only_changes: 92782
              spread_tightened: 6440
              spread_unchanged: 92782
              spread_widened: 6100
            regular:
              midpoint_changes: 145814
              quote_changes: 1255891
              size_only_changes: 1110077
              spread_tightened: 74875
              spread_unchanged: 1110077
              spread_widened: 70939
          quote_values:
            midpoint: '775.655'
            quote_age_ms: 89
            size_imbalance: 0.5238095238095238
            size_weighted_midpoint: 775.657619047619
            spread: '0.010'
            spread_bps: 0.12892329708428238
      properties:
        data:
          $ref: '#/components/schemas/Stock_Quote'
      required:
        - data
      title: Stock Quote Response
      type: object
    Stock_Quote_Session_Statistics:
      description: Quote change and spread direction counters accumulated during one market session.
      properties:
        midpoint_changes:
          description: Quote changes where the arithmetic midpoint changed.
          example: 145814
          format: int64
          type: integer
        quote_changes:
          description: Updates where at least one bid or ask price or size changed.
          example: 1255891
          format: int64
          type: integer
        size_only_changes:
          description: Quote changes where size changed but bid and ask prices did not.
          example: 1110077
          format: int64
          type: integer
        spread_tightened:
          description: Quote changes where the ask minus bid spread decreased.
          example: 74875
          format: int64
          type: integer
        spread_unchanged:
          description: Quote changes where the ask minus bid spread did not change.
          example: 1110077
          format: int64
          type: integer
        spread_widened:
          description: Quote changes where the ask minus bid spread increased.
          example: 70939
          format: int64
          type: integer
      required:
        - midpoint_changes
        - quote_changes
        - size_only_changes
        - spread_tightened
        - spread_unchanged
        - spread_widened
      title: Stock Quote Session Statistics
      type: object
    Stock_Quote_Statistics:
      description: Quote change statistics grouped by US equity market session.
      properties:
        postmarket:
          $ref: '#/components/schemas/Stock_Quote_Session_Statistics'
        premarket:
          $ref: '#/components/schemas/Stock_Quote_Session_Statistics'
        regular:
          $ref: '#/components/schemas/Stock_Quote_Session_Statistics'
      required:
        - premarket
        - regular
        - postmarket
      title: Stock Quote Statistics
      type: object
    Stock_Screener_response:
      description: Matching stock screener rows. Decimal values are JSON strings.
      example:
        data:
          - ask: '212.37'
            ask_quantity: 200
            avg30_volume: '130548356.35'
            avg_30_day_call_oi: '8051988.5'
            avg_30_day_call_volume: '2249702.1667'
            avg_30_day_put_oi: '6761847.1333'
            avg_30_day_put_volume: '1233488.0333'
            avg_3_day_call_volume: '1827235'
            avg_3_day_put_volume: '1035420.3333'
            avg_7_day_call_volume: '2072806.2857'
            avg_7_day_put_volume: '1152390'
            bearish_premium: '251292082.00'
            bid: '212.22'
            bid_quantity: 1
            bullish_premium: '263159651.00'
            call_open_interest: 8264707
            call_premium: '386488449.00'
            call_premium_mid_side: '39629161.00'
            call_volume: 1154879
            call_volume_ask_side: 515816
            call_volume_bid_side: 559199
            call_volume_mid_side: 79840
            close: '212.32'
            cum_dir_delta: -677914
            cum_dir_gamma: -259659
            cum_dir_vega: -743026
