      title: Spot GEX exposures per 1min
      type: object
    Spot_Put_Charm_Ask_Side_Exposure:
      description: The put charm exposure when Market Makers are selling contracts when a transactions is closer to the ask side.
      example: '102382359.5786'
      title: Spot Put Charm Ask Side Exposure
      type: string
    Spot_Put_Charm_Bid_Side_Exposure:
      description: The put charm exposure when Market Makers are buying contracts when a transactions is closer to the bid side.
      example: '102382359.5786'
      title: Spot Put Charm Bid Side Exposure
      type: string
    Spot_Put_Charm_Exposure:
      description: The sum of the spot charm exposure values of all put transactions at a given strike.
      example: '102382359.5786'
      title: Spot Put Charm Exposure
      type: string
    Spot_Put_Delta_Ask_Side_Exposure:
      description: The put delta exposure when Market Makers are selling contracts when a transactions is closer to the ask side.
      example: '-191893077.7193'
      title: Spot Put Delta Ask Side Exposure
      type: string
    Spot_Put_Delta_Bid_Side_Exposure:
      description: The put delta exposure when Market Makers are buying contracts when a transactions is closer to the bid side.
      example: '-191893077.7193'
      title: Spot Put Delta Bid Side Exposure
      type: string
    Spot_Put_Delta_Exposure:
      description: The sum of the spot delta exposure values of all put transactions at a given strike.
      example: '-191893077.7193'
      title: Spot Put Delta Exposure
      type: string
    Spot_Put_Gamma_Ask_Side_Exposure:
      description: The put gamma exposure when Market Makers are selling contracts when a transactions is closer to the ask side.
      example: '-102382359.5786'
      title: Spot Put Gamma Ask Side Exposure
      type: string
    Spot_Put_Gamma_Bid_Side_Exposure:
      description: The put gamma exposure when Market Makers are buying contracts when a transactions is closer to the bid side.
      example: '102382359.5786'
      title: Spot Put Gamma Bid Side Exposure
      type: string
    Spot_Put_Gamma_Exposure:
      description: The sum of the spot gamma exposure values of all put transactions at a given strike.
      example: '9356683.4241'
      title: Spot Put Gamma Exposure
      type: string
    Spot_Put_Vanna_Ask_Side_Exposure:
      description: The put vanna exposure when Market Makers are selling contracts when a transactions is closer to the ask side.
      example: '102382359.5786'
      title: Spot Put Vanna Ask Side Exposure
      type: string
    Spot_Put_Vanna_Exposure:
      description: The sum of the spot vanna exposure values of all put transactions at a given strike.
      example: '152099632406.9564'
      title: Spot Put Vanna Exposure
      type: string
