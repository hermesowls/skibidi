  /api/market/fda-calendar:
    get:
      callbacks: {}
      description: |
        Returns FDA calendar data with filtering options.

        The FDA calendar contains information about:
        - PDUFA (Prescription Drug User Fee Act) dates
        - Advisory Committee Meetings
        - FDA Decisions
        - Clinical Trial Results
        - New Drug Applications
        - Biologics License Applications

        ## Date Format Support
        The target_date parameters support various FDA-specific date formats:
        - Quarters: YYYY-Q[1-4] (e.g. 2024-Q1)
        - Half years: YYYY-H[1-2] (e.g. 2024-H1)
        - Mid-year: YYYY-MID (e.g. 2024-MID)
        - Late-year: YYYY-LATE (e.g. 2024-LATE)
        - Standard dates: YYYY-MM-DD
      operationId: PublicApi.MarketController.fda_calendar
      parameters:
        - description: Minimum announced date (YYYY-MM-DD)
          in: query
          name: announced_date_min
          required: false
          schema:
            $ref: '#/components/schemas/Optional_Market_Date'
        - description: Maximum announced date (YYYY-MM-DD)
          in: query
          name: announced_date_max
          required: false
          schema:
            $ref: '#/components/schemas/Optional_Market_Date'
        - description: Minimum target date (supports Q1-Q4, H1-H2, MID, LATE formats)
          in: query
          name: target_date_min
          required: false
          schema:
            $ref: '#/components/schemas/FDA_Target_Date'
        - description: Maximum target date (supports Q1-Q4, H1-H2, MID, LATE formats)
          in: query
          name: target_date_max
          required: false
          schema:
            $ref: '#/components/schemas/FDA_Target_Date'
        - description: Filter by drug name (partial match)
          in: query
          name: drug
          required: false
          schema:
            $ref: '#/components/schemas/Drug_Name'
        - description: Filter by ticker symbol
          in: query
          name: ticker
          required: false
          schema:
            $ref: '#/components/schemas/Ticker'
        - description: Maximum number of results to return
          in: query
          name: limit
          required: false
          schema:
            $ref: '#/components/schemas/Default_100_Max_200_Min_1'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/FDA_Calendar'
          description: FDA Calendar response
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Authentication_Error'
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forbidden_Error'
          description: Forbidden
        '500':
          content:
            text/plain:
              schema:
