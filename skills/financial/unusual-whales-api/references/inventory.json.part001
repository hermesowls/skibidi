    {
      "key": "GET /api/analytics/sliding",
      "method": "GET",
      "path": "/api/analytics/sliding",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "**Requires Advanced+ tier (Advanced, Enterprise, or Enterprise + Kafka).** Sliding window statistical analytics across one or more tickers.",
        "operationId": "PublicApi.IntelController.analytics_sliding",
        "parameters": [
          {
            "description": "",
            "in": "query",
            "name": "symbols",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "range",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "range_end",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "interval",
            "required": false,
            "schema": {
              "default": "DAILY",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "ohlc",
            "required": false,
            "schema": {
              "default": "close",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "window_size",
            "required": false,
            "schema": {
