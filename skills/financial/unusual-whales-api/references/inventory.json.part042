    {
      "key": "GET /api/stock/{ticker}/greeks",
      "method": "GET",
      "path": "/api/stock/{ticker}/greeks",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the greeks for each strike for a single expiry date.\n\n`expiry` is required. Without it, the endpoint returns an empty array rather than an error.\n\nOpen interest is not included. For open interest and the full contract set, use\n`/api/stock/{ticker}/option-contracts`. That endpoint also returns per-contract delta, gamma, theta,\nvega and rho. Charm and vanna remain available here. Join `call_option_symbol` or `put_option_symbol`\nto the option contracts response's `option_symbol`.\n",
        "operationId": "PublicApi.TickerController.greeks",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "expiry",
            "required": true,
            "schema": {
              "description": "A single expiry date in ISO date format.",
              "example": "2024-02-02",
              "title": "Single expiry date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "The greek values for a set of call and put contracts at the same strike and expiry for a ticker.\n",
                  "example": {
                    "data": [
                      {
                        "call_charm": "9.32",
                        "call_delta": "0.5",
                        "call_gamma": "0.0051",
                        "call_option_symbol": "SPY240105C00480000",
                        "call_rho": "0.0321",
                        "call_theta": "-0.62",
                        "call_vanna": "-0.91",
                        "call_vega": "0.15",
                        "call_volatility": "0.3",
                        "date": "2024-01-01",
                        "expiry": "2024-01-05",
                        "put_charm": "9.32",
                        "put_delta": "-0.51",
                        "put_gamma": "0.005",
                        "put_option_symbol": "SPY240105P00480000",
                        "put_rho": "-0.022",
                        "put_theta": "-0.62",
                        "put_vanna": "-0.91",
                        "put_vega": "0.15",
                        "put_volatility": "0.29",
                        "strike": "480.0"
                      },
                      {
                        "call_charm": "9.32",
                        "call_delta": "0.45",
                        "call_gamma": "0.003",
                        "call_option_symbol": "SPY240105C00490000",
                        "call_rho": "0.0321",
                        "call_theta": "-0.62",
                        "call_vanna": "-0.91",
                        "call_vega": "0.15",
                        "call_volatility": "0.33",
                        "date": "2024-01-01",
                        "expiry": "2024-01-05",
                        "put_charm": "9.32",
                        "put_delta": "-0.55",
                        "put_gamma": "0.007",
                        "put_option_symbol": "SPY240105P00490000",
                        "put_rho": "-0.022",
                        "put_theta": "-0.62",
                        "put_vanna": "-0.91",
                        "put_vega": "0.15",
                        "put_volatility": "0.32",
                        "strike": "490.0"
                      }
                    ]
                  },
                  "properties": {
                    "call_charm": {
                      "description": "",
                      "example": "9.2",
                      "title": "Charm",
                      "type": "string"
                    },
                    "call_delta": {
                      "description": "The delta of the option trade.",
                      "example": "0.610546281537814",
                      "title": "Delta",
                      "type": "string"
                    },
                    "call_gamma": {
                      "description": "The gamma of the option trade.",
                      "example": "0.00775013889662635",
                      "title": "Gamma",
                      "type": "string"
                    },
                    "call_option_symbol": {
                      "description": "The option symbol of the contract.\n\nYou can use the following regex to extract underlying ticker, option type, expiry & strike:\n`^(?<symbol>[\\w]*)(?<expiry>(\\d{2})(\\d{2})(\\d{2}))(?<type>[PC])(?<strike>\\d{8})$`\n\nKeep in mind that the strike needs to be multiplied by 1,000.\n",
                      "title": "Option Contract Symbol",
                      "type": "string"
                    },
                    "call_rho": {
                      "description": "The rho of the option trade.",
                      "example": "0.2316546330093438",
                      "title": "Rho",
                      "type": "string"
                    },
                    "call_theta": {
                      "description": "The theta of the option trade.",
                      "example": "-0.0640155364004474",
                      "title": "Theta",
                      "type": "string"
                    },
                    "call_vanna": {
                      "description": "",
                      "example": "-0.9",
                      "title": "Vanna",
                      "type": "string"
                    },
                    "call_vega": {
                      "description": "The vega of the option trade.",
                      "example": "0.3140468475903719",
                      "title": "Vega",
                      "type": "string"
                    },
                    "call_volatility": {
                      "description": "The implied volatility of the option trade.",
                      "example": "0.604347250962543",
                      "title": "Implied Volatility",
                      "type": "string"
                    },
                    "date": {
                      "description": "An ISO date.",
                      "example": "2024-01-09",
                      "title": "General ISO Date",
                      "type": "string"
                    },
                    "expiry": {
                      "description": "An ISO date.",
                      "example": "2024-01-09",
                      "title": "General ISO Date",
                      "type": "string"
                    },
                    "put_charm": {
                      "description": "",
                      "example": "9.2",
                      "title": "Charm",
                      "type": "string"
                    },
                    "put_delta": {
                      "description": "The delta of the option trade.",
                      "example": "0.610546281537814",
                      "title": "Delta",
                      "type": "string"
                    },
                    "put_gamma": {
                      "description": "The gamma of the option trade.",
                      "example": "0.00775013889662635",
                      "title": "Gamma",
                      "type": "string"
                    },
                    "put_option_symbol": {
                      "description": "The option symbol of the contract.\n\nYou can use the following regex to extract underlying ticker, option type, expiry & strike:\n`^(?<symbol>[\\w]*)(?<expiry>(\\d{2})(\\d{2})(\\d{2}))(?<type>[PC])(?<strike>\\d{8})$`\n\nKeep in mind that the strike needs to be multiplied by 1,000.\n",
                      "title": "Option Contract Symbol",
                      "type": "string"
                    },
                    "put_rho": {
                      "description": "The rho of the option trade.",
                      "example": "0.2316546330093438",
                      "title": "Rho",
                      "type": "string"
                    },
                    "put_theta": {
                      "description": "The theta of the option trade.",
                      "example": "-0.0640155364004474",
                      "title": "Theta",
                      "type": "string"
                    },
                    "put_vanna": {
                      "description": "",
                      "example": "-0.9",
                      "title": "Vanna",
                      "type": "string"
                    },
                    "put_vega": {
                      "description": "The vega of the option trade.",
                      "example": "0.3140468475903719",
                      "title": "Vega",
