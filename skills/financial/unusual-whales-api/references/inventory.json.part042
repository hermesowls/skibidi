    {
      "key": "GET /api/stock/{ticker}/greek-flow/{expiry}",
      "method": "GET",
      "path": "/api/stock/{ticker}/greek-flow/{expiry}",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns the tickers greek flow (delta & vega flow) for the given market day broken down per minute & expiry.\nDate must be the current or a past date. If no date is given, returns data for the current/last market day.\n",
        "operationId": "PublicApi.TickerController.greek_flow_expiry",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "description": "A single ticker",
              "example": "AAPL",
              "title": "SingleTicker",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "description": "A trading date in the format of YYYY-MM-DD.\nThis is optional and by default the last trading date.\n",
              "example": "2024-01-18",
              "title": "Optional Market Date",
              "type": "string"
            }
          },
          {
            "description": "",
            "in": "path",
            "name": "expiry",
            "required": true,
            "schema": {
              "description": "A single expiry date in ISO date format.",
              "example": "2024-02-02",
              "title": "Single expiry date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Greek flow by ticker, minute timestamps, and expiry date.",
                  "example": {
                    "data": [
                      {
                        "dir_delta_flow": "-43593.96",
                        "dir_vega_flow": "31243.04",
                        "expiry": "2024-10-28",
                        "otm_dir_delta_flow": "14947.51",
                        "otm_dir_vega_flow": "11421.03",
                        "otm_total_delta_flow": "-28564.02",
                        "otm_total_vega_flow": "101745.64",
                        "ticker": "SPY",
                        "timestamp": "2024-10-28 18:46:00+00:00",
                        "total_delta_flow": "-21257.36",
                        "total_vega_flow": "350944.58",
                        "transactions": 1188,
                        "volume": 12348
                      }
                    ]
                  },
                  "properties": {
                    "dir_delta_flow": {
                      "description": "The directional delta flow.",
                      "example": "-43593.96",
                      "title": "Dir Delta Flow",
                      "type": "string"
                    },
                    "dir_vega_flow": {
                      "description": "The directional vega flow.",
                      "example": "31243.04",
                      "title": "Dir Vega Flow",
                      "type": "string"
                    },
                    "expiry": {
                      "description": "The contract expiry date in ISO format.",
                      "example": "2023-12-22",
                      "title": "Option Contract Expiry",
                      "type": "string"
                    },
                    "otm_dir_delta_flow": {
                      "description": "The directional delta flow of out-of-the-money options.",
                      "example": "14947.51",
                      "title": "OTM Dir Delta Flow",
                      "type": "string"
                    },
                    "otm_dir_vega_flow": {
                      "description": "The directional vega flow of out-of-the-money options.",
                      "example": "11421.03",
                      "title": "OTM Dir Vega Flow",
                      "type": "string"
                    },
                    "otm_total_delta_flow": {
                      "description": "The total delta flow of out-of-the-money options.",
                      "example": "-28564.02",
                      "title": "OTM Total Delta Flow",
                      "type": "string"
                    },
                    "otm_total_vega_flow": {
                      "description": "The total vega flow of out-of-the-money options.",
                      "example": "101745.64",
                      "title": "OTM Total Vega Flow",
                      "type": "string"
                    },
                    "ticker": {
                      "description": "The stock ticker.",
                      "example": "AAPL",
                      "title": "Stock Ticker",
                      "type": "string"
                    },
                    "timestamp": {
                      "description": "The (start of minute) timestamp of the data.",
                      "example": "2024-10-28 18:46:00+00:00",
                      "format": "date-time",
                      "title": "Timestamp",
                      "type": "string"
                    },
                    "total_delta_flow": {
                      "description": "The total delta flow.",
                      "example": "-21257.36",
                      "title": "Total Delta Flow",
                      "type": "string"
                    },
                    "total_vega_flow": {
                      "description": "The total vega flow.",
                      "example": "350944.58",
                      "title": "Total Vega Flow",
                      "type": "string"
                    },
                    "transactions": {
                      "description": "The amount of transactions.",
                      "example": 1188,
                      "title": "Transactions",
                      "type": "integer"
                    },
                    "volume": {
                      "description": "The total options volume.",
                      "example": 12348,
                      "title": "Volume",
                      "type": "integer"
                    }
                  },
                  "title": "Greek Flow Expiry",
                  "type": "object"
                }
              }
            },
            "description": ""
          },
