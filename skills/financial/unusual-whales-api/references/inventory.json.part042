      "key": "GET /api/stock/{ticker}/income-statements",
      "method": "GET",
      "path": "/api/stock/{ticker}/income-statements",
      "transport": "http-rest",
      "operation": {
        "callbacks": {},
        "description": "Returns income statement data including revenue, gross profit, operating income,\nEBIT, EBITDA, net income, R&D, SG&A, depreciation, interest, and tax expenses.\n",
        "operationId": "PublicApi.AvFundamentalController.income_statements",
        "parameters": [
          {
            "description": "",
            "in": "path",
            "name": "ticker",
